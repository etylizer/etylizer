#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote_pb_codec (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged. The study is the hand-written
%% antidote_pb_codec.erl: 71 functions, 12 of them with a spec in the source. antidote_pb.erl and
%% the headers are generated by gpb and only there because the records refer to their types. A
%% function without a spec is checked against dynamic().
%%
%% Type check raw (step I): no overlay, no flag, no assertion. 67 functions type check, 4 do not
%% and are ignored: 1 for a type in the source that is too imprecise, 3 for what types do not show
%% (the first byte of a binary, the fields of a decoded message).

{study, antidote_pb_codec}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a match inside the body"}.
{reason, gpb_types,           inherent, "the generated record types are wider than a decoded message: [T] | undefined, boolean() | 0 | 1, an enum | integer()"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.

{module, antidote_pb_codec, #{file => "antidote_pb_codec/src/antidote_pb_codec.erl", timeout => 10000}}.

%% <<MsgCode:8, MsgData/binary>> = Data at 117 and 122: a binary() can be empty
{exception, antidote_pb_codec, decode_request, 1, [ignore], body_exhaustiveness}.
{exception, antidote_pb_codec, decode_response, 1, [ignore], body_exhaustiveness}.

%% 241: message() :: term(), the clauses take only the requests and the responses
{exception, antidote_pb_codec, encode_message, 1, [ignore], spec_imprecise}.
%% 285: the clauses with success = false and success = true (309-326) leave 0 and 1 of boolean() | 0 | 1
{exception, antidote_pb_codec, decode_message, 1, [ignore], gpb_types}.
