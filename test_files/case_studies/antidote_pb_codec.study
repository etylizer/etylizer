#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote_pb_codec (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged. The study is the hand-written
%% antidote_pb_codec.erl: 71 functions, 12 of them with a spec in the source. antidote_pb.erl and
%% the headers are generated by gpb and only there because the records refer to their types.
%%
%% Type check raw (step I): no overlay, a function without a spec is checked against dynamic(). 67
%% functions type check, 4 do not.
%%
%% Missing specs (step II): overlay_antidote_pb_codec.erl gives a spec to each of the 59 functions
%% that have none in the source. Encoding takes the types of the module (request(), response(),
%% update(), error_code(), ...), decoding gives what the generated records declare. No flag, no
%% assertion, no library overlay. 49 functions type check, 22 do not and are ignored: the 4 of
%% step I, each with the first error it had there, 16 that were dynamic(), and 2 that have a spec
%% in the source and call a function that has one now (encode_response/1, encode_msg/1).
%% By class: 3 for a type in the source that is wrong or too imprecise, 17 for what types do not
%% show (7 the record types of gpb, wider than a decoded message; 5 a partial function; 2 a match
%% in the body; 2 a value whose type depends on the tag next to it; 1 a property list), 2 for the
%% checker (element/2, a pattern that is a bound variable).

{study, antidote_pb_codec}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a match inside the body"}.
{reason, partial,             inherent, "partial function, the callers rule out the missing case"}.
{reason, gpb_types,           inherent, "the generated record types are wider than a decoded message: [T] | undefined, boolean() | 0 | 1, an enum | integer()"}.
{reason, proplist,            inherent, "value from a property list, used at the type of the property"}.
{reason, dependent,           inherent, "the type of a value depends on the tag or CRDT type given next to it"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, spec_wrong,          real,     "wrong type in the source"}.
{reason, element_type,        fixable,  "element/2 is not typed by the tuple it is applied to"}.
{reason, bound_pattern,       fixable,  "the last pattern of a case is its scrutinee variable, which always matches"}.

{module, antidote_pb_codec, #{file => "antidote_pb_codec/src/antidote_pb_codec.erl",
                              overlays => [{specs, "overlay_antidote_pb_codec.erl"}], timeout => 10000}}.

%% <<MsgCode:8, MsgData/binary>> = Data at 117 and 122: a binary() can be empty
{exception, antidote_pb_codec, decode_request, 1, [ignore], body_exhaustiveness}.
{exception, antidote_pb_codec, decode_response, 1, [ignore], body_exhaustiveness}.

%% 133: response() has {static_read_objects_response, {ok, Results, CommitTime}}, the branch takes {Results, CommitTime}
{exception, antidote_pb_codec, encode_response, 1, [ignore], spec_wrong}.

{exception, antidote_pb_codec, message_type_to_code, 1, [ignore], partial}. % 158: only the names of messages
{exception, antidote_pb_codec, message_code_to_type, 1, [ignore], partial}. % 190: only the codes of messages
{exception, antidote_pb_codec, encode_msg, 1, [ignore], element_type}. % 233: message_type_to_code(MsgType), MsgType = element(1, Msg)

%% 241: message() :: term(), the clauses take only the requests and the responses
{exception, antidote_pb_codec, encode_message, 1, [ignore], spec_imprecise}.
%% 285: the clauses with success = false and success = true (309-326) leave 0 and 1 of boolean() | 0 | 1
{exception, antidote_pb_codec, decode_message, 1, [ignore], gpb_types}.

{exception, antidote_pb_codec, encode_error_code, 1, [ignore], spec_imprecise}. % 387: {error_code, integer()}, the wire wants it non-negative

{exception, antidote_pb_codec, encode_txn_properties, 1, [ignore], proplist}. % 415, 416: proplists:get_value/3 gives term()
{exception, antidote_pb_codec, decode_txn_properties, 1, [ignore], gpb_types}. % 424, 425: all_to_binary/1 of [iodata()] | undefined

%% 466: {Op, OpParam} = decode_update_operation(Operation), which has [] from decode_set_update/1 for adds = undefined
{exception, antidote_pb_codec, decode_update_op, 1, [ignore], gpb_types}.

%% 620-640: the operation goes with the CRDT type of the clause, encode_counter_update(Op_Param) and the like
{exception, antidote_pb_codec, encode_update_operation, 2, [ignore], dependent}.
%% 644: one of the operations is always set; each clause has "when Op /= undefined"
{exception, antidote_pb_codec, decode_update_operation, 1, [ignore], partial}.

{exception, antidote_pb_codec, encode_crdt_type, 1, [ignore], partial}. % 657: only the CRDT types, and not antidote_crdt_counter_b

%% 679-689: the value goes with the tag of the clause
{exception, antidote_pb_codec, encode_read_object_resp, 2, [ignore], dependent}.
{exception, antidote_pb_codec, decode_read_object_resp, 1, [ignore], partial}. % 691: one of the values is always set

{exception, antidote_pb_codec, decode_set_update, 1, [ignore], gpb_types}. % 721: case OpType of 'ADD'; 'REMOVE', the enum has | integer()
{exception, antidote_pb_codec, decode_counter_update, 1, [ignore], bound_pattern}. % 745: case I of undefined -> ..; I -> .. end
{exception, antidote_pb_codec, decode_flag_update, 1, [ignore], gpb_types}. % 768: value :: boolean() | 0 | 1

{exception, antidote_pb_codec, decode_map_update, 1, [ignore], gpb_types}. % 791: U <- Updates, [T] | undefined
{exception, antidote_pb_codec, decode_map_get_resp, 1, [ignore], gpb_types}. % 826: E <- Entries, [T] | undefined
