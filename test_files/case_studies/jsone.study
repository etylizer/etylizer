#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.

{study, jsone}.
%% jsone/src is src/*.erl of https://github.com/sile/jsone at a1c481f (2024-11-28), unchanged.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), benign (dead for the spec, kept on purpose), unknown.
{reason, arithmetic,          inherent, "arithmetic on type level"}.
{reason, arith_range,         fixable,  "the range of an arithmetic result follows from the clauses before and the operand types, the type of - is too coarse"}.
{reason, format_chars,        fixable,  "io_lib:format/2 gives chars(), without the modifier t the output is bytes"}.
{reason, documented_exception, inherent, "raises an exception that the documentation promises, a spec cannot say so"}.
{reason, tuple_any,           fixable,  "needs a type for tuples of any size, {T, ...}"}.
{reason, binary_value,        fixable,  "the guards determine the content of a binary: <<High:16, Low:16>> is valid UTF-16 for High in D800..DBFF and Low in DC00..DFFF"}.
{reason, defensive,           benign,   "defensive clause, dead for the spec"}.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a case or match inside the body"}.
{reason, negative_literal,    fixable,  "a negative literal is typed as integer()"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, spec_wrong,          real,     "wrong type in the source"}.
{reason, source_bug,          real,     "error in the program"}.
{reason, unknown,             unknown,  "not analysed"}.

%% Library specs that overlays correct, in overlay_jsone_lib.erl
{correction, erlang, max, 2, spec_imprecise}. % Maximum :: term(): the result is a free type variable

{module, jsone, #{file => "jsone/src/jsone.erl", timeout => 30000}}.
{exception, jsone, decode, 2, [ignore], documented_exception}.
{exception, jsone, encode, 2, [ignore], documented_exception}.
{exception, jsone, term_to_json_string, 1, [ignore], format_chars}.

{module, jsone_inet, #{file => "jsone/src/jsone_inet.erl", overlays => [{library, "overlay_jsone_lib.erl"}], timeout => 30000}}.
{exception, jsone_inet, ip_address_to_json_string, 1, [ignore], unknown}.
{exception, jsone_inet, format_ipv6, 1, [ignore], source_bug}. % string:lowercase
{exception, jsone_inet, to_hex, 1, [ignore], unknown}.

{module, jsone_encode, #{file => "jsone/src/jsone_encode.erl", overlays => [{library, "overlay_jsone_lib.erl"}], timeout => 30000}}.
{correction, erlang, integer_to_list, 1, spec_imprecise}. % -> string(), the digits and the sign are bytes
% OTP 28: datetime/4 needs no_redundancy, calendar:year() is non_neg_integer() there
{exception, jsone_encode, value, 4, [ignore], source_bug}. % json_object_format_map() is map(), [{}] is a list of {}
{exception, jsone_encode, parse_option, 2, [ignore], defensive}. % inside the body
{exception, jsone_encode, encode, 2, [ignore], source_bug}.
{exception, jsone_encode, string, 4, [ignore], source_bug}.
{assertion, jsone_encode, {269, 5, "b0504b"}, assert_type, "iolist()", spec_imprecise}. % io_lib:format/2 gives chars(), for "~6.3.0f" they are bytes
{exception, jsone_encode, object_key, 4, [ignore], spec_wrong}. % next() says {char, binary()}, the code uses a byte
{exception, jsone_encode, escape_string, 4, [ignore], body_exhaustiveness}. % <<Unescaped:Len/binary, Rest/binary>> = Str
{exception, jsone_encode, unescaped_string_length, 3, [ignore], tuple_any}.
{exception, jsone_encode, hex, 1, [ignore], unknown}.
{exception, jsone_encode, local_offset, 0, [ignore], arithmetic}.
{exception, jsone_encode, local_offset_dst, 0, [ignore], arithmetic}.
{exception, jsone_encode, format_year, 1, [ignore], arith_range}. % 4 - byte_size(B) after the clause for Y > 999
{exception, jsone_encode, padding, 2, [ignore], arith_range}. % N - 9 after the clauses for 0..8
{exception, jsone_encode, format_tz_, 1, [ignore], unknown}.
{exception, jsone_encode, object_members, 4, [no_redundancy], defensive}.
{exception, jsone_encode, next, 3, [ignore], spec_wrong}. % next() says {char, binary()}, the code uses a byte

{module, jsone_decode, #{file => "jsone/src/jsone_decode.erl", overlays => [{missing, "overlay_jsone.erl"}], timeout => 30000}}.
{exception, jsone_decode, unicode_string, 5, [ignore], binary_value}. % <<Unicode/utf16>> = <<High:16, Low:16>>
{exception, jsone_decode, parse_option, 2, [no_redundancy], defensive}.
{exception, jsone_decode, object_key, 2, [ignore], source_bug}.
{exception, jsone_decode, number_exponation_part, 6, [ignore], negative_literal}.
{exception, jsone_decode, next, 5, [ignore], source_bug}.
{exception, jsone_decode, number, 4, [ignore], negative_literal}.
{exception, jsone_decode, number_integer_part, 5, [ignore], arith_range}. % C - $0 for C in $1..$9
{exception, jsone_decode, number_integer_part_rest, 6, [ignore], arith_range}. % N * 10 + C - $0 for C in $0..$9
{exception, jsone_decode, number_fraction_part_rest, 7, [ignore], arith_range}. % the same
{exception, jsone_decode, number_exponation_part, 9, [ignore], arith_range}. % the same
