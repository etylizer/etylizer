#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote_crdt (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged: 15 modules with 168 functions, 99 of them
%% with a spec in the source. A function without a spec is checked against dynamic().
%%
%% Type check raw (step I): no overlay, no flag, no assertion. 146 functions type check, 22 do not
%% and are ignored: 9 for a type in the source that is wrong or too imprecise, 11 for what types
%% do not show (a match or an if in the body, a partial function, binary_to_term/1), 2 for the spec
%% of a library function.

{study, antidote_crdt}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a match or an if inside the body"}.
{reason, partial,             inherent, "partial function, the callers rule out the missing case"}.
{reason, deserialize,         inherent, "binary_to_term/1 gives term(), the spec promises the type of the state"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, spec_wrong,          real,     "wrong type in the source"}.
{reason, library_spec,        fixable,  "spec of a library function too imprecise"}.
{reason, free_result,         fixable,  "library spec whose result is a type variable bound only in when (application:get_env/3): a branch on such a value is dead"}.

{module, antidote_crdt, #{file => "antidote_crdt/src/antidote_crdt.erl", timeout => 10000}}.
%% typ() lacks the antidote_crdt_secure_* types that is_type/1 (113-119) and alias/1 (124-130) have clauses for
{exception, antidote_crdt, is_type, 1, [ignore], spec_wrong}.
{exception, antidote_crdt, alias, 1, [ignore], spec_wrong}.
%% true = is_type(T) at 137, 144, 155, 167, 175 and 182
{exception, antidote_crdt, new, 1, [ignore], body_exhaustiveness}.
{exception, antidote_crdt, value, 2, [ignore], body_exhaustiveness}.
{exception, antidote_crdt, downstream, 3, [ignore], body_exhaustiveness}.
{exception, antidote_crdt, update, 3, [ignore], body_exhaustiveness}.
{exception, antidote_crdt, require_state_downstream, 2, [ignore], body_exhaustiveness}.
{exception, antidote_crdt, is_operation, 2, [ignore], body_exhaustiveness}.
%% case application:get_env(antidote_crdt, binary_compression, 1) of true -> ..; N when N >= 0, N =< 9 -> ..; _ -> .. end:
%% the second branch (190) is reported as dead
{exception, antidote_crdt, to_binary, 1, [ignore], free_result}.

{module, antidote_crdt_counter_b, #{file => "antidote_crdt/src/antidote_crdt_counter_b.erl", timeout => 10000}}.
{exception, antidote_crdt_counter_b, generate_downstream_check, 4, [ignore], body_exhaustiveness}. % 174: if A >= V; A < V
{exception, antidote_crdt_counter_b, from_binary, 1, [ignore], deserialize}. % 214: {ok, binary_to_term(B)}

{module, antidote_crdt_counter_fat, #{file => "antidote_crdt/src/antidote_crdt_counter_fat.erl", timeout => 10000}}.
{exception, antidote_crdt_counter_fat, value, 1, [ignore], library_spec}. % 79: lists:sum/1 gives number(), the spec integer()
{exception, antidote_crdt_counter_fat, from_binary, 1, [ignore], partial}. % 132: only the tagged binary

{module, antidote_crdt_counter_pn, #{file => "antidote_crdt/src/antidote_crdt_counter_pn.erl", timeout => 10000}}.
%% op() lacks increment | decrement, the clauses at 80 and 82
{exception, antidote_crdt_counter_pn, downstream, 2, [ignore], spec_wrong}.

{module, antidote_crdt_flag_dw, #{file => "antidote_crdt/src/antidote_crdt_flag_dw.erl", timeout => 10000}}.

{module, antidote_crdt_flag_ew, #{file => "antidote_crdt/src/antidote_crdt_flag_ew.erl", timeout => 10000}}.

{module, antidote_crdt_flag_helper, #{file => "antidote_crdt/src/antidote_crdt_flag_helper.erl", timeout => 10000}}.

%% The type of a key says Type :: atom(), the functions of antidote_crdt want a typ(), which it does not export:
%% antidote_crdt:new(Type) at 89, antidote_crdt:update(Type, Op, V) at 112.
{module, antidote_crdt_map_go, #{file => "antidote_crdt/src/antidote_crdt_map_go.erl", timeout => 10000}}.
{exception, antidote_crdt_map_go, downstream, 2, [ignore], spec_imprecise}.
{exception, antidote_crdt_map_go, update, 2, [ignore], spec_imprecise}.

%% Type :: atom() in typedKey(), as in antidote_crdt_map_go: antidote_crdt:value(Type, ..) at 111,
%% antidote_crdt:new(Type) at 141 and 151.
{module, antidote_crdt_map_rr, #{file => "antidote_crdt/src/antidote_crdt_map_rr.erl", timeout => 10000}}.
{exception, antidote_crdt_map_rr, get, 2, [ignore], spec_imprecise}.
{exception, antidote_crdt_map_rr, generate_downstream_update, 2, [ignore], spec_imprecise}.
{exception, antidote_crdt_map_rr, generate_downstream_remove, 2, [ignore], spec_imprecise}.

{module, antidote_crdt_register_lww, #{file => "antidote_crdt/src/antidote_crdt_register_lww.erl", timeout => 10000}}.

{module, antidote_crdt_register_mv, #{file => "antidote_crdt/src/antidote_crdt_register_mv.erl", timeout => 10000}}.
{exception, antidote_crdt_register_mv, downstream, 2, [ignore], spec_wrong}. % the op type lacks {reset, {}}, the clause at 87
{exception, antidote_crdt_register_mv, from_binary, 1, [ignore], partial}. % 124: only the tagged binary

{module, antidote_crdt_secure_counter_pn, #{file => "antidote_crdt/src/antidote_crdt_secure_counter_pn.erl", timeout => 10000}}.
{exception, antidote_crdt_secure_counter_pn, from_binary, 1, [ignore], deserialize}. % 116: {ok, binary_to_term(Bin)}

{module, antidote_crdt_set_aw, #{file => "antidote_crdt/src/antidote_crdt_set_aw.erl", timeout => 10000}}.

{module, antidote_crdt_set_go, #{file => "antidote_crdt/src/antidote_crdt_set_go.erl", timeout => 10000}}.

{module, antidote_crdt_set_rw, #{file => "antidote_crdt/src/antidote_crdt_set_rw.erl", timeout => 10000}}.
