#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote_crdt (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221: 15 modules with 168 functions, 99 of them with a spec
%% in the source. The code is as upstream; 17 declarations (-type, -spec, -callback, -export_type)
%% that were wrong or too imprecise are corrected, see the list below.
%%
%% Type check raw (step I): no overlay, a function without a spec is checked against dynamic(). 146
%% functions type check, 22 do not.
%%
%% Missing specs (step II): overlay_antidote_crdt.erl gives a spec to each of the 69 functions that
%% have none in the source, from the types of the module of the function and the callbacks of the
%% behaviour antidote_crdt. 129 functions type check, 39 do not, 14 of them for a declaration of the
%% source.
%%
%% Declarations (step III): 136 functions type check, 32 do not, none of them for a declaration any
%% more. The corrections make 7 functions type check: is_type/1 and alias/1 of antidote_crdt,
%% downstream/2 of antidote_crdt_counter_pn and of antidote_crdt_register_mv,
%% antidote_crdt_map_go:update/2, antidote_crdt_map_rr:get/2 and is_bottom/2. 7 get past the
%% declaration and fail with another first error, see their exceptions: downstream/2 and
%% is_operation/1 of antidote_crdt_map_go, and generate_downstream_update/2,
%% generate_downstream_remove/2, update_entry/2, remove_entry/2 and is_operation/1 of
%% antidote_crdt_map_rr. No function fails that type checked before. By class: 27 for what types do
%% not show (10 a match or an if in the body, 9 a from_binary/1 that takes only the tagged binary, 5
%% binary_to_term/1, 2 a type tested with is_type/1, 1 a defensive clause), 5 for the checker and
%% the specs of OTP.
%%
%% Library specs, flags and assertions (step IV); the source is that of step III. 157 functions type
%% check as they are, 10 with a flag (9 without the exhaustiveness check of their clauses, 1 without
%% the redundancy check), 1 is ignored; 29 assertions (20 assert_type, 9 assert_pattern) in 25
%% functions of 14 modules. Each flag and each assertion is needed: without it exactly its function
%% fails. No exception has a reason of the class real or unknown.
%%   Library overlays: the shared overlay.erl on antidote_crdt_set_aw for lists:foldl/3, with whose
%%     spec in OTP the fun of apply_downstreams/2 never matches. overlay_antidote_crdt_lib.erl has
%%     two specs: lists:sum/1, an integer() for integers where OTP says number()
%%     (antidote_crdt_counter_fat:value/1), and dict:find/2 with the value as a term(), which the
%%     spec of OTP leaves unbound for the checker (update_entry/2 and remove_entry/2 of
%%     antidote_crdt_map_rr). The overlays alone make these 4 functions type check.
%%   Flags: 9 from_binary/1 take only a binary that starts with the tag and the version of the
%%     module and fail for any other (partial); antidote_crdt_counter_pn:new/1 has a defensive
%%     clause.
%%   An assertion is an unchecked cast (assert_type, assert_pattern): 13 for the state that
%%     binary_to_term/1 gives in a from_binary/1; 9 for a match that the program lets crash (true =
%%     is_type(T) in six functions of antidote_crdt, {ok, _} = antidote_crdt:downstream(..) in the
%%     two maps, where a nested bounded counter can give {error, no_permissions}); 1 for the setting
%%     binary_compression of the application environment; 6 in is_operation/1 of the two maps: the
%%     type that is_type/1 has just accepted, and the lists that is_list/1 has accepted, which
%%     lists:all/2 takes only if they are proper.
%%   Ignored: antidote_crdt_counter_b:generate_downstream_check/4, for an if that is exhaustive by
%%     arithmetic (Available >= V; Available < V). No flag covers an if, and it has no expression
%%     that an assertion could close it with.
%%
%% Declarations corrected in the source: 17 in 5 modules, old -> new. Only -type, -spec, -callback
%% and -export_type; no function body, clause head, guard, macro or comment, and nothing in
%% antidote_crdt.hrl. Line numbers change in antidote_crdt.erl (+9 after typ()),
%% antidote_crdt_counter_pn.erl (+2 after op()) and antidote_crdt_map_go.erl (+3 after the types).
%% In the overlay two specs of antidote_crdt_map_rr follow: is_bottom/2 (Type :: atom() ->
%% antidote_crdt:typ()) and update_entry/2 (nested_downstream() -> {typedKey(), {ok, Effect ::
%% term()}}).
%%
%% The type of a CRDT:
%%   antidote_crdt: typ() gets antidote_crdt_secure_set_go, _set_aw, _set_rw, _register_lww,
%%     _register_mv, _map_go and _map_rr. is_type/1 gives true for the seven and alias/1 maps them
%%     to the module that implements them; for typ() these clauses were dead.
%%   antidote_crdt: -export_type([typ/0]) is new. The two maps name the type now, and so does
%%     antidote.hrl of the application antidote. The checker and the compiler accept a remote type
%%     that is not exported: no verdict changes.
%%   antidote_crdt:is_type/1: (typ()) -> boolean() becomes (term()) -> boolean(). It is the test
%%     whether a term is a type, with a clause is_type(_) -> false; is_operation/1 of the two maps
%%     call it with the type that an operation names, any term.
%%   antidote_crdt_map_go: Type :: atom() -> Type :: antidote_crdt:typ() in antidote_crdt_map_go(),
%%     nested_op(), nested_downstream() and in the result of value/1; antidote_crdt_map_rr: the same
%%     in typedKey(). The type of a key goes to new/1, value/2, downstream/3, update/3 and alias/1
%%     of antidote_crdt, which take a typ().
%%
%% Operations:
%%   antidote_crdt_counter_pn: op() gets increment | decrement, the first two clauses of
%%     downstream/2, which is_operation/1 accepts and the documentation of downstream/2 names.
%%   antidote_crdt_register_mv: antidote_crdt_register_mv_op() gets {reset, {}}, the second clause
%%     of downstream/2, which is_operation/1 accepts.
%%   antidote_crdt:is_operation/2 and the callback is_operation/1: the operation update() -> term().
%%     It is the test whether a term is an operation of the type: each implementation ends in a
%%     clause that gives false (the five that have a spec say term()), and is_operation/1 of the two
%%     maps hand it the nested operation of any term. The test of materializer:check_operations/1 in
%%     the application antidote gives it increment and {{add, elem}, a}, neither an update().
%%   antidote_crdt_map_go, antidote_crdt_map_rr: nested_op(), Op :: term() -> Op ::
%%     antidote_crdt:update(). The nested operation goes to antidote_crdt:downstream/3, which takes
%%     an update().
%%   antidote_crdt_map_rr:generate_downstream_update/2: the argument {typedKey(), Op :: term()} ->
%%     nested_op(), for the same call.
%%
%% Effects and states:
%%   antidote_crdt_map_go: antidote_crdt_map_go_effect(), {update, [nested_downstream()]} ->
%%     {update, [antidote_crdt_map_go_effect()]}. downstream/2 makes the effect of a list of updates
%%     from the effects of the single ones, each an {update, _}, and update/2 hands each element to
%%     update/2 again (apply_ops/2).
%%   antidote_crdt_map_rr: effect(), Adds :: [nested_downstream()] -> [{typedKey(), {ok, Effect ::
%%     term()}}], and the result of generate_downstream_update/2, nested_downstream() ->
%%     {typedKey(), {ok, Effect :: term()}}. Only the effect of a remove can be none
%%     (generate_downstream_remove/2); update_entry/2, which takes the updates, has no clause for
%%     it.
%%   antidote_crdt_map_rr: state(), dict:dict(typedKey(), {NestedState :: term()}) ->
%%     dict:dict(typedKey(), NestedState :: term()). The dict holds the state of a key as it is, not
%%     in a tuple (update_entry/2, remove_obsolete/3). The checker loses the value type of a dict:
%%     no verdict changes.
%%
%% Left as they are:
%%   antidote_crdt.hrl, update() :: {atom(), term()}, the operation that the functions of
%%     antidote_crdt take. antidote_crdt_counter_pn also takes increment and decrement,
%%     antidote_crdt_register_lww also {assign, Value, Time}; they are in the op types of these
%%     modules. The pair is what the application antidote sends (op() of antidote.hrl).
%%   antidote_crdt:is_type/1 could say (typ()) -> true; (term()) -> boolean(): then the six matches
%%     true = is_type(T) of antidote_crdt type check. The checker does not finish is_type/1 with
%%     that spec, not in 300 s (measured, not applied).
%%   antidote_crdt_counter_pn:new/1, (integer()) -> state(): the clause new(_) is defensive.
%%   antidote_crdt_register_lww:downstream/2, result {ok, term()}: it is {ok,
%%     antidote_crdt_register_lww()}, the effect that update/2 takes. Nothing depends on it.
%%   from_binary/1 of antidote_crdt_counter_fat and antidote_crdt_register_mv: | {error, term()} in
%%     the result, as the callback has it; they never give it.

{study, antidote_crdt}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), benign (dead for the spec, kept on purpose), unknown.
{reason, partial,             inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,           benign,   "defensive clause, dead for the spec"}.
{reason, source_bug,          real,     "error in the program"}.
{reason, deserialize,         inherent, "binary_to_term/1 gives term(), the spec promises the type of the state"}.
{reason, app_env,             inherent, "value from the application environment, used at the type of the setting"}.
{reason, validated,           fixable,  "a term that the program has tested with antidote_crdt:is_type/1, used as a typ()"}.
{reason, precise_result,      fixable,  "the clauses of the callee give a narrower result than its spec: is_type/1 is true for every typ()"}.
{reason, complementary_guards, fixable, "the guards A >= B and A < B of two clauses cover all values"}.
{reason, spec_imprecise, real, "imprecise type spec in the source"}.

%% Library specs that overlays correct
{correction, lists, foldl, 3, spec_imprecise}. % unrelated accumulator variables
{correction, lists, sum, 1, spec_imprecise}. % -> number() for a list of integers

{module, antidote_crdt, #{file => "antidote_crdt/src/antidote_crdt.erl",
                          overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
%% true = is_type(T) in new/1, value/2, downstream/3, update/3, require_state_downstream/2, is_operation/2
{assertion, antidote_crdt, {146, 5, "e684ba"}, assert_pattern, "true", precise_result}.
{assertion, antidote_crdt, {153, 5, "e684ba"}, assert_pattern, "true", precise_result}.
{assertion, antidote_crdt, {164, 5, "e684ba"}, assert_pattern, "true", precise_result}.
{assertion, antidote_crdt, {176, 5, "e684ba"}, assert_pattern, "true", precise_result}.
{assertion, antidote_crdt, {184, 5, "e684ba"}, assert_pattern, "true", precise_result}.
{assertion, antidote_crdt, {191, 5, "e684ba"}, assert_pattern, "true", precise_result}.
%% to_binary/1: application:get_env(antidote_crdt, binary_compression, 1). With boolean() | 0..9 a false
%% reaches {compressed, N}, the guard N >= 0, N =< 9 does not rule it out.
{assertion, antidote_crdt, {197, 14, "c0c5c2"}, assert_type, "true | integer()", app_env}.

{module, antidote_crdt_counter_b, #{file => "antidote_crdt/src/antidote_crdt_counter_b.erl",
                                    overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
%% 174: if Available >= V -> ..; Available < V -> .. end. No flag covers an if, and it has no expression to assert
{exception, antidote_crdt_counter_b, generate_downstream_check, 4, [ignore], complementary_guards}.
{assertion, antidote_crdt_counter_b, {214, 35, "1c56e0"}, assert_type, "antidote_crdt_counter_b()", deserialize}.

%% value/1: overlay_antidote_crdt_lib.erl for lists:sum/1, which gives number() in OTP
{module, antidote_crdt_counter_fat, #{file => "antidote_crdt/src/antidote_crdt_counter_fat.erl",
                                      overlays => [{library, "overlay_antidote_crdt_lib.erl"}, {specs, "overlay_antidote_crdt.erl"}],
                                      timeout => 10000}}.
{exception, antidote_crdt_counter_fat, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_counter_fat, {133, 10, "779a2c"}, assert_type, "state()", deserialize}.

{module, antidote_crdt_counter_pn, #{file => "antidote_crdt/src/antidote_crdt_counter_pn.erl",
                                     overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_counter_pn, new, 1, [no_redundancy], defensive}. % new(_) after new(Value) when is_integer(Value)
{assertion, antidote_crdt_counter_pn, {115, 10, "70c69b"}, assert_type, "state()", deserialize}.

{module, antidote_crdt_flag_dw, #{file => "antidote_crdt/src/antidote_crdt_flag_dw.erl",
                                  overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_flag_dw, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_flag_dw, {102, 10, "70c69b"}, assert_type, "flag_dw()", deserialize}.

{module, antidote_crdt_flag_ew, #{file => "antidote_crdt/src/antidote_crdt_flag_ew.erl",
                                  overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_flag_ew, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_flag_ew, {96, 10, "70c69b"}, assert_type, "flag_ew()", deserialize}.

{module, antidote_crdt_flag_helper, #{file => "antidote_crdt/src/antidote_crdt_flag_helper.erl",
                                      overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_flag_helper, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary

{module, antidote_crdt_map_go, #{file => "antidote_crdt/src/antidote_crdt_map_go.erl",
                                 overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
%% downstream/2: {ok, DownstreamOp} = antidote_crdt:downstream(Type, Op, CurrentValue), which can give {error, Reason}
{assertion, antidote_crdt_map_go, {94, 5, "c5d6fd"}, assert_pattern, "{ok, _}", source_bug}. % downstream of a decrement of a nested bounded counter without permissions: {badmatch, {error, no_permissions}} (run)
{exception, antidote_crdt_map_go, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_map_go, {147, 10, "70c69b"}, assert_type, "antidote_crdt_map_go()", deserialize}.
%% is_operation/1: antidote_crdt:is_type(Type) andalso antidote_crdt:is_operation(Type, Op), the second Type
{assertion, antidote_crdt_map_go, {152, 76, "57a03f"}, assert_type, "antidote_crdt:typ()", validated}.
%% is_operation/1: {update, Ops} when is_list(Ops) -> lists:all(fun(Op) -> .. end, Ops)
{assertion, antidote_crdt_map_go, {154, 66, "86bf06"}, assert_type, "[term()]", source_bug}. % is_operation({update, [Op | b]}) with a valid Op: function_clause in lists:all/2 (run)

%% update_entry/2, remove_entry/2: overlay_antidote_crdt_lib.erl for dict:find/2, whose result fits every type
%% with the spec of OTP: the branch {ok, State} of the case on it counted as dead
{module, antidote_crdt_map_rr, #{file => "antidote_crdt/src/antidote_crdt_map_rr.erl",
                                 overlays => [{library, "overlay_antidote_crdt_lib.erl"}, {specs, "overlay_antidote_crdt.erl"}],
                                 timeout => 10000}}.
%% generate_downstream_update/2: {ok, DownstreamEffect} = antidote_crdt:downstream(Type, Op, CurrentState), and
%% generate_downstream_remove/2: {ok, _} = antidote_crdt:downstream(Type, {reset, {}}, CurrentState); it can give
%% {error, Reason}
{assertion, antidote_crdt_map_rr, {143, 5, "929e19"}, assert_pattern, "{ok, _}", source_bug}. % downstream of a decrement of a nested bounded counter without permissions: {badmatch, {error, no_permissions}} (run)
{assertion, antidote_crdt_map_rr, {156, 17, "cccaac"}, assert_pattern, "{ok, _}", source_bug}. % downstream of a decrement of a nested bounded counter without permissions: {badmatch, {error, no_permissions}} (run)
{exception, antidote_crdt_map_rr, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_map_rr, {219, 10, "70c69b"}, assert_type, "state()", deserialize}.
%% is_operation/1: case Operation of .. {update, Ops} when is_list(Ops) -> lists:all(fun(Op) -> .. end, Ops); ..
%% {remove, Keys} when is_list(Keys) -> lists:all(fun(Key) -> .. end, Keys). The subject of the case says it for both
%% lists: Keys at 230:68 cannot carry an assertion, its hash 0a1ccf is a code point, which crashes the engine
{assertion, antidote_crdt_map_rr, {222, 10, "b9e022"}, assert_type, "etylizer:without(term(), {update | remove, etylizer:without(maybe_improper_list(), [term()])})", source_bug}. % is_operation of an improper list after a valid element: function_clause in lists:all/2 (run)
%% is_operation/1: antidote_crdt:is_type(Type) andalso antidote_crdt:is_operation(Type, Op), the second Type
{assertion, antidote_crdt_map_rr, {224, 76, "57a03f"}, assert_type, "antidote_crdt:typ()", validated}.
%% is_operation/1: is_list(Updates) andalso is_list(Removes) andalso lists:all(.., Removes) andalso lists:all(.., Updates).
%% A test on the left of andalso does not narrow either
{assertion, antidote_crdt_map_rr, {234, 72, "a4657e"}, assert_type, "[term()]", source_bug}. % is_operation of an improper list after a valid element: function_clause in lists:all/2 (run)
{assertion, antidote_crdt_map_rr, {235, 70, "1f9ac8"}, assert_type, "[term()]", source_bug}. % is_operation of an improper list after a valid element: function_clause in lists:all/2 (run)

{module, antidote_crdt_register_lww, #{file => "antidote_crdt/src/antidote_crdt_register_lww.erl",
                                       overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{assertion, antidote_crdt_register_lww, {92, 10, "de4f64"}, assert_type, "antidote_crdt_register_lww()", deserialize}.

{module, antidote_crdt_register_mv, #{file => "antidote_crdt/src/antidote_crdt_register_mv.erl",
                                      overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_register_mv, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_register_mv, {125, 10, "779a2c"}, assert_type, "antidote_crdt_register_mv()", deserialize}.

{module, antidote_crdt_secure_counter_pn, #{file => "antidote_crdt/src/antidote_crdt_secure_counter_pn.erl",
                                            overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{assertion, antidote_crdt_secure_counter_pn, {116, 10, "70c69b"}, assert_type, "state()", deserialize}.

%% overlay.erl for lists:foldl/3: with the spec of OTP the fun of apply_downstreams/2 never matches
{module, antidote_crdt_set_aw, #{file => "antidote_crdt/src/antidote_crdt_set_aw.erl",
                                 overlays => [{library, "overlay.erl"}, {specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_set_aw, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_set_aw, {155, 10, "70c69b"}, assert_type, "antidote_crdt_set_aw()", deserialize}.

{module, antidote_crdt_set_go, #{file => "antidote_crdt/src/antidote_crdt_set_go.erl",
                                 overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{assertion, antidote_crdt_set_go, {88, 10, "de4f64"}, assert_type, "antidote_crdt_set_go()", deserialize}.

{module, antidote_crdt_set_rw, #{file => "antidote_crdt/src/antidote_crdt_set_rw.erl",
                                 overlays => [{specs, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, antidote_crdt_set_rw, from_binary, 1, [no_exhaustiveness], partial}. % only the tagged binary
{assertion, antidote_crdt_set_rw, {223, 10, "70c69b"}, assert_type, "antidote_crdt_set_rw()", deserialize}.
