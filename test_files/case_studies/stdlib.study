#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.

{study, stdlib}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, tuple_any,           fixable,  "needs a type for tuples of any size, {T, ...}"}.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a case or match inside the body"}.
{reason, defensive,           inherent, "defensive clause, dead for the spec"}.
{reason, unknown,             unknown,  "not analysed"}.
{reason, unreviewed,          unknown,  "flag taken over from an -etylizer attribute, no reason recorded"}.

{module, proplists, #{file => "stdlib/proplists.erl", overlays => [{missing, "overlay_proplists.erl"}, {library, "overlay.erl"}], timeout => 10000}}.
{exception, proplists, expand, 2, [ignore], tuple_any}.
{exception, proplists, normalize, 2, [ignore], tuple_any}.
{exception, proplists, append_values, 2, [ignore], tuple_any}.
{exception, proplists, to_map, 1, [ignore], tuple_any}.

{module, ordsets, #{file => "stdlib/ordsets.erl", overlays => [{missing, "overlay_ordsets.erl"}], timeout => 10000}}.
{exception, ordsets, is_set, 1, [ignore], unknown}.

{module, orddict, #{file => "stdlib/orddict.erl", overlays => [{missing, "overlay_orddict.erl"}, {library, "overlay.erl"}], timeout => 13000}}.
{exception, orddict, append, 3, [ignore], spec_imprecise}.
{exception, orddict, append_list, 3, [ignore], spec_imprecise}.
{exception, orddict, update_counter, 3, [ignore], spec_imprecise}.
{exception, orddict, merge, 3, [ignore], spec_imprecise}.
{exception, orddict, fetch, 2, [no_exhaustiveness], unreviewed}.
{exception, orddict, update, 3, [no_exhaustiveness], unreviewed}.

{module, queue, #{file => "stdlib/queue.erl", overlays => [{missing, "overlay_queue.erl"}, {library, "overlay_queue_lib.erl"}], timeout => 150000}}.
{exception, queue, get, 2, [no_exhaustiveness], spec_imprecise}. % accepts ([], [])
{exception, queue, get, 1, [ignore, no_redundancy], spec_imprecise}. % get/2 returns term()
{exception, queue, head, 1, [ignore, no_redundancy], spec_imprecise}. % get/2 returns term()
{exception, queue, split_f1_to_r2, 5, [no_exhaustiveness], unreviewed}.
{exception, queue, split_r1_to_f2, 5, [no_exhaustiveness], unreviewed}.
{exception, queue, split, 2, [no_redundancy], unreviewed}.
{exception, queue, is_empty, 1, [no_redundancy], unreviewed}.
{exception, queue, len, 1, [no_redundancy], unreviewed}.
{exception, queue, to_list, 1, [no_redundancy], unreviewed}.
{exception, queue, from_list, 1, [no_redundancy], unreviewed}.
{exception, queue, member, 2, [no_redundancy], unreviewed}.
{exception, queue, in, 2, [no_redundancy], unreviewed}.
{exception, queue, in_r, 2, [no_redundancy], unreviewed}.
{exception, queue, out, 1, [no_redundancy], unreviewed}.
{exception, queue, out_r, 1, [no_redundancy], unreviewed}.
{exception, queue, get_r, 1, [no_redundancy], unreviewed}.
{exception, queue, peek, 1, [no_redundancy], unreviewed}.
{exception, queue, peek_r, 1, [no_redundancy], unreviewed}.
{exception, queue, drop, 1, [no_redundancy], unreviewed}.
{exception, queue, drop_r, 1, [no_redundancy], unreviewed}.
{exception, queue, filter, 2, [no_redundancy], unreviewed}.
{exception, queue, filtermap, 2, [no_redundancy], unreviewed}.
{exception, queue, fold, 3, [no_redundancy], unreviewed}.
{exception, queue, any, 2, [no_redundancy], unreviewed}.
{exception, queue, all, 2, [no_redundancy], unreviewed}.
{exception, queue, delete, 2, [no_redundancy], unreviewed}.
{exception, queue, delete_r, 2, [no_redundancy], unreviewed}.
{exception, queue, delete_with, 2, [no_redundancy], unreviewed}.
{exception, queue, delete_with_r, 2, [no_redundancy], unreviewed}.
{exception, queue, reverse, 1, [no_redundancy], defensive}.
{exception, queue, join, 2, [no_redundancy], defensive}.

{module, sets, #{file => "stdlib/sets.erl", overlays => [{missing, "overlay_sets.erl"}, {library, "overlay.erl"}], timeout => 190000}}.
{exception, sets, rehash, 4, [ignore, no_exhaustiveness], unknown}.
{exception, sets, new, 1, [ignore, no_exhaustiveness], body_exhaustiveness}.
{exception, sets, from_list, 2, [ignore, no_exhaustiveness], body_exhaustiveness}.
{exception, sets, is_element, 2, [ignore], unknown}. % transitive
{exception, sets, add_element, 2, [ignore], unknown}. % transitive
{exception, sets, del_element, 2, [ignore], unknown}. % transitive
{exception, sets, filtermap, 2, [ignore], unknown}. % folding over empty instatiation of new
{exception, sets, update_bucket, 3, [ignore], unknown}. % works only for version 1
{exception, sets, get_bucket, 2, [ignore], unknown}.
{exception, sets, get_slot, 2, [ignore], unknown}. % only works for version 1
{exception, sets, maybe_expand, 1, [ignore], unknown}. % only works for version 1
{exception, sets, maybe_contract, 2, [ignore], unknown}. % only works for version 1
{exception, sets, maybe_contract_segs, 1, [ignore], unknown}. % only works for version 1
{exception, sets, fold_segs, 4, [ignore], tuple_any}.
{exception, sets, fold_seg, 4, [ignore], tuple_any}.
{exception, sets, filter_set, 2, [ignore], tuple_any}.
{exception, sets, filter_seg_list, 4, [ignore], tuple_any}.
{exception, sets, get_bucket_s, 2, [ignore], tuple_any}.
{exception, sets, put_bucket_s, 3, [ignore], tuple_any}.
