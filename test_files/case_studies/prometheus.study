#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% src and include of the hex package prometheus 4.8.1, the one antidote_stats depends on (checksum
%% as in the lock file of antidote_stats at antidote commit ed9cfbcaad53c9b5de15bfcef7befef44b5b4221):
%% the modules, in the subdirectories that src has in the package, and the two headers. The code is
%% unchanged; 22 declarations (-spec, -type, -export_type) that were wrong or too imprecise are
%% corrected, see the list below.
%% Of the 30 modules 29 are in the study, with 471 functions. prometheus_model.erl (233 functions)
%% is generated by gpb and only there because the records of prometheus_model.hrl refer to its
%% types. The only dependency is quantile_estimator, see quantile_estimator.study:
%% prometheus_quantile_summary includes its header and calls it.
%%
%% 67 of the 471 functions have a spec in the source; the six metric modules (243 functions) have
%% none. overlay_prometheus.erl gives a spec to each of the other 404, and every module is checked
%% with it, so that a call into another module of prometheus is checked against the spec of the
%% callee. The specs follow the types of the modules and of the headers, the callbacks of the
%% behaviours and the edoc comments of the package: the functions of the metric modules take the
%% documented arguments (a name, a list of label values, a number), not term(). No flag, no
%% assertion, no library overlay.
%%
%% All 29 modules run: 333 functions type check, 138 do not. With the declarations as the package
%% has them it is 316 and 155 (and 422 and 49 without the overlay, where a function without a spec
%% is dynamic()). The corrections make 17 functions type check: collect_mf/2 of the six collectors;
%% duration_unit_from_string/1, from_native/2 and to_native/2 of prometheus_time; create_mf/4,
%% label_pair/1, metrics_from_tuples/2, summary_metric/1 and summary_metric/4 of
%% prometheus_model_helpers; prometheus_mnesia:table_path/3, prometheus_registry:exists/1 and
%% prometheus_text_format:join/2. Four functions of prometheus_model_helpers get a correct spec and
%% fail with another first error, so with another reason: metric_name/1, metric_from_tuple/2,
%% ensure_list/1 and ensure_binary_or_string/1. No function fails that type checked before.
%% Of the 138, 4 are name errors, 3 are specs that the checker rejects for a map type and 1 is a
%% timeout; there is no internal error any more. The source of each of the 138 was read, no
%% exception has the reason unknown.
%%
%% Declarations corrected in the source: 22 in 11 modules, old -> new. Only -spec, -type and
%% -export_type (the package declares no record outside the generated header); no function body,
%% clause head, guard, macro or comment, and neither of the headers. Where the overlay repeats a
%% type of the source (duration_unit(), help()) or names what a corrected spec takes (the type of a
%% metric family, the table of prometheus_mnesia:table_path/3) it follows.
%%
%% A type that does not exist, or is not exported:
%%   collect_mf/2 of the six collectors (prometheus_mnesia_collector, prometheus_vm_dist_collector,
%%     prometheus_vm_memory_collector, prometheus_vm_msacc_collector,
%%     prometheus_vm_statistics_collector, prometheus_vm_system_info_collector): Callback ::
%%     prometheus_collector:callback() -> prometheus_collector:collect_mf_callback(), the type that
%%     the callback collect_mf/2 of the behaviour has. The checker ended with an internal error for
%%     each of the six.
%%   prometheus_model_helpers: -export_type gets label_value/0, which status_class() of
%%     prometheus_http names. The checker accepts a remote type that is not exported: no verdict
%%     changes.
%%
%% Types that say something else than the code does:
%%   prometheus_metric: duration_unit() gets hours, a unit that prometheus_time has
%%     (?DURATION_UNITS, from_native/2, to_native/2) and documents.
%%   prometheus_metric: help() binary() | nonempty_string() -> binary() | string().
%%     prometheus_metric_spec:validate_metric_help/1 accepts "", and the examples in the
%%     documentation of prometheus_time have {help, ""}. No verdict changes.
%%   prometheus_metric: result of maybe_set_default/4 ok -> any(). The first clause gives what
%%     set_default/2 of the metric module gives, for which the callback says any(): it is a
%%     boolean() (ets:insert_new/2) in five of the six. The call is Module:set_default(..), which
%%     the checker does not see: no verdict changes.
%%   prometheus_model_helpers: metric_name/1, result iolist() -> iodata(), and the elements of a
%%     list char() | .. -> byte() | ... An atom and a binary give a binary; a list comes back with
%%     its atoms replaced, and ?METRIC_NAME puts the result into the iolist that is the name for
%%     create_mf/4 ("Why iolists do not support atoms?", says the documentation).
%%   prometheus_model_helpers: result of ensure_binary_or_string/1 binary() | string() ->
%%     binary() | iolist(). It is written to the fields name and value of #'LabelPair'{} and name
%%     and help of #'MetricFamily'{}, which are iodata(); the last clause gives a deep list
%%     (io_lib:format/2), and prometheus_text_format:escape_label_value/1 takes binary() | iolist()
%%     for a label value.
%%   prometheus_model_helpers: summary() gets {Count, Sum, Quantiles} and {Labels, Count, Sum,
%%     Quantiles} with the quantiles as [{number(), value()}], the tuples of the first two clauses
%%     of summary_metric/1.
%%   prometheus_mnesia: table_disk_size/1 and table_disk_size/2, Table :: file:name_all() ->
%%     file:name(). table_path/3 puts the table into a list with the extension, and in a list a
%%     file name takes no binary.
%%   prometheus_text_format: join/2, List1 :: [T] -> [T, ...]. It is lists:join/2 of OTP without
%%     the clause for [].
%%
%% Types that say too little:
%%   prometheus_registry: exists/1 (atom() | iolist()) -> boolean() | atom() becomes (atom()) ->
%%     boolean(); (iolist()) -> atom(). The clause for an iolist calls exists/1 with an atom and
%%     matches the result with true and false.
%%   prometheus_model_helpers: create_mf/4 and create_mf/5, Type :: atom() -> gauge | counter |
%%     summary | histogram | untyped | boolean, the atoms that ensure_mf_type/1 and
%%     metric_from_tuple/2 have clauses for.
%%   prometheus_model_helpers: result of ensure_mf_type/1 atom() -> prometheus_model:'MetricType'(),
%%     for the field type of #'MetricFamily'{}.
%%   prometheus_model_helpers: summary_metric/4, Quantiles :: list() -> [{number(), value()}], the
%%     pairs that the #'Quantile'{} records are made of.
%%   prometheus_model_helpers: ensure_list/1 (term()) -> list() becomes ([T] | T) -> [T], so that
%%     metrics_from_tuples/2 keeps the type of the metrics. The function does not type check with it
%%     either, see its exception.
%%
%% Left as they are:
%%   prometheus_metric:name() (atom() | binary() | nonempty_string() | iolist()) serves two uses: the
%%     name in the spec of a metric, where validate_metric_name/2 accepts a list only if it is a
%%     string, and the name that the collectors give to create_mf/4, an iolist (?METRIC_NAME). It
%%     is true for both and exact for neither. With name() without iolist() and Name ::
%%     prometheus_metric:name() | iolist() in create_mf/4,5, prometheus_metric_spec:to_string/1 type
%%     checks and nothing else changes (measured, not applied).
%%   prometheus_buckets: exponential/3 and linear/3, (number(), number(), pos_integer()) -> buckets(),
%%     are true: for a positive count the list is not empty. The checker cannot see that (reason
%%     nonempty_list). With the result [number()] the next error is the clause for Count < 1; with
%%     Count :: integer() as well both type check (measured, not applied).
%%   prometheus_metric:value(), the result of the callbacks value/1,2,3, has neither the boolean()
%%     that prometheus_boolean gives nor the {Count, Sum, Quantiles} of prometheus_quantile_summary.
%%     No function is checked against a callback.
%%   prometheus_model.hrl and prometheus_model.erl are generated (reason model_field, and partial for
%%     prometheus_text_format:emit_metric/3).
%%   Where the program is wrong, see the exceptions with the reasons source_bug and missing_fields.

{study, prometheus}.
{deps, ["quantile_estimator"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
%% The reason of an exception is the one of the first error that the checker reports for the function.
{reason, ets_value,            inherent, "what an ets table holds is not in its type: ets:lookup/2 gives [tuple()], for a set it is [] or one row of the shape the module inserts; ets:select_replace/2 for one key gives 0 or 1; ets:lookup_element/3 gives term(); ets:match/2 gives the bindings of a row as a list of terms"}.
{reason, proplist,             inherent, "term() from a property list, used at the type of the property"}.
{reason, info_item,            inherent, "mnesia:system_info/1 and mnesia:table_info/2 give term(): the type depends on the item asked for"}.
{reason, unchecked_result,     inherent, "a result that can be false or undefined, used as the success value: lists:keyfind/3 for a key that the program knows is there, erlang:process_info/2, erlang:statistics(microstate_accounting), prometheus_metric:check_mf_exists/3"}.
{reason, nonempty_list,        inherent, "a list that the program knows is not empty: lists:last/1 of it, or a result typed [T, ...]"}.
{reason, body_exhaustiveness,  inherent, "exhaustiveness of a match or a case inside the body: the program lets it crash for the other values"}.
{reason, partial,              inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,            inherent, "defensive clause, dead for the spec"}.
{reason, improper_list,        inherent, "a guard is_list/1 holds for an improper list too, the program takes the list to be a proper one"}.
{reason, start_ret,            fixable,  "result of starting the supervisor: supervisor:start_link/3 can give ignore, init/1 of the module does not"}.
{reason, validated,            inherent, "a term that the program validates at run time (a regular expression, io_lib:printable_unicode_list/1, lists:any/2), used at the validated type"}.
{reason, mf_data,              inherent, "prometheus_metric:mf_data/1 gives the data of a metric, a term() (prometheus_collector:data()): each metric module knows what it has stored there, the buckets or the configuration"}.
{reason, list_shape,           inherent, "the shape of a list that a list type cannot say: a list of two, a list that starts with two sums, a row as a list of elements of different types"}.
{reason, model_field,          inherent, "a field of a record of prometheus_model.hrl, which gpb generates, read at the type that prometheus_model_helpers writes: the field is optional (T | undefined), a number can also be infinity, '-infinity' or nan, the type of a metric family an integer()"}.
{reason, catch_value,          fixable,  "the value of catch Expr is a term()"}.
{reason, info_arg,             inherent, "erlang:system_info/1 called with an atom() that the program knows is an item; for an unknown item it raises badarg, which the function catches"}.
{reason, alloc_info,           inherent, "the allocator information of erlang:system_info({allocator, A}) is a nested property list of terms"}.
{reason, missing_fields,       real,     "a record is built without fields whose types have no undefined"}.
{reason, source_bug,           real,     "error in the program"}.
{reason, otp_no_spec,          fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, bif_fun,              fixable,  "fun hd/1: a fun that names an auto-imported BIF without its module is a name error"}.
{reason, element_type,         fixable,  "element/2 is not typed by the tuple it is applied to"}.
{reason, library_spec,         fixable,  "spec of a library function too imprecise"}.
{reason, checker_timeout,      fixable,  "the check of the function runs into the timeout"}.
{reason, free_result,          fixable,  "library spec whose type variables are bound only in when (application:get_env/2, ets:select/2, lists:foldl/3): any use of the result passes, a branch on such a value is dead, and so is a clause of the fun for lists:foldl/3 that takes its argument apart"}.
{reason, map_types,            fixable,  "map types with more than one association or with mandatory associations are not supported: a spec that has one is rejected; behind a type alias a pattern on a map of that type does not check"}.
{reason, narrowing,            fixable,  "a type test does not narrow: X =:= all on the left of orelse for the right, a filter X =/= undefined in a comprehension, a case on is_atom(X) for its branches"}.
{reason, record_guard,         fixable,  "a guard is_record(X, r) narrows X to tuple() and counts as true for every tuple, not only for #r{}"}.
{reason, arith_range,          fixable,  "the sum of integers with a range has none: pos_integer() + 1 and 5 + non_neg_integer() are not a pos_integer()"}.
{reason, bit_segment,          fixable,  "an integer segment of a binary pattern is integer(), its size gives no range: <<X:8>> is not a byte()"}.
{reason, bounded_tyvar,        fixable,  "a type variable with a bound in when (Value :: T) counts as T itself: a fun argument over the variable must take all of T"}.

{module, prometheus, #{file => "prometheus/src/prometheus.erl",
                       overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus, start, 2, [ignore], start_ret}. % prometheus_sup:start_link() as the result: it can be ignore

{module, prometheus_buckets, #{file => "prometheus/src/prometheus_buckets.erl",
                               overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% lists:last(Buckets), Buckets is lists:map/2 of RawBuckets, which is not [] here
{exception, prometheus_buckets, new, 1, [ignore], nonempty_list}.
%% a comprehension over lists:seq(0, Count - 1) as buckets(), which is [T, ...]
{exception, prometheus_buckets, exponential, 3, [ignore], nonempty_list}.
%% linear(Start, Step, Count, []) as buckets(): linear/4 gives [] for the count 0, which the first clause rules out
{exception, prometheus_buckets, linear, 3, [ignore], nonempty_list}.

{module, prometheus_collector, #{file => "prometheus/src/prometheus_collector.erl",
                                 overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case application:get_env(prometheus, collectors) of undefined -> ..; {ok, Collectors} -> .. end: the second branch
%% counts as dead, now that catch_default_collectors/1 has a spec
{exception, prometheus_collector, enabled_collectors, 0, [ignore], free_result}.

{module, prometheus_format, #{file => "prometheus/src/prometheus_format.erl",
                              overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.

{module, prometheus_instrumenter, #{file => "prometheus/src/prometheus_instrumenter.erl",
                                    overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case application:get_env(prometheus, instrumenters) of undefined -> ..; {ok, Instrumenters} -> .. end: the second
%% branch counts as dead, now that all_known_instrumenters/0 has a spec
{exception, prometheus_instrumenter, enabled_instrumenters, 0, [ignore], free_result}.

{module, prometheus_metric, #{file => "prometheus/src/prometheus_metric.erl",
                              overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case ets:lookup(Table, {Registry, mf, Name}) of [] -> ..; [{_, {Labels, _}, _, _, _} = MF] -> .. end
{exception, prometheus_metric, check_mf_exists, 4, [ignore], ets_value}.
%% case ets:lookup(Table, {Registry, mf, Name}) of [] -> ..; [MF] -> .. end
{exception, prometheus_metric, check_mf_exists, 3, [ignore], ets_value}.
{exception, prometheus_metric, mf_labels, 1, [ignore], element_type}. % {Labels, _} = element(2, MF)
{exception, prometheus_metric, mf_constant_labels, 1, [ignore], element_type}. % element(3, MF) as labels()
{exception, prometheus_metric, mf_duration_unit, 1, [ignore], element_type}. % element(4, MF) as duration_unit() | undefined

{module, prometheus_metric_spec, #{file => "prometheus/src/prometheus_metric_spec.erl",
                                   overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_metric_spec, registry, 1, [ignore], proplist}. % get_value(registry, Spec, default) as registry()
%% validate_metric_name(RawName, RawName) for a list: it is a name() and a string() if validate_metric_name/2 accepts it
{exception, prometheus_metric_spec, validate_metric_name, 1, [ignore], validated}.
%% lists:map(fun validate_metric_label_name/1, RawLabels) behind the guard is_list(RawLabels)
{exception, prometheus_metric_spec, validate_metric_label_names, 1, [ignore], improper_list}.
%% validate_metric_label_name_content(RawName) for a list: a string(), as io_lib:printable_unicode_list/1 has said true
{exception, prometheus_metric_spec, validate_metric_label_name, 1, [ignore], validated}.
%% true -> RawHelp: a list as help(), a string as io_lib:printable_unicode_list/1 has said true
{exception, prometheus_metric_spec, validate_metric_help, 1, [ignore], validated}.
%% Value, a name() that is a list, as string(): name() has iolist() too, but the name of the spec has passed
%% validate_metric_name/2, which accepts a list only if it is a string
{exception, prometheus_metric_spec, to_string, 1, [ignore], validated}.

{module, prometheus_misc, #{file => "prometheus/src/prometheus_misc.erl",
                            overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% lists:foldl(fun ({_App, Module}, Acc) -> .. end, [], Targets): the clause of the fun counts as dead
{exception, prometheus_misc, all_module_attributes, 1, [ignore], free_result}.
%% case catch Module:module_info(attributes) of ..; V -> V end: V as [{atom(), [term()]}]
{exception, prometheus_misc, module_attributes, 1, [ignore], catch_value}.

{module, prometheus_registry, #{file => "prometheus/src/prometheus_registry.erl",
                                overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% Callback(Registry, Collector) for {_, Collector} <- ets:lookup(?TABLE, Registry)
{exception, prometheus_registry, collect, 2, [ignore], ets_value}.
%% [Collector || {_, Collector} <- ets:lookup(?TABLE, Registry)] as [collector()]
{exception, prometheus_registry, collectors, 1, [ignore], ets_value}.

{module, prometheus_sup, #{file => "prometheus/src/prometheus_sup.erl",
                           overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.

{module, prometheus_time, #{file => "prometheus/src/prometheus_time.erl",
                            overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% true -> SDU: any term as duration_unit(), as lists:any/2 has found it among the units
{exception, prometheus_time, validate_duration_unit, 1, [ignore], validated}.

{module, prometheus_mnesia_collector, #{file => "prometheus/src/collectors/mnesia/prometheus_mnesia_collector.erl",
                                        overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% fun() -> mnesia:system_info(transaction_failures) end (and three more) as a fun that gives metrics
{exception, prometheus_mnesia_collector, metrics, 1, [ignore], info_item}.
%% case [V || {A, _, V} <- application:which_applications(), A == App] of [] -> ..; [_] -> .. end
{exception, prometheus_mnesia_collector, is_started, 1, [ignore], body_exhaustiveness}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_mnesia_collector, metric_enabled, 2, [ignore], narrowing}.
%% lists:foldl(Calculator, 0, mnesia:system_info(tables))
{exception, prometheus_mnesia_collector, get_memory_usage, 0, [ignore], info_item}.
%% mnesia:table_info(Tab, memory) * WordSize
{exception, prometheus_mnesia_collector, get_tablewise_memory_usage, 0, [ignore], info_item}.
%% lists:foldl(Calculator, [], mnesia:system_info(tables))
{exception, prometheus_mnesia_collector, get_tablewise_size, 0, [ignore], info_item}.

{module, prometheus_vm_dist_collector, #{file => "prometheus/src/collectors/vm/prometheus_vm_dist_collector.erl",
                                         overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_vm_dist_collector, metric_enabled, 2, [ignore], narrowing}.
%% case proplists:get_value(address, Info, #net_address{}) of #net_address{..} -> .. end
{exception, prometheus_vm_dist_collector, dist_info, 2, [ignore], proplist}.
%% proplists:get_value(name, I) behind the filter I =/= undefined: I is what erlang:port_info/1 gives, a list or
%% undefined. Step I had the next error, [DistPort] = [P || ..]
{exception, prometheus_vm_dist_collector, dist_info, 5, [ignore], narrowing}.
%% the spec has a map type with two associations
{exception, prometheus_vm_dist_collector, dist_tls_info, 1, [ignore], map_types}.
%% the spec has a map type with two associations
{exception, prometheus_vm_dist_collector, dist_tls_sender_info, 2, [ignore], map_types}.
{exception, prometheus_vm_dist_collector, metric, 3, [ignore], unchecked_result}. % element(2, lists:keyfind(Key, 1, Stats))
%% element(2, process_info(Pid, Key)): erlang:process_info/2 gives undefined for a process that has ended. Reported at
%% the generator of the comprehension
{exception, prometheus_vm_dist_collector, metric_proc, 3, [ignore], unchecked_result}.
%% proc_status(element(2, process_info(DistPid, status)))
{exception, prometheus_vm_dist_collector, metric_proc_status, 2, [ignore], element_type}.
%% erlang:dist_get_stat(ConnId), ConnId = ets:lookup_element(sys_dist, Node, 3)
{exception, prometheus_vm_dist_collector, node_queue_size, 1, [ignore], ets_value}.

{module, prometheus_vm_memory_collector, #{file => "prometheus/src/collectors/vm/prometheus_vm_memory_collector.erl",
                                           overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% get_value(atom, Data) - get_value(atom_used, Data), get_value/2 of proplists
{exception, prometheus_vm_memory_collector, metrics, 0, [ignore], proplist}.
%% get_value(system, Data) - get_value(atom, Data) - ..
{exception, prometheus_vm_memory_collector, memory_other, 1, [ignore], proplist}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_vm_memory_collector, metric_enabled, 2, [ignore], narrowing}.

{module, prometheus_vm_msacc_collector, #{file => "prometheus/src/collectors/vm/prometheus_vm_msacc_collector.erl",
                                          overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% metric(aux, Data, ..): erlang:statistics(microstate_accounting) gives undefined if the accounting is not available
{exception, prometheus_vm_msacc_collector, metrics, 0, [ignore], unchecked_result}.
%% the spec has a map type with three mandatory associations, a thread of erlang:statistics(microstate_accounting)
{exception, prometheus_vm_msacc_collector, metric, 3, [ignore], map_types}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_vm_msacc_collector, metric_enabled, 2, [ignore], narrowing}.

{module, prometheus_vm_statistics_collector, #{file => "prometheus/src/collectors/vm/prometheus_vm_statistics_collector.erl",
                                               overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% [DirtyCPURunQueueLength, DirtyIORunQueueLength] = dirty_stat(): a list of two
{exception, prometheus_vm_statistics_collector, metrics, 0, [ignore], list_shape}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_vm_statistics_collector, metric_enabled, 2, [ignore], narrowing}.

{module, prometheus_vm_system_info_collector, #{file => "prometheus/src/collectors/vm/prometheus_vm_system_info_collector.erl",
                                                overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% erlang:system_info(Name), Name an atom(): the name of a metric of metrics/0
{exception, prometheus_vm_system_info_collector, collect_metrics, 1, [ignore], info_arg}.
%% Metrics =:= all orelse lists:member(Name, Metrics): on the right Metrics is still all | [atom()]
{exception, prometheus_vm_system_info_collector, metric_enabled, 2, [ignore], narrowing}.
%% allocator_metric(Alloc, Instance, Kind, Key, KindInfo) for {Kind, KindInfo} <- Info: KindInfo is a term()
{exception, prometheus_vm_system_info_collector, collect_allocator_metrics, 0, [ignore], alloc_info}.
%% element(2, lists:keyfind(Key, 1, Values)) as non_neg_integer(). Step I had the argument, which can be false, as its
%% first error
{exception, prometheus_vm_system_info_collector, allocator_metric, 5, [ignore], element_type}.
%% a comprehension with four qualifiers and two calls of erlang:system_info/1, whose spec has many clauses. With more
%% time it type checks, in 20 s
{exception, prometheus_vm_system_info_collector, allocators, 0, [ignore], checker_timeout}.
%% sum_alloc_block_list(count, L, 0) behind the guard is_list(L). Step I had the next error, element(2, Tuple) for the
%% result of lists:keyfind/3
{exception, prometheus_vm_system_info_collector, allocator_blocks_metric, 5, [ignore], improper_list}.
%% lists:keyfind(Type, 1, L) for an element {_, L} of the list of blocks: L is a term()
{exception, prometheus_vm_system_info_collector, sum_alloc_block_list, 3, [ignore], alloc_info}.

{module, prometheus_http, #{file => "prometheus/src/contrib/prometheus_http.erl",
                            overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% the last clause, for what is not a positive integer: status_code() is pos_integer()
{exception, prometheus_http, status_class, 1, [ignore], defensive}.

{module, prometheus_mnesia, #{file => "prometheus/src/contrib/prometheus_mnesia.erl",
                              overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_mnesia, table_disk_size, 1, [ignore], info_item}. % table_disk_size(mnesia:system_info(directory), Table)
%% lists:sum/1 gives number(), the sizes are non_neg_integer()
{exception, prometheus_mnesia, table_disk_size, 2, [ignore], library_spec}.
{exception, prometheus_mnesia, tm_info, 0, [ignore], otp_no_spec}. % mnesia_tm:get_info/1

{module, prometheus_test_instrumenter, #{file => "prometheus/src/contrib/prometheus_test_instrumenter.erl",
                                         overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.

{module, prometheus_protobuf_format, #{file => "prometheus/src/formats/prometheus_protobuf_format.erl",
                                       overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_protobuf_format, format, 1, [ignore], otp_no_spec}. % ram_file:open/2, ram_file:get_size/1

{module, prometheus_text_format, #{file => "prometheus/src/formats/prometheus_text_format.erl",
                                   overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_text_format, format, 1, [ignore], otp_no_spec}. % ram_file:open/2, ram_file:get_size/1
%% string_type(Type): the field type of 'MetricFamily' can be an integer() and undefined
{exception, prometheus_text_format, emit_mf_prologue, 2, [ignore], model_field}.
%% emit_metric(Fd, Name, Metric): the field name of 'MetricFamily' is iodata() | undefined
{exception, prometheus_text_format, emit_mf_metrics, 2, [ignore], model_field}.
%% no clause for a 'Metric' whose fields counter, gauge, untyped, summary and histogram are all undefined
{exception, prometheus_text_format, emit_metric, 3, [ignore], partial}.
%% bound_to_label_value(BBound): the field upper_bound of 'Bucket' can be '-infinity', nan and undefined
{exception, prometheus_text_format, emit_histogram_bucket, 4, [ignore], model_field}.
%% [Name, "=\"", ..] in the fun as iolist(): the field name of 'LabelPair' is iodata() | undefined
{exception, prometheus_text_format, labels_stringify, 1, [ignore], model_field}.
%% integer_to_list(Value) in the iodata() for file:write/2: the spec says string(), whose characters need not be bytes
{exception, prometheus_text_format, emit_series, 4, [ignore], library_spec}.
%% Fun(X) for <<X:8>> <= Str: the fun takes a byte()
{exception, prometheus_text_format, escape_string, 2, [ignore], bit_segment}.

{module, prometheus_boolean, #{file => "prometheus/src/metrics/prometheus_boolean.erl",
                               overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case ets:lookup(?TABLE, {Registry, Name, LabelValues}) of [{_Key, 0}] -> ..; [{_Key, 1}] -> ..; .. end
{exception, prometheus_boolean, value, 3, [ignore], ets_value}.
%% [LabelValues, Value] <- load_all_values(Registry, Name), LabelValues for lists:zip/2: the bindings of ets:match/2 are
%% terms
{exception, prometheus_boolean, values, 2, [ignore], ets_value}.
%% create_boolean(Name, Help, {CLabels, Labels, Registry}) for [Name, {Labels, Help}, CLabels, _, _] <-
%% prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_boolean, collect_mf, 2, [ignore], ets_value}.
%% lists:zip(Labels, LabelValues) for [LabelValues, Value] <- load_all_values(Registry, Name): the bindings of
%% ets:match/2 are terms
{exception, prometheus_boolean, collect_metrics, 2, [ignore], ets_value}.
%% case ets:lookup(?TABLE, {Registry, Name, LabelValues}) of [{_Key, undefined}] -> ..; [] -> .. end
{exception, prometheus_boolean, save_toggle, 3, [ignore], ets_value}.

{module, prometheus_counter, #{file => "prometheus/src/metrics/prometheus_counter.erl",
                               overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_counter, inc, 4, [ignore], ets_value}. % case ets:select_replace(?TABLE, ..) of 0 -> ..; 1 -> .. end
%% case ets:select(?TABLE, ..) of [] -> undefined; List -> lists:sum(List) end: the second branch counts as dead
{exception, prometheus_counter, value, 3, [ignore], free_result}.
%% create_counter(Name, Help, {CLabels, Labels, Registry}) for [Name, {Labels, Help}, CLabels, _, _] <-
%% prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_counter, collect_mf, 2, [ignore], ets_value}.
%% lists:seq(0, ?WIDTH-1) as [non_neg_integer()]: lists:seq/2 gives [integer()]
{exception, prometheus_counter, schedulers_seq, 0, [ignore], library_spec}.
%% lists:foldl(fun([Labels, I, F], ResAcc) -> .. end, #{}, MFValues): the clause of the fun counts as dead
{exception, prometheus_counter, reduce_label_values, 1, [ignore], free_result}.

{module, prometheus_gauge, #{file => "prometheus/src/metrics/prometheus_gauge.erl",
                             overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case Value of ..; _ -> erlang:error({invalid_value, ..}) end: dead for number() | undefined
{exception, prometheus_gauge, set, 4, [ignore], defensive}.
{exception, prometheus_gauge, inc, 4, [ignore], ets_value}. % case ets:select_replace(?TABLE, ..) of 0 -> ..; 1 -> .. end
{exception, prometheus_gauge, dec, 2, [ignore], defensive}. % the last clause, for a value that is neither a list nor a number
{exception, prometheus_gauge, dec, 3, [ignore], defensive}. % the last clause, for a value that is not a number
{exception, prometheus_gauge, dec, 4, [ignore], defensive}. % the last clause, for a value that is not a number
{exception, prometheus_gauge, track_inprogress, 4, [ignore], defensive}. % the last clause, for what is not a fun
{exception, prometheus_gauge, set_duration, 4, [ignore], defensive}. % the last clause, for what is not a fun
%% case ets:lookup(?TABLE, {Registry, Name, LabelValues}) of [{_Key, IValue, FValue}] -> ..; [] -> .. end
{exception, prometheus_gauge, value, 3, [ignore], ets_value}.
%% [LabelValues, IValue, FValue] <- load_all_values(Registry, Name), for lists:zip/2 and sum/2: the bindings of
%% ets:match/2 are terms
{exception, prometheus_gauge, values, 2, [ignore], ets_value}.
%% create_gauge(Name, Help, {CLabels, Labels, Registry, DU}) for [Name, {Labels, Help}, CLabels, DU, _] <-
%% prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_gauge, collect_mf, 2, [ignore], ets_value}.
%% [LabelValues, IValue, FValue] <- load_all_values(Registry, Name), for lists:zip/2 and sum/2: the bindings of
%% ets:match/2 are terms
{exception, prometheus_gauge, collect_metrics, 2, [ignore], ets_value}.
%% insert_metric(Registry, Name, LabelValues, Value, fun inc/4): the spec of insert_metric/5 has Value :: number() |
%% undefined for the value and for the argument of the fun, inc/4 takes a number()
{exception, prometheus_gauge, maybe_insert_metric_for_inc, 4, [ignore], bounded_tyvar}.

{module, prometheus_histogram, #{file => "prometheus/src/metrics/prometheus_histogram.erl",
                                 overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% prometheus_metric:mf_data(MF): check_mf_exists/3 gives false for an unknown metric. The try around it makes {false,
%% false} of the failure
{exception, prometheus_histogram, deregister, 2, [ignore], unchecked_result}.
%% case ets:lookup(?TABLE, Key) of [Metric] -> ..; [] -> .. end
{exception, prometheus_histogram, observe, 4, [ignore], ets_value}.
%% case fobserve_impl(Key, Buckets, BucketPos, Value) of 0 -> ..; 1 -> ok end: the result of ets:select_replace/2
{exception, prometheus_histogram, pobserve, 6, [ignore], ets_value}.
{exception, prometheus_histogram, observe_duration, 4, [ignore], defensive}. % the last clause, for what is not a fun
%% generate_update_spec(Buckets), Buckets = prometheus_metric:mf_data(MF)
{exception, prometheus_histogram, reset, 3, [ignore], mf_data}.
%% reduce_buckets_counters(Values), Values = lists:flatten(RawValues): lists:flatten/1 gives [term()] for the lists of
%% rows
{exception, prometheus_histogram, value, 3, [ignore], library_spec}.
{exception, prometheus_histogram, buckets, 3, [ignore], mf_data}. % prometheus_metric:mf_data(MF) as buckets()
%% delete_metrics(Registry, Buckets) for [_, _, _, _, Buckets] <- prometheus_metric:metrics(?TABLE, Registry): the
%% bindings of ets:match/2 are terms
{exception, prometheus_histogram, deregister_cleanup, 1, [ignore], ets_value}.
%% create_histogram(Name, Help, {CLabels, Labels, Registry, DU, Buckets}) for [Name, {Labels, Help}, CLabels, DU,
%% Buckets] <- prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_histogram, collect_mf, 2, [ignore], ets_value}.
%% prometheus_buckets:new(RBuckets), RBuckets = prometheus_metric_spec:get_value(buckets, Spec, default)
{exception, prometheus_histogram, validate_histogram_spec, 1, [ignore], proplist}.
%% length(MFBuckets), MFBuckets = prometheus_metric:mf_data(MF)
{exception, prometheus_histogram, insert_placeholders, 3, [ignore], mf_data}.
%% gen_query_placeholder(?BUCKETS_START + BucketPos): 5 + non_neg_integer() as pos_integer()
{exception, prometheus_histogram, generate_select_replace, 4, [ignore], arith_range}.
%% lists:seq(?BUCKETS_START, ?BUCKETS_START + length(Buckets) - 1) as [pos_integer()]: lists:seq/2 gives [integer()]
{exception, prometheus_histogram, buckets_seq, 1, [ignore], library_spec}.
{exception, prometheus_histogram, metric_buckets, 1, [ignore], element_type}. % element(?BOUNDS_POS, Metric) as buckets()
%% sub_tuple_to_list(Metric, ?BUCKETS_START, ?BUCKETS_START + length(metric_buckets(Metric))): 5 + non_neg_integer() as
%% pos_integer()
{exception, prometheus_histogram, reduce_buckets_counters, 1, [ignore], arith_range}.
{exception, prometheus_histogram, transpose, 1, [ignore], bif_fun}. % lists:map(fun hd/1, M), lists:map(fun tl/1, M)
%% element(?ISUM_POS, Metric) + element(?FSUM_POS, Metric)
{exception, prometheus_histogram, reduce_sum, 1, [ignore], element_type}.
%% the last argument is [ISum, FSum | Buckets]: no clause for a list of less than two
{exception, prometheus_histogram, create_histogram_metric, 6, [ignore], list_shape}.
%% sub_tuple_to_list(Tuple, Pos + 1, Size): pos_integer() + 1 as pos_integer()
{exception, prometheus_histogram, sub_tuple_to_list, 3, [ignore], arith_range}.
%% lists:seq(0, ?WIDTH-1) as [non_neg_integer()]: lists:seq/2 gives [integer()]
{exception, prometheus_histogram, schedulers_seq, 0, [ignore], library_spec}.
%% lists:foldl(fun([Labels | V], ResAcc) when .. -> ..; ([Labels | V], ResAcc) -> .. end, #{}, MFValues): the first
%% clause of the fun counts as dead
{exception, prometheus_histogram, reduce_label_values, 1, [ignore], free_result}.
%% load_all_values(Registry, Name, Bounds), Bounds = prometheus_metric:mf_data(MF)
{exception, prometheus_histogram, mf_values, 3, [ignore], mf_data}.

{module, prometheus_quantile_summary, #{file => "prometheus/src/metrics/prometheus_quantile_summary.erl",
                                        overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% #{compress_limit := CompressLimit} = Configuration, a qs_config()
{exception, prometheus_quantile_summary, set_default, 2, [ignore], map_types}.
%% case ets:lookup(?TABLE, Key) of [] -> ..; [{Key, Count, S, Q, CompressLimit}] -> .. end
{exception, prometheus_quantile_summary, observe, 4, [ignore], ets_value}.
{exception, prometheus_quantile_summary, observe_duration, 4, [ignore], defensive}. % the last clause, for what is not a fun
%% quantile(Configuration), Configuration = prometheus_metric:mf_data(MF)
{exception, prometheus_quantile_summary, reset, 3, [ignore], mf_data}.
{exception, prometheus_quantile_summary, value, 3, [ignore], mf_data}. % #{quantiles := QNs} = prometheus_metric:mf_data(MF)
%% #{quantiles := QNs} = Configuration = prometheus_metric:mf_data(MF)
{exception, prometheus_quantile_summary, values, 2, [ignore], mf_data}.
%% create_summary(Name, Help, {CLabels, Labels, Registry, DU, Data}) for [Name, {Labels, Help}, CLabels, DU, Data] <-
%% prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_quantile_summary, collect_mf, 2, [ignore], ets_value}.
%% #{quantiles := QNs} = Configuration, a qs_config()
{exception, prometheus_quantile_summary, collect_metrics, 2, [ignore], map_types}.
%% #{compress_limit := CompressLimit} = Configuration, Configuration = prometheus_metric:mf_data(MF)
{exception, prometheus_quantile_summary, insert_metric, 5, [ignore], mf_data}.
%% prometheus_metric:mf_data(MF) as qs_config()
{exception, prometheus_quantile_summary, get_configuration, 2, [ignore], mf_data}.
%% lists:seq(0, ?WIDTH-1) as [non_neg_integer()]: lists:seq/2 gives [integer()]
{exception, prometheus_quantile_summary, schedulers_seq, 0, [ignore], library_spec}.
%% lists:sum([C || [C, _, _] <- Values]): a row is the list [Count, Sum, Estimator], its elements number() | estimator()
{exception, prometheus_quantile_summary, reduce_values, 1, [ignore], list_shape}.
%% {QNs, _} = lists:unzip(Targets), Targets = prometheus_metric_spec:get_value(targets, Spec, ..), which is any()
{exception, prometheus_quantile_summary, invariant_and_quantiles_from_spec, 1, [ignore], proplist}.
%% prometheus_metric_spec:get_value(compress_limit, Spec, default_compress_limit()) as integer()
{exception, prometheus_quantile_summary, compress_limit_from_spec, 1, [ignore], proplist}.
%% lists:foreach(.., Targets) behind the guard is_list(Targets)
{exception, prometheus_quantile_summary, validate_targets, 1, [ignore], improper_list}.
%% the clause quantile(#{invariant := Invariant}) for a qs_config()
{exception, prometheus_quantile_summary, quantile, 1, [ignore], map_types}.
%% lists:foldl(fun (Q, init) -> Q; (Q1, Q2) -> .. end, init, QList): the first clause of the fun counts as dead
{exception, prometheus_quantile_summary, fold_quantiles, 1, [ignore], free_result}.
%% #quantile_estimator{samples_count = .., data = .., invariant = ..}: data_count and inserts_since_compression are left
%% undefined, their types are number() and non_neg_integer(). The source has -dialyzer({nowarn_function,
%% quantile_merge/2}) for it
{exception, prometheus_quantile_summary, quantile_merge, 2, [ignore], missing_fields}.

{module, prometheus_summary, #{file => "prometheus/src/metrics/prometheus_summary.erl",
                               overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
{exception, prometheus_summary, observe, 4, [ignore], ets_value}. % case ets:select_replace(?TABLE, ..) of 0 -> ..; 1 -> .. end
{exception, prometheus_summary, observe_duration, 4, [ignore], defensive}. % the last clause, for what is not a fun
%% case ets:select(?TABLE, ..) of [] -> undefined; Values -> .. end: the second branch counts as dead
{exception, prometheus_summary, value, 3, [ignore], free_result}.
%% lists:foldl(fun([L, C, IS, FS], ResAcc) -> .. end, #{}, MFValues): the clause of the fun counts as dead
{exception, prometheus_summary, values, 2, [ignore], free_result}.
%% create_summary(Name, Help, {CLabels, Labels, Registry, DU}) for [Name, {Labels, Help}, CLabels, DU, _] <-
%% prometheus_metric:metrics(?TABLE, Registry): the bindings of ets:match/2 are terms
{exception, prometheus_summary, collect_mf, 2, [ignore], ets_value}.
%% lists:foldl(fun([L, C, IS, FS], ResAcc) -> .. end, #{}, MFValues): the clause of the fun counts as dead
{exception, prometheus_summary, collect_metrics, 2, [ignore], free_result}.
%% lists:seq(0, ?WIDTH-1) as [non_neg_integer()]: lists:seq/2 gives [integer()]
{exception, prometheus_summary, schedulers_seq, 0, [ignore], library_spec}.

{module, prometheus_model_helpers, #{file => "prometheus/src/model/prometheus_model_helpers.erl",
                                     overlays => [{specs, "overlay_prometheus.erl"}], timeout => 10000}}.
%% case is_atom(P) of true -> atom_to_binary(P, utf8); _ -> P end in the comprehension: P keeps its type in both
%% branches. Reported at the generator
{exception, prometheus_model_helpers, metric_name, 1, [ignore], narrowing}.
%% metric_from_tuple(_, Metric) when is_record(Metric, 'Metric') -> Metric: Metric is a tuple there, a tmetric() too.
%% Behind it: gauge_metric(Metric) and the like, where the kind of the metric goes with the type of the first argument
{exception, prometheus_model_helpers, metric_from_tuple, 2, [ignore], record_guard}.
%% ensure_list(Val) when is_list(Val) -> Val, as a [T]: a T that is itself a list comes back as it is. For create_mf/4
%% T has such values: a pbool() can be a list (prometheus_boolean()), which is then taken for a list of metrics
{exception, prometheus_model_helpers, ensure_list, 1, [ignore], source_bug}.
%% the clause when is_list(Val) gives back any list as text (binary() | iolist()), the source says FIXME: validate
%% utf8. A label value or a help that is a list but no iodata() fails later, in iolist_to_binary/1 of the text format
{exception, prometheus_model_helpers, ensure_binary_or_string, 1, [ignore], source_bug}.
