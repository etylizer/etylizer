#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/vectorclock (src) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221: one module, 24 functions. Every function has a spec in
%% the source, so there is no spec to add. The code is unchanged; two specs that were wrong are
%% corrected:
%%   set_all/2: Value :: pos_integer() -> non_neg_integer(). The first clause is for 0 and gives an
%%     empty clock, as set/3 does, whose spec has non_neg_integer().
%%   for_all_keys/3: F :: fun((pos_integer(), pos_integer()) -> boolean()) ->
%%     fun((non_neg_integer(), non_neg_integer()) -> boolean()). F gets what get/2 gives, which is 0
%%     for a node that only the other clock has.
%%
%% As the source is, 17 functions type check and 7 do not. With the two corrections it is 19 and 5.
%% With library specs and two assertions all 24 type check, none with a flag:
%%   overlay.erl for maps:remove/2 in set/3 and maps:from_list/1 in from_list/1, both give map() in OTP;
%%   overlay_vectorclock.erl for min/2 in min2/2: OTP gives a term(), the overlay one of the arguments;
%%   an assertion each in min_clock/2 and lt/2.

{study, vectorclock}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, thrown,   fixable,  "type of a caught value, known from the throws of the function"}.
{reason, nonempty, fixable,  "a comprehension over a non-empty list is not typed as non-empty"}.
{reason, spec_imprecise, real, "imprecise type spec in the source"}.

%% Library specs that overlays correct
{correction, maps, from_list, 1, spec_imprecise}.
{correction, maps, merge, 2, spec_imprecise}.
{correction, maps, remove, 2, spec_imprecise}.
{correction, erlang, min, 2, spec_imprecise}.

{module, vectorclock, #{file => "vectorclock/src/vectorclock.erl",
                        overlays => [{library, "overlay.erl"}, {library, "overlay_vectorclock.erl"}], timeout => 10000}}.
{assertion, vectorclock, {100, 15, "e14d75"}, assert_type, "[non_neg_integer(), ...]", nonempty}. % min_clock/2: Nodes is not []
{assertion, vectorclock, {212, 14, "59e606"}, assert_type, "boolean()", thrown}. % lt/2: catch R -> R
