#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% The source of etylizer itself. etylizer/src and etylizer/include are links to src and include
%% of this tree, so the study checks the code as it is, with the overlay that typecheck_etylizer
%% uses. A function is type safe when it type checks, its spec does not use dynamic(), and each
%% of its ?assert_type is a cast from term() where the type is lost (an ETS table, a file of
%% terms) or covers arithmetic. Every other function has a line below.
%%
%% Type check as is (step I): 90 modules with 1988 functions, 82 of them the two functions that
%% etylizer.hrl puts into each of 41 modules. 1774 type check, 214 do not: 152 with a type error,
%% 42 for a case that is not exhaustive, 14 for a redundant branch, 4 for a name that is not
%% found, 1 for an unsupported construct and 1 that does not finish in 10 s. They are ignored.
%%
%% Type safe (step II): 69 of the 1774 are not type safe, their line has no ignore. 30 have no
%% spec and are checked against dynamic(). 5 use dynamic() in the spec or in an ?assert_type. 28
%% have an ?assert_type that is not of the two kinds: 14 on the result of a library function, 14
%% on a value that has a type. 6 type check without the exhaustiveness check, switched off by an
%% -etylizer attribute in the source. 1705 functions are type safe.
%%   The source has 106 ?assert_type. 56 are of the two kinds: 40 take a term() from an ETS table,
%%   a persistent term, file:consult/1, element/2 or utils:everything/2 and everywhere/2, and 16
%%   cover arithmetic. The other 50 are in 34 functions: the 28 above, 3 of the 5 with dynamic()
%%   and 3 that do not type check.
%%   ?assert_pattern is checked at run time and ?annotate_type by the type checker: not counted.

{study, etylizer}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, unreviewed,   unknown, "does not type check, not analysed"}.
{reason, timeout,      fixable, "the checker does not finish in 10 s"}.
{reason, no_spec,      real,    "no spec, the function is checked against dynamic()"}.
{reason, dynamic,      real,    "dynamic() in the spec or in an ?assert_type"}.
{reason, cast,         unknown, "?assert_type on a value that has a type, not analysed"}.
{reason, cast_library, fixable, "?assert_type on the result of a library function, whose spec in OTP is wider than its use"}.
{reason, flag,         unknown, "exhaustiveness check switched off by an -etylizer attribute in the source, not analysed"}.

{module, assertions, #{file => "etylizer/src/assertions.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.
{exception, assertions, parse, 1, [], cast_library}.
{exception, assertions, render, 1, [], cast_library}.
{exception, assertions, set_anno, 2, [], cast_library}.
{exception, assertions, tail, 4, [], dynamic}.
{exception, assertions, visit, 4, [], dynamic}.
{exception, assertions, wrapper, 2, [], cast}.

{module, ast, #{file => "etylizer/src/ast.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

{module, ast_check, #{file => "etylizer/src/ast_check.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.
{exception, ast_check, check_ty, 5, [ignore], unreviewed}.
{exception, ast_check, check_ty_with_result, 5, [ignore], unreviewed}.
{exception, ast_check, otp_dep_specs, 0, [ignore], unreviewed}.
{exception, ast_check, prepare_spec, 2, [ignore], unreviewed}.

