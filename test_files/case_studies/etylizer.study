#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% The source of etylizer itself. etylizer/src and etylizer/include are links to src and include
%% of this tree, so the study checks the code as it is, with the overlay that typecheck_etylizer
%% uses. A function is type safe when it type checks, its spec does not use dynamic(), and each
%% of its ?assert_type is a cast from term() where the type is lost (an ETS table, a file of
%% terms) or covers arithmetic.
%%
%% Every function type checks: no line has ignore. The functions with a line below are the ones
%% that are not type safe.
%%   ?assert_pattern is checked at run time and ?annotate_type by the type checker: they are no
%%   casts in this sense.

{study, etylizer}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, dynamic, fixable,  "?assert_type with dynamic() for a type variable of the spec, which an assertion cannot name"}.
{reason, flag,    inherent, "the clauses cover the values that occur, by an invariant of the data, and not the type: exhaustiveness check switched off by an -etylizer attribute in the source"}.

{module, assertions, #{file => "etylizer/src/assertions.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

{module, ast, #{file => "etylizer/src/ast.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

%% check_ty/5 takes 6 s
{module, ast_check, #{file => "etylizer/src/ast_check.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 30000}}.

{module, ast_erl, #{file => "etylizer/src/ast_erl.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

{module, ast_lib, #{file => "etylizer/src/ast_lib.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

%% trans_exp/3 takes 8 s
{module, ast_transform, #{file => "etylizer/src/ast_transform.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 30000}}.

{module, ast_traverse, #{file => "etylizer/src/ast_traverse.erl", overlays => [{library, "../../overlays/etylizer_overlay.erl"}], timeout => 10000}}.

