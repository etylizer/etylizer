#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidotec_pb (src) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged: the protocol buffer client of Antidote, 7
%% modules with 62 functions, 38 of them with a spec in the source. It uses the codec of the study
%% antidote_pb_codec (encode_request/1, decode_response/1 and the types of the messages), which is
%% checked here in the state of that study.
%%
%% Type check raw (step I): no overlay, a function without a spec is checked against dynamic(). 52
%% functions type check, 10 do not.
%%
%% Missing specs (step II): overlay_antidotec_pb.erl gives a spec to each of the 24 functions that
%% have none in the source; every module is checked with it. The two functions of the codec that
%% the client calls have a spec in the source of the codec, so its overlay is not listed. No flag,
%% no assertion, no library overlay. 42 functions type check, 20 do not and are ignored: the 10 of
%% step I and 10 that fail newly, 8 of antidotec_pb_socket, which were dynamic(), and
%% abort_transaction/2 and commit_transaction/2 of antidotec_pb, which call one of them. Of the 10
%% of step I, 7 keep their first error; the 3 of antidotec_pb_management now fail first at the
%% reply of a call. antidotec_pb_socket:handle_info/2 is one of the 7 and gets the reason of the
%% error behind the first one, which its spec shows: the program is wrong.
%% By class: 10 for the source (7 a type that is too imprecise, 1 a wrong spec, 2 an error in the
%% program), 10 for what types do not show (7 the reply of a gen_server call, 2 what
%% gen_server:start_link/3 and start/3 give, 1 a partial function).
%% A function with more than one error has the reason of the source if there is one; the comment
%% then names what the checker reports first.

{study, antidotec_pb}.
{deps, ["antidote_pb_codec"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
{reason, partial,             inherent, "partial function, the callers rule out the missing case"}.
{reason, call_reply,          inherent, "reply of a gen_server call, typed by the handle_call clause that answers it"}.
{reason, start_args,          fixable,  "what gen_server:start_link/3 hands to init/1 and gives back, typed by init/1 of this module"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, spec_wrong,          real,     "wrong type in the source"}.
{reason, program_wrong,       real,     "the program is wrong"}.

{module, antidotec_counter, #{file => "antidotec_pb/src/antidotec_counter.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                              timeout => 10000}}.

{module, antidotec_datatype, #{file => "antidotec_pb/src/antidotec_datatype.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                               timeout => 10000}}.

{module, antidotec_pb, #{file => "antidotec_pb/src/antidotec_pb.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                         timeout => 10000}}.
%% 54: {start_transaction, EncTimestamp, TxnProperties} with TxnProperties :: term(), request() wants a list()
{exception, antidotec_pb, start_transaction, 3, [ignore], spec_imprecise}.
%% 82: antidote_pb_codec:decode_response(Result), Result is the reply of antidotec_pb_socket:call_infinity/2, a term()
{exception, antidotec_pb, abort_transaction, 2, [ignore], call_reply}.
%% 108-110: {static, TxId} gives {ok, CommitTime} from get_last_commit_time/1, a term(): #state.last_commit_time of the
%% socket is a term(). Reported first: 99, decode_response(Result) with the reply of a call
{exception, antidotec_pb, commit_transaction, 2, [ignore], spec_imprecise}.
%% 116: {update_objects, Updates, TxId} with Updates :: [{term(), term(), term()}], request() wants [update()]
{exception, antidotec_pb, update_objects, 3, [ignore], spec_imprecise}.
%% 160: lists:map(fun({Type, Val}) -> .. end, Values): read_values/3 gives [term()], the fun takes pairs
{exception, antidotec_pb, read_objects, 3, [ignore], spec_imprecise}.
%% 170: {read_objects, Objects, TxId} with Objects :: [term()], request() wants [bound_object()]
{exception, antidotec_pb, read_values, 3, [ignore], spec_imprecise}.

{module, antidotec_pb_management, #{file => "antidotec_pb/src/antidotec_pb_management.erl",
                                    overlays => [{specs, "overlay_antidotec_pb.erl"}], timeout => 10000}}.
%% antidote_pb_codec:decode_response(Result) at 40, 54 and 68: Result is the reply of call_infinity/2, a term()
{exception, antidotec_pb_management, create_dc, 2, [ignore], call_reply}.
{exception, antidotec_pb_management, get_connection_descriptor, 1, [ignore], call_reply}.
{exception, antidotec_pb_management, connect_to_dcs, 2, [ignore], call_reply}.

{module, antidotec_pb_socket, #{file => "antidotec_pb/src/antidotec_pb_socket.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                                timeout => 10000}}.
{exception, antidotec_pb_socket, init, 1, [ignore], partial}. % 81: [term()], the clause takes a list of three
%% 99, 108: gen_server:start_link/3 and start/3 can give ignore; init/1 never does
{exception, antidotec_pb_socket, start_link, 3, [ignore], start_args}.
{exception, antidotec_pb_socket, start, 3, [ignore], start_args}.
{exception, antidotec_pb_socket, stop, 1, [ignore], call_reply}. % 112: call_infinity(Pid, stop), the reply is ok
{exception, antidotec_pb_socket, store_commit_time, 2, [ignore], call_reply}. % 120: gen_server:call/3, the reply is ok
{exception, antidotec_pb_socket, get_last_commit_time, 1, [ignore], call_reply}. % 123: gen_server:call/3, the reply is {ok, _}
%% 140: after a failed gen_tcp:send/2 the new state is the result of gen_tcp:close/1, the atom ok.
%% Reported first: 135, gen_tcp:send(State#state.sock, Msg), the field sock is port() | undefined
{exception, antidotec_pb_socket, handle_call, 3, [ignore], program_wrong}.
%% 160: {req_timeout, Ref} reads Active#request.tref, and active is undefined once the reply has come: a timer
%% that fired before it was cancelled crashes the process. Reported first: 157, ok = inet:setopts(Sock, ..)
{exception, antidotec_pb_socket, handle_info, 2, [ignore], program_wrong}.
%% 184: portnum() :: non_neg_integer(), gen_tcp:connect/4 wants inet:port_number(). Reported first: 181, the
%% clause takes only a state with sock =:= undefined
{exception, antidotec_pb_socket, connect, 1, [ignore], spec_imprecise}.
%% 240: the field from of #request{} has no type, gen_server:reply/2 wants a from(). Reported first: 239, the
%% clause takes only a request with From /= undefined
{exception, antidotec_pb_socket, send_caller, 2, [ignore], spec_imprecise}.

{module, antidotec_reg, #{file => "antidotec_pb/src/antidotec_reg.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                          timeout => 10000}}.
{exception, antidotec_reg, value, 1, [ignore], spec_wrong}. % 57: [term()], the value of a register is any term

{module, antidotec_set, #{file => "antidotec_pb/src/antidotec_set.erl", overlays => [{specs, "overlay_antidotec_pb.erl"}],
                          timeout => 10000}}.
