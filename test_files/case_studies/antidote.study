{module, inter_dc_manager, #{file => "antidote/src/inter_dc_manager.erl",
                             overlays => [{specs, "overlay_antidote.erl"},
                                          {library, "overlay_riak_core_lite_lib.erl"},
                                          {library, "overlay_antidote_lib.erl"}],
                             timeout => 10000}}.
%% get_descriptor/0: the address lists of the nodes come out of rpc:call/4 as term() and go into the fields publishers and
%% logreaders of the descriptor
{assertion, inter_dc_manager, {73, 22, "d24731"}, assert_type, "[[socket_address()]]", untyped_value}.
{assertion, inter_dc_manager, {74, 22, "9c7895"}, assert_type, "[{[partition_id()], [socket_address()]}]", untyped_value}.
%% ok = rpc:call/4, a term(), four times in the fun of lists:foreach/2. Behind it the replies of the vnodes in the pairs of
%% dc_utilities:bcast_vnode_sync/2 are any(), the second fun of lists:foreach/2 takes {_, ok}
{exception, inter_dc_manager, start_bg_processes, 1, [ignore], in_fun}.
%% Responses3 = [X = ok || X <- Responses3]: both matches have a bound variable as their pattern and count as not exhaustive. In
%% front of it {ok, MetaDataName} = dc_meta_data_utilities:get_meta_data_name() and the replies of the vnodes in the pairs of
%% dc_utilities:bcast_my_vnode_sync/2, any(), which the fun of lists:foreach/2 takes as {_, ok}
{exception, inter_dc_manager, check_node_restart, 0, [ignore], bound_pattern}.
%% ok = rpc:call/4, a term(), in the funs of lists:foreach/2
{exception, inter_dc_manager, forget_dc, 2, [ignore], in_fun}.
%% drop_ping/1: the replies of the vnodes in the pairs of dc_utilities:bcast_vnode_sync/2 are any(), the fun of lists:foreach/2
%% takes {_, ok}
{assertion, inter_dc_manager, {308, 9, "a741ce"}, assert_type, "[{partition_id(), ok}]", call_reply}.

{module, inter_dc_pub, #{file => "antidote/src/inter_dc_pub.erl",
                         overlays => [{specs, "overlay_antidote.erl"},
