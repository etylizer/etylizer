{module, stable_meta_data_server, #{file => "antidote/src/stable_meta_data_server.erl",
                                    overlays => [{specs, "overlay_antidote.erl"},
                                                 {library, "overlay_riak_core_lite_lib.erl"},
                                                 {library, "overlay_antidote_lib.erl"}],
                                    timeout => 10000}}.
%% ok = gen_server:call/2, whose reply is term(), in the fun of lists:foreach/2
{exception, stable_meta_data_server, sync_meta_data, 0, [ignore], in_fun}.
%% ok = gen_server:call/2, whose reply is term(), in the fun of lists:foreach/2
{exception, stable_meta_data_server, broadcast_meta_data_list, 1, [ignore], in_fun}.
%% ok = gen_server:call/2, whose reply is term(), in the fun of lists:foreach/2
{exception, stable_meta_data_server, broadcast_meta_data_internal, 3, [ignore], in_fun}.
%% ok = gen_server:call/2, whose reply is term(), in the fun of lists:foreach/2
{exception, stable_meta_data_server, broadcast_meta_data_merge, 4, [ignore], in_fun}.
%% init/1: {ok, DataDir} = application:get_env(antidote, data_dir), which can be undefined and has term() for the value; {ok,
%% DetsTable} = dets:open_file/2; the setting recover_meta_data_on_start, a term(), is the flag of the case; dets:to_ets/2 can
%% give an error, the result goes into the field table; ok = dets:delete_all_objects/1 and ok = dets:sync/1
{assertion, stable_meta_data_server, {159, 21, "473734"}, assert_type, "{ok, string()}", untyped_value}.
{assertion, stable_meta_data_server, {162, 5, "1df9b5"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, stable_meta_data_server, {165, 20, "46a264"}, assert_type, "boolean()", untyped_value}.
{assertion, stable_meta_data_server, {170, 33, "ec97c4"}, assert_type, "ets:tab()", unchecked_result}.
{assertion, stable_meta_data_server, {174, 17, "1e239d"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, stable_meta_data_server, {177, 5, "95189a"}, assert_pattern, "ok", body_exhaustiveness}.
%% ok = gen_server:call/2, whose reply is term(), in the fun of lists:foreach/2 in the clause for {broadcast_meta_data}. In
%% front of it the request is term(): the flag, the list of the pairs, the two funs of {merge_meta_data, ..} and the list of
%% {sync_meta_data, NewList} are used at their types
{exception, stable_meta_data_server, handle_call, 3, [ignore], in_fun}.
%% ets:tab2list/1 gives [tuple()], the entries of the table are pairs {key(), term()}; the call at 279:5 (hash 00b81b) is the
%% body of the function and crashes the engine with an assertion
{exception, stable_meta_data_server, get_all_values_from_stable_meta_data_table, 0, [ignore], assertion_crash}.
%% case ets:lookup(Table, Key) of []; [{Key, Value}] with Key bound: with the result asserted as [] or one pair (ets:lookup/2
%% gives [tuple()]) the case counts as not exhaustive
{exception, stable_meta_data_server, get_value_by_table, 2, [ignore], bound_pattern}.

{module, stable_time_functions, #{file => "antidote/src/stable_time_functions.erl",
                                  overlays => [{specs, "overlay_antidote.erl"},
