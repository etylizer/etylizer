{exception, cure, update_objects, 3, [ignore], spec_imprecise}.
%% case Objects of [_O]; [_H | _T]: no clause for [], a static read of no objects ends in case_clause (obtain_objects/3 answers
%% it with {ok, []})
{exception, cure, obtain_objects, 4, [ignore], source_bug}.
%% the fun of lists:map/2 calls antidote_crdt:value(Type, State) with the type() of a bound_object()
{exception, cure, transform_reads, 3, [ignore], crdt_type}.
%% the fun of lists:map/2 calls antidote_crdt:value(Type, State) with the type() of a bound_object()
{exception, cure, transform_reads_from_validate_or_reads, 2, [ignore], crdt_type}.
%% {ok, Pid} = clocksi_interactive_coord_sup:start_fsm(), the result of supervisor:start_child/2; behind it the reply of
%% gen_statem:call/2
{exception, cure, clocksi_istart_tx, 2, [ignore], body_exhaustiveness}.
{exception, cure, clocksi_full_icommit, 1, [ignore], call_reply}. % reply of gen_statem:call/3
{exception, cure, clocksi_iprepare, 1, [ignore], call_reply}. % reply of gen_statem:call/3
{exception, cure, clocksi_icommit, 1, [ignore], call_reply}. % reply of gen_statem:call/3

