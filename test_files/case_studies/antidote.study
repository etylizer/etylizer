#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged: the 55 modules of the Antidote server and
%% its three headers. 414 of the 722 functions have a spec in the source. overlay_antidote.erl gives a
%% spec to each of the other 308, and every module is checked with it, so that a call into another
%% module of antidote is checked against the spec of the callee. No flag, no assertion.
%%
%% The dependencies are case studies of their own in this directory, and the driver passes every
%% directory below this one that holds sources or headers to the engine. So all modules that
%% antidote calls are found: antidote_crdt, vectorclock, antidote_pb_codec, erlzmq, ranch and
%% riak_core (the package riak_core_lite; -include_lib("riak_core/include/riak_core_vnode.hrl") of
%% logging_vnode, materializer_vnode and inter_dc_log_sender_vnode resolves from this directory).
%% antidote_stats is only reached by messages (the macro ?STATS casts to its collector), poolboy
%% only through riak_core.
%%
%% A module that calls into a dependency also has the spec overlay of that dependency's own study
%% (category deps): the call is then checked against a spec where the source of the dependency has
%% none. That matters for riak_core, which has no spec for 16 of the 34 functions that antidote calls
%% (riak_core_vnode_master:sync_command/3,4, command/3,4 and get_vnode_pid/2, riak_core:register/1,
%% riak_core_status:ring_status/0, ...): 18 functions that type check without overlay_riak_core_lite.erl
%% fail with it, 14 of them because the reply of a vnode command is a term(). For antidote_crdt it is
%% one function (antidote_crdt_counter_b:generate_downstream_check/4, no change), for
%% antidote_pb_codec, erlzmq and ranch none: all functions that antidote calls there have a spec in
%% the source. No antidote module calls antidote_stats or poolboy, their overlays are not listed.
%%
%% The driver defines no macro. So the tests under -ifdef(TEST) are not checked, and meta_data_sender
%% takes the variant of -else for -ifdef(EUNIT): get_node_list/0 and get_node_and_partition_list/0.
%%
%% All 55 modules run: 424 functions type check, 298 do not. One of the 298 is a name error
%% (zmq_utils:connection_string/1 calls inet_parse:ntoa/1, which has no spec in OTP), none is an
%% internal error. The source of each of the 298 was read, no exception has the reason unknown.
%% 80 of them type check without the overlays, where the 308 functions without a spec are dynamic().

{study, antidote}.
{deps, ["antidote_crdt", "antidote_pb_codec", "erlzmq", "poolboy", "ranch", "riak_core", "vectorclock"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
%% The reason of an exception is the one of the first error that the checker reports for the function.
{reason, otp_no_spec,          fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, log_macro,            fixable,  "the ?LOG_ macros of logger.hrl end in erlang:apply(logger, macro_log, [..]), a term() for the checker and not the ok of that call: a function that gives the value of the macro as its result fails"}.
{reason, free_result,          fixable,  "library spec whose type variables are bound only in when (rpc:call/4,5, application:get_env/2,3, ets:first/1, dets:sync/1, lists:foldl/3): any use of the result passes, a pattern or a branch on such a value is dead. The macro ?STATS of antidote.hrl is such a case on application:get_env/3"}.
{reason, dict_types,           fixable,  "key and value type of a dict:dict(K, V) are lost: the branches on a result of dict:find/2 or dict:fetch/2 and the patterns of a fun for dict:filter/2, dict:fold/3 or the pairs of dict:to_list/1 are dead"}.
{reason, map_types,            fixable,  "map types with more than one association or with mandatory associations are not supported: supervisor:sup_flags() and supervisor:child_spec() given as maps do not check"}.
{reason, bound_pattern,        fixable,  "a pattern with an already bound variable is not handled: the match counts as not exhaustive, a case clause whose pattern is the scrutinee variable as matching nothing"}.
{reason, narrowing,            fixable,  "a type test does not narrow: a filter X /= undefined in a comprehension, a case on is_binary(X) for its branches, X == undefined on the left of orelse for the right"}.
{reason, library_spec,         fixable,  "spec of a library function too imprecise"}.
{reason, body_exhaustiveness,  inherent, "exhaustiveness of a match or a case inside the body: the program lets it crash for the other values"}.
{reason, partial,              inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,            inherent, "defensive clause, dead for the spec"}.
{reason, nonempty_list,        inherent, "hd/1, lists:last/1 or a match with [H | _] on a list that the program knows is not empty"}.
{reason, number_range,         inherent, "range of a number (positive, not negative) that the types do not show"}.
{reason, bit_size,             fixable,  "a binary built with a segment of variable size is a bitstring() for the checker; that the size N * 8 makes whole bytes is arithmetic"}.
{reason, unchecked_result,     inherent, "a result that can be an error value, used as the success value"}.
{reason, untyped_value,        inherent, "term() from ets, disk_log, the stable meta data, element/2 of a tuple() or a container with term() values, used at the type the program expects"}.
{reason, call_reply,           inherent, "the reply of gen_server:call, gen_statem:call or a vnode command (riak_core_vnode_master:sync_command) is term(): the spec promises the type of the reply, or the body matches it"}.
{reason, message_term,         inherent, "the message of a process callback with a catch-all clause is term(), a clause uses its payload at the type the sender gives"}.
{reason, start_ret,            inherent, "result of starting a process, typed by the init function of the module: it gives neither ignore nor an error"}.
{reason, ets_new,              fixable,  "ets:new/2 gives a tid() when the table is not named"}.
{reason, correlated,           inherent, "the type of a value depends on another value (the op_type of a log operation for its payload, the size kept next to a list, the state of the fsm for a field of its data)"}.
{reason, deserialize,          inherent, "binary_to_term/1 gives term()"}.
{reason, record_undefined,     real,     "a record field declared T | undefined is used as T"}.
{reason, crdt_type,            real,     "antidote.hrl says type() :: atom() for a CRDT type, the functions of antidote_crdt take antidote_crdt:typ()"}.
{reason, dep_spec,             real,     "imprecise type spec in the source of a dependency"}.
{reason, spec_misuse,          real,     "a function is used against its spec, without effect at run time"}.
{reason, spec_imprecise,       real,     "imprecise type spec in the source: of the function, of a function it calls or of a record field"}.
{reason, spec_wrong,           real,     "wrong type in the source: of the function, of a function it calls or of a record field"}.
{reason, source_bug,           real,     "error in the program"}.

{module, antidote, #{file => "antidote/src/antidote.erl",
                     overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
%% [Node] = log_utilities:get_preflist_from_key(..), a preflist of ?N = 1 nodes
{exception, antidote, get_log_operations_internal, 2, [ignore], body_exhaustiveness}.
%% promises {ok, {[term()], [object_token()]}}, cure:validate_or_read_objects/3 gives {ok, [valid | {invalid, term(),
%% binary()}]}
{exception, antidote, validate_or_read_objects, 3, [ignore], spec_wrong}.
{exception, antidote, type_check_update, 1, [ignore], crdt_type}. % antidote_crdt:is_operation(Type, {Op, Param})
%% the spec says atom() for the property, the clauses take update_clock and certify
{exception, antidote, get_txn_property, 2, [ignore], spec_imprecise}.

{module, antidote_app, #{file => "antidote/src/antidote_app.erl",
                         overlays => [{specs, "overlay_antidote.erl"},
                                      {deps, "overlay_riak_core_lite.erl"}],
                         timeout => 10000}}.
{exception, antidote_app, start, 2, [ignore], body_exhaustiveness}. % ok = logger:add_handler/3
%% {ok, DataDir} = application:get_env(antidote, data_dir)
{exception, antidote_app, validate_data_dir, 0, [ignore], body_exhaustiveness}.

{module, antidote_console, #{file => "antidote/src/antidote_console.erl",
                             overlays => [{specs, "overlay_antidote.erl"},
                                          {deps, "overlay_riak_core_lite.erl"}],
                             timeout => 10000}}.
%% the clause takes [NodeStr], the one argument of the console command
{exception, antidote_console, staged_join, 1, [ignore], partial}.
{exception, antidote_console, down, 1, [ignore], partial}. % the clause takes [Node], the one argument of the console command
%% riak_core_status:ringready/0 promises {error, any()}, the case has the two errors it gives
{exception, antidote_console, ringready, 1, [ignore], dep_spec}.

{module, antidote_dc_manager, #{file => "antidote/src/antidote_dc_manager.erl",
                                overlays => [{specs, "overlay_antidote.erl"},
                                             {deps, "overlay_riak_core_lite.erl"}],
                                timeout => 10000}}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, join_new_nodes, 1, [ignore], body_exhaustiveness}.
%% the first clause gives the value of ?LOG_WARNING as ok
{exception, antidote_dc_manager, plan_and_commit, 1, [ignore], log_macro}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, wait_until_ring_no_pending_changes, 0, [ignore], body_exhaustiveness}.
{exception, antidote_dc_manager, wait_until_ring_ready, 1, [ignore], free_result}. % case on rpc:call/4

{module, antidote_error_monitor, #{file => "antidote/src/antidote_error_monitor.erl",
                                   overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
{exception, antidote_error_monitor, log, 2, [ignore], free_result}. % ?STATS(..): the case of the macro on application:get_env/3

{module, antidote_ets_meta_data, #{file => "antidote/src/antidote_ets_meta_data.erl",
                                   overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{merged_data, Other}]
{exception, antidote_ets_meta_data, get_meta_data_sender_merged_data, 2, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_meta_data_as_map, 1, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_remote_meta_data_as_map, 1, [ignore], untyped_value}.
%% promises true, ets:insert_new/2 gives boolean()
{exception, antidote_ets_meta_data, insert_remote_meta_data_new, 3, [ignore], spec_wrong}.

{module, antidote_ets_txn_caches, #{file => "antidote/src/antidote_ets_txn_caches.erl",
                                    overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{Key, List}]
{exception, antidote_ets_txn_caches, get_prepared_txn_by_key_and_table, 2, [ignore], untyped_value}.
%% get_prepared_cache_name/1 promises cache_id(), which has ets:tid(); ets:new/2 wants the atom it gives
{exception, antidote_ets_txn_caches, create_prepared_txns_cache, 1, [ignore], spec_imprecise}.

{module, antidote_hooks, #{file => "antidote/src/antidote_hooks.erl",
                           overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as the hook {Module, Function}
{exception, antidote_hooks, get_hooks, 2, [ignore], untyped_value}.
%% the one clause takes {increment, 1} on an antidote_crdt_counter_pn: the example hook of the documentation
{exception, antidote_hooks, test_increment_hook, 1, [ignore], partial}.
{exception, antidote_hooks, test_post_hook, 1, [ignore], body_exhaustiveness}. % {ok, _CT} = antidote:update_objects/3

{module, antidote_node_event_handler, #{file => "antidote/src/antidote_node_event_handler.erl",
                                        overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.

{module, antidote_pb_process, #{file => "antidote/src/antidote_pb_process.erl",
                                overlays => [{specs, "overlay_antidote.erl"},
                                             {deps, "overlay_antidote_pb_codec.erl"}],
                                timeout => 10000}}.
%% binary_to_term(Clock) for snapshot_time() | ignore | txid(); the spec says binary() for a clock that the case tests for
%% undefined
{exception, antidote_pb_process, from_bin, 1, [ignore], deserialize}.
%% no clause for {validate_or_read_objects, _, _, _}, which antidote_pb_codec:request() has and the codec decodes
{exception, antidote_pb_process, process, 1, [ignore], source_bug}.

{module, antidote_pb_protocol, #{file => "antidote/src/antidote_pb_protocol.erl",
                                 overlays => [{specs, "overlay_antidote.erl"},
                                              {deps, "overlay_antidote_pb_codec.erl"},
                                              {deps, "overlay_ranch.erl"}],
                                 timeout => 10000}}.
%% {ok, Socket} = ranch:handshake(Ref), which can give {continue, _}
{exception, antidote_pb_protocol, init, 3, [ignore], body_exhaustiveness}.
%% antidote_pb_process:process/1 promises antidote_pb_codec:response(), the reply as a client decodes it; it gives, and
%% antidote_pb_codec:encode_response/1 takes, response_in(): the objects that were read next to their values
{exception, antidote_pb_protocol, handle, 3, [ignore], spec_wrong}.

{module, antidote_pb_sup, #{file => "antidote/src/antidote_pb_sup.erl",
                            overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_ranch.erl"}], timeout => 10000}}.
{exception, antidote_pb_sup, init, 1, [ignore], map_types}. % the supervisor flags as a map with three keys

{module, antidote_ring_event_handler, #{file => "antidote/src/antidote_ring_event_handler.erl",
                                        overlays => [{specs, "overlay_antidote.erl"},
                                                     {deps, "overlay_riak_core_lite.erl"}],
                                        timeout => 10000}}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, handle_event, 2, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, update_status, 0, [ignore], body_exhaustiveness}.

{module, antidote_stats, #{file => "antidote/src/antidote_stats.erl",
                           overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% the field timer is any(), erlang:cancel_timer/1 takes a reference()
{exception, antidote_stats, handle_info, 2, [ignore], spec_imprecise}.
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, antidote_stats, update_staleness, 0, [ignore], free_result}.
%% round/1 gives integer(); the staleness is not negative, the maximum of the fold starts at 0
{exception, antidote_stats, calculate_staleness, 0, [ignore], number_range}.
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, antidote_stats, update_dc_count, 0, [ignore], free_result}.
%% the filter ProcessInfo /= undefined does not narrow the result of erlang:process_info/1 for proplists:get_value/2
{exception, antidote_stats, update_processes_info, 1, [ignore], narrowing}.

{module, antidote_sup, #{file => "antidote/src/antidote_sup.erl",
                         overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% the child spec of antidote_pb_sup as a map with six keys, next to ten child specs that are tuples
{exception, antidote_sup, init, 1, [ignore], map_types}.

{module, antidote_warning_monitor, #{file => "antidote/src/antidote_warning_monitor.erl",
                                     overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, antidote_warning_monitor, log, 2, [ignore], free_result}.

{module, bcounter_mgr, #{file => "antidote/src/bcounter_mgr.erl",
                         overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, bcounter_mgr, generate_downstream, 3, [ignore], call_reply}. % reply of gen_server:call/2 for a decrement
%% case Queue of []; Queue in the fun of orddict:fold/3: the last pattern is the scrutinee, so the fun counts as taking [] only.
%% Behind it the queue is an orddict:orddict() without types in the source (#state.req_queue) and so in the overlay: the fun
%% takes its keys as {Key, Bucket}, its values as lists of {Amount, Time}
{exception, bcounter_mgr, handle_info, 2, [ignore], bound_pattern}.
{exception, bcounter_mgr, request_remote, 2, [ignore], body_exhaustiveness}. % {ok, [Obj], _} = antidote:read_objects/3
%% the transfers are an orddict:orddict() without types in the source (#state.last_transfers) and so in the overlay: the fun of
%% orddict:filter/2 takes its values as erlang:timestamp() for timer:now_diff/2
{exception, bcounter_mgr, cancel_consecutive_req, 2, [ignore], spec_imprecise}.
%% the queue is an orddict:orddict() without types in the source (#state.req_queue) and so in the overlay: the fun of
%% orddict:filter/2 takes its values as lists of {Amount, Time}
{exception, bcounter_mgr, clear_pending_req, 2, [ignore], spec_imprecise}.

{module, clocksi_downstream, #{file => "antidote/src/clocksi_downstream.erl",
                               overlays => [{specs, "overlay_antidote.erl"},
                                            {deps, "overlay_antidote_crdt.erl"}],
                               timeout => 10000}}.
%% antidote_crdt:require_state_downstream(Type, Update)
{exception, clocksi_downstream, generate_downstream_op, 6, [ignore], crdt_type}.

{module, clocksi_interactive_coord, #{file => "antidote/src/clocksi_interactive_coord.erl",
                                      overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% promises {ok, pid()}, gen_statem:start_link/3 gives gen_statem:start_ret()
{exception, clocksi_interactive_coord, start_link, 0, [ignore], start_ret}.
%% hd(Preflist) of log_utilities:get_preflist_from_key/1
{exception, clocksi_interactive_coord, perform_singleitem_operation, 4, [ignore], nonempty_list}.
%% the spec says list() for the properties, create_transaction_record/3 takes txn_properties()
{exception, clocksi_interactive_coord, perform_singleitem_update, 5, [ignore], spec_imprecise}.
%% start_tx_internal/3 says snapshot_time() for the clock, the request has snapshot_time() | ignore as cure:clocksi_istart_tx/2
%% sends it; behind it {ok, State} = start_tx_internal(..), which promises {error, any()} as well
{exception, clocksi_interactive_coord, wait_for_start_transaction, 3, [ignore], spec_imprecise}.
%% the clause for info hands the value of the message, any(), to the clause for cast, which takes {prepared, Time}, abort or
%% timeout
{exception, clocksi_interactive_coord, receive_prepared, 3, [ignore], message_term}.
%% the field updated_partitions is list(), clocksi_vnode:commit/3 takes the write sets by partition; behind it the fields
%% transaction and commit_time can be undefined
{exception, clocksi_interactive_coord, committing, 3, [ignore], spec_imprecise}.
%% the spec says {committed | clock_time()}, a tuple of one element, for the event {committed, CommitTime}; and
%% gen_statem:event_handler_result(state()) as prepare_done/2
{exception, clocksi_interactive_coord, single_committing, 3, [ignore], spec_wrong}.
%% the field return_accumulator is list() | ok | {error, reason()}; while the reads come in it is the list that replace_first/3
%% takes. Behind it replace_first/3 can give error and the field from can be undefined
{exception, clocksi_interactive_coord, receive_read_objects_result, 3, [ignore], correlated}.
%% the field return_accumulator is list() | ok | {error, reason()}; while the reads come in it is the list that replace_first/3
%% takes. Behind it the field from can be undefined
{exception, clocksi_interactive_coord, receive_validate_or_read_objects_result, 3, [ignore], correlated}.
%% prepare/1 promises gen_statem:event_handler_result(state()), which makes the record the type of the state name; behind it the
%% field from can be undefined, and the clause for info as in receive_prepared/3
{exception, clocksi_interactive_coord, receive_logging_responses, 3, [ignore], spec_wrong}.
%% the clause for info hands the value of the message, any(), to the clause for cast, which takes committed
{exception, clocksi_interactive_coord, receive_committed, 3, [ignore], message_term}.
%% the spec says proplists:proplist() for the properties, the field properties is txn_properties()
{exception, clocksi_interactive_coord, init_state, 3, [ignore], spec_imprecise}.
%% the spec says proplists:proplist() for the properties, create_transaction_record/3 takes txn_properties()
{exception, clocksi_interactive_coord, start_tx_internal, 3, [ignore], spec_imprecise}.
%% antidote:get_txn_property/2 promises atom(), the case has update_clock and no_update_clock
{exception, clocksi_interactive_coord, create_transaction_record, 3, [ignore], spec_imprecise}.
%% the spec says atom() and term() for the command and its argument, the clauses take seven commands, four of them with a tuple
{exception, clocksi_interactive_coord, execute_command, 4, [ignore], source_bug}.
%% Transaction#transaction.txn_id, the field transaction is undefined | tx()
{exception, clocksi_interactive_coord, reply_to_client, 1, [ignore], record_undefined}.
%% the field updated_partitions is list(), lists:keyfind/3 takes a list of tuples
{exception, clocksi_interactive_coord, apply_tx_updates_to_snapshot, 4, [ignore], spec_imprecise}.
%% the field updated_partitions is list(), lists:keyfind/3 takes a list of tuples
{exception, clocksi_interactive_coord, has_tx_updates, 2, [ignore], spec_imprecise}.
%% [NotMyKey | replace_first(..)]: the rest is error when the key is not in the list; the callers put every key there first
{exception, clocksi_interactive_coord, replace_first, 3, [ignore], unchecked_result}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_read, 4, [ignore], library_spec}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_validate_or_read, 4, [ignore], library_spec}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_update, 5, [ignore], library_spec}.
%% lists:keyreplace/4 gives [tuple()]
{exception, clocksi_interactive_coord, append_updated_partitions, 4, [ignore], library_spec}.
%% the field op of #update_log_payload{} is op(), a pair {op_name(), op_param()}; it holds the downstream effect(), a term().
%% Reported where the log operation goes to logging_vnode:asyn_append/4
{exception, clocksi_interactive_coord, async_log_propagation, 5, [ignore], spec_wrong}.
%% Transaction = State#state.transaction with Transaction bound by the head; behind it the field is undefined | tx()
{exception, clocksi_interactive_coord, prepare, 1, [ignore], bound_pattern}.
%% the field updated_partitions is list(), clocksi_vnode:single_commit/2 takes the write sets by partition; behind it the spec
%% promises gen_statem:event_handler_result(state()), which makes the record the type of the state name
{exception, clocksi_interactive_coord, prepare_done, 2, [ignore], spec_imprecise}.
%% prepare_done/2 promises gen_statem:event_handler_result(state()), which makes the record the type of the state name
{exception, clocksi_interactive_coord, process_prepared, 2, [ignore], spec_wrong}.
%% the field updated_partitions is list(), clocksi_vnode:abort/2 takes the write sets by partition; behind it the field
%% transaction is undefined | tx()
{exception, clocksi_interactive_coord, abort, 1, [ignore], spec_imprecise}.

{module, clocksi_interactive_coord_sup, #{file => "antidote/src/clocksi_interactive_coord_sup.erl",
                                          overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.

{module, clocksi_materializer, #{file => "antidote/src/clocksi_materializer.erl",
                                 overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% {Length, _ListLen} = element(2, Tuple) for a tuple()
{exception, clocksi_materializer, get_first_id, 1, [ignore], untyped_value}.
%% the spec says snapshot_time() | ignore for MinSnapshotTime, materialize_intern/11 takes a snapshot_time()
{exception, clocksi_materializer, materialize, 4, [ignore], spec_imprecise}.
%% {Length, _ListLen} = element(2, TupleOps) for a tuple()
{exception, clocksi_materializer, materialize_intern, 11, [ignore], untyped_value}.
%% is_op_in_snapshot/7 says txid() for TxId, here it is txid() | ignore as materialize_intern/11 has it
{exception, clocksi_materializer, materialize_intern_perform, 12, [ignore], spec_imprecise}.
%% the spec says snapshot_time() for PrevTime, the case tests it for ignore and materialize_intern_perform/12 passes
%% snapshot_time() | ignore
{exception, clocksi_materializer, is_op_in_snapshot, 7, [ignore], spec_wrong}.

{module, clocksi_readitem, #{file => "antidote/src/clocksi_readitem.erl",
                             overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
