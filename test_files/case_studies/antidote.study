#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221: the 55 modules of the Antidote server and its three
%% headers. The code is unchanged; declarations (-type, -spec, -export_type, the types of record
%% fields) that were wrong or too imprecise are corrected, see the list below. 414 of the 722
%% functions have a spec in the source. overlay_antidote.erl gives a spec to each of the other 308,
%% and every module is checked with it, so that a call into another module of antidote is checked
%% against the spec of the callee. No flag, no assertion.
%%
%% The dependencies are case studies of their own in this directory, and the driver passes every
%% directory below this one that holds sources or headers to the engine. So all modules that
%% antidote calls are found: antidote_crdt, vectorclock, antidote_pb_codec, erlzmq, ranch and
%% riak_core (the package riak_core_lite; -include_lib("riak_core/include/riak_core_vnode.hrl") of
%% logging_vnode, materializer_vnode and inter_dc_log_sender_vnode resolves from this directory).
%% antidote_stats is only reached by messages (the macro ?STATS casts to its collector), poolboy
%% only through riak_core.
%%
%% A module that calls into a dependency also has the spec overlay of that dependency's own study
%% (category deps): the call is then checked against a spec where the source of the dependency has
%% none. That matters for riak_core, which has no spec for 16 of the 34 functions that antidote calls
%% (riak_core_vnode_master:sync_command/3,4, command/3,4 and get_vnode_pid/2, riak_core:register/1,
%% riak_core_status:ring_status/0, ...): 16 functions that type check without overlay_riak_core_lite.erl
%% fail with it, 15 of them because the reply of a vnode command is a term(). For antidote_crdt it is
%% one function (antidote_crdt_counter_b:generate_downstream_check/4, no change), for
%% antidote_pb_codec, erlzmq and ranch none: all functions that antidote calls there have a spec in
%% the source. No antidote module calls antidote_stats or poolboy, their overlays are not listed.
%%
%% The driver defines no macro. So the tests under -ifdef(TEST) are not checked, and meta_data_sender
%% takes the variant of -else for -ifdef(EUNIT): get_node_list/0 and get_node_and_partition_list/0.
%%
%% All 55 modules run: 470 functions type check, 252 do not. One of the 252 is a name error
%% (zmq_utils:connection_string/1 calls inet_parse:ntoa/1, which has no spec in OTP), none is an
%% internal error. The source of each of the 252 was read, no exception has the reason unknown.
%% 65 of them type check without the overlays, where the 308 functions without a spec are dynamic().
%%
%% Declarations corrected in the source: 82 in 28 modules and 2 headers, old -> new. Only -type,
%% -spec, -export_type and the types of record fields; no function body, clause head, guard or macro.
%% Where the overlay repeats a declaration of the source it follows (the state of clocksi_vnode and
%% its prepared transactions, the two orddicts of bcounter_mgr, the request add_dc of inter_dc_sub,
%% materialize_intern_perform/12 of clocksi_materializer, all_defined/1 of stable_time_functions).
%%
%% The type of a CRDT:
%%   antidote.hrl: type() atom() -> antidote_crdt:typ(), which every function of antidote_crdt takes.
%%     antidote_crdt has the type and exports it.
%%
%% Operations and effects. An update is {key(), type(), op()} with op() the pair {op_name(),
%% op_param()}; what is logged and applied is the downstream effect():
%%   antidote.hrl: field op of #update_log_payload{} op() -> effect(); it goes into
%%     #clocksi_payload.op_param :: effect().
%%   clocksi_downstream: generate_downstream_op/6 Update op_param() -> op() (antidote_crdt:downstream/3
%%     and require_state_downstream/2 take the pair), the write set list() -> [{key(), type(),
%%     effect()}], the error {error, atom()} -> {error, reason()} (it is {gen_downstream_read_failed,
%%     Reason} or the reason of antidote_crdt:downstream/3).
%%   antidote_hooks: execute_pre_commit_hook/3 and execute_post_commit_hook/3 op_param() -> op(), in
%%     the argument and in the result.
%%   clocksi_materializer: materialize_eager/3 [op()] -> [effect()], as the function of materializer.
%%
%% Lists and containers without the type of their elements:
%%   clocksi_interactive_coord: field updated_partitions of #state{} list() -> [{index_node(), [{key(),
%%     type(), effect()}]}], the write sets by partition; the transaction properties list() (of
%%     perform_singleitem_update/5), proplists:proplist() (init_state/3, start_tx_internal/3) and
%%     clocksi_readitem:read_property_list() (perform_singleitem_operation/4) -> txn_properties().
%%   cure: update_objects/3 list() -> txn_properties().
%%   clocksi_vnode: field prepared_dict of #state{}, get_min_prep/1 and get_time/2 list() ->
%%     orddict:orddict(clock_time(), txid()), the prepared transactions by prepare time.
%%   antidote_ets_txn_caches: get_prepared_txns_by_key/2 and get_prepared_txn_by_key_and_table/2
%%     list() -> [{txid(), clock_time()}].
%%   bcounter_mgr: fields of #state{}: req_queue orddict:orddict() -> orddict:orddict({key(),
%%     bucket()}, [{integer(), erlang:timestamp()}]), last_transfers orddict:orddict() ->
%%     orddict:orddict({{key(), bucket()}, dcid()}, erlang:timestamp()).
%%   inter_dc_repl.hrl: field queue of #inter_dc_sub_buf{} queue:queue() -> queue:queue(interdc_txn()).
%%   stable_meta_data_server: read_all_meta_data/0 [tuple()] and
%%     get_all_values_from_stable_meta_data_table/0 [term()] -> [{key(), term()}], the pairs of
%%     insert_meta_data/2.
%%   dc_utilities: bcast_vnode_sync/2 and bcast_my_vnode_sync/2 any() -> [{partition_id(), any()}];
%%     partition_to_indexnode/1 {partition_id(), any()} -> index_node().
%%   stable_time_functions: merge/1 map() -> #{term() => vectorclock:vectorclock() | undefined}; an
%%     entry that meta_data_sender:update/6 has just added is undefined.
%%   log_txn_assembler: find_or_default/3 (txid(), any(), dict:dict()) -> any() becomes (Key, Val,
%%     dict:dict(Key, Val)) -> Val; -export_type gets state/0 for inter_dc_log_sender_vnode.
%%   meta_data_sender: update/6 the entries [atom()] and the atom() of the two funs -> a type variable
%%     E: they are nodes for the remote meta data and partitions for the local ones.
%%
%% The state functions of the coordinator:
%%   clocksi_interactive_coord: execute_op/3, single_committing/3, execute_command/4, prepare/1 and
%%     prepare_done/2 gen_statem:event_handler_result(state()) ->
%%     gen_statem:event_handler_result(atom(), state()): the record is the data, not the type of the
%%     state name. single_committing/3 the event {committed | clock_time()} -> {committed,
%%     clock_time()}. start_tx_internal/3 the clock snapshot_time() -> snapshot_time() | ignore, and
%%     the result loses {error, any()}, which the function never gives and its caller does not take.
%%
%% Types that say something else than the code does:
%%   antidote.hrl: inter_dc_conn_err() {error, {partition_num_mismatch, _, _} | {error,
%%     connection_error}} -> {error, {partition_num_mismatch, _, _} | connection_error}.
%%   inter_dc_repl.hrl: fields of #descriptor{}: publishers [socket_address()] -> [[socket_address()]],
%%     logreaders [socket_address()] -> [{[partition_id()], [socket_address()]}]: per node of the DC
%%     what inter_dc_pub:get_address_list/0 and inter_dc_query_router:get_address_list/0 give. The same
%%     in inter_dc_manager:connect_nodes/6, inter_dc_sub:add_dc/2 and connect_to_nodes/2,
%%     inter_dc_query_dealer:add_dc/2.
%%   inter_dc_repl.hrl: field prev_log_opid of #interdc_txn{} op_number() | none -> op_number(), and so
%%     inter_dc_txn:from_ops/3 and ping/3. Nothing passes none (the comment of the field says a
%%     transaction read from the log has it; inter_dc_query_response builds an op_number() for those),
%%     and inter_dc_sub_buf and last_log_opid/1 use the field as an op_number().
%%   inter_dc_sub: field sockets of #state{} and del_dc/2 dict:dict(dcid(), zmq_socket()) ->
%%     dict:dict(dcid(), [zmq_socket()]), the sockets of a DC.
%%   antidote: validate_or_read_objects/3 {ok, {[term()], [object_token()]}} -> {ok, [valid | {invalid,
%%     term(), object_token()}]}, the result of cure:validate_or_read_objects/3. get_txn_property/2
%%     (atom(), txn_properties()) -> atom() becomes (update_clock, txn_properties()) -> update_clock |
%%     no_update_clock; (certify, txn_properties()) -> boolean().
%%   clocksi_materializer: is_op_in_snapshot/7 TxId txid() -> txid() | ignore, PrevTime and the third
%%     element of the result snapshot_time() -> snapshot_time() | ignore; materialize/4 MinSnapshotTime
%%     snapshot_time() | ignore -> snapshot_time() (it is a vectorclock for vectorclock:get/2).
%%   vector_orddict: get_smaller_from_id_internal/3 [{vectorclock, term()}, ...] -> [{vectorclock(),
%%     term()}]: the type and not the atom, and the first clause takes [].
%%   materializer_vnode: internal_read/7 {error, no_snapshot} -> {error, reason()}.
%%   logging_vnode: no_elements/2 boolean() -> boolean() | {error, no_log_for_preflist};
%%     get_op_numbers/1 [{log_id(), dcid(), op_number()} | {log_id(), bucket(), dcid(), op_number()}] ->
%%     [{{log_id(), dcid()} | {log_id(), bucket(), dcid()}, op_number()}]; the continuation
%%     disk_log:continuation() -> disk_log:continuation() | start in read_from_to_internal/6 (result),
%%     read_from_to_internal2/8 (LastContinuation and result), field last_read_map of #state{} and
%%     get_log_from_map/3.
%%   antidote_ets_meta_data: insert_remote_meta_data_new/3 true -> boolean() (ets:insert_new/2).
%%   antidote_pb_process: process/1 the result antidote_pb_codec:response() -> antidote_pb_codec:response_in().
%%     response() is the reply as a client decodes it; process/1 gives what antidote_pb_codec:encode_response/1
%%     takes, the objects that were read next to their values. from_bin/1 the clock binary() -> binary() |
%%     undefined: its case has a clause for undefined, and antidote_pb_codec:request() has a clock that can be
%%     undefined (a request without one).
%%   Named ets tables: stable_meta_data_server create_stable_meta_data_table/0, insert_meta_data/2 and
%%     get_all_values_by_table/1, meta_data_manager field table of #state{} ets:tid() -> ets:tab();
%%     antidote_ets_txn_caches get_prepared_cache_name/1 and get_cache_name/2 cache_id() -> atom(), the
%%     name that ets:new/2 takes.
%%
%% Types that say too little:
%%   inter_dc_repl.hrl: zmq_socket() any() -> erlzmq:erlzmq_socket().
%%   clocksi_readitem: async_read_data_item/6 and async_validate_or_read_data_item/7 the sender term()
%%     -> {fsm, pid()}.
%%   antidote_stats: fields of #state{}: timer any() -> reference(), timer_expensive any() -> undefined
%%     | reference().
%%   inter_dc_log_sender_vnode: fields of #state{}: buffer (no type) -> log_txn_assembler:state(),
%%     timer any() -> none | reference().
%%   inter_dc_query_dealer: field unanswered_queries of #state{} (no type) -> ets:tid().
%%   materializer_vnode: cache_table_fold/3 fun() -> fun((term(), term()) -> term()).
%%   zmq_context: init/1 [term()] -> [].
%%
%% Ranges of numbers:
%%   logging_vnode: start_vnode/1 integer() -> partition_id().
%%   vector_orddict: sublist/3 Start non_neg_integer() -> pos_integer() (lists:sublist/3).
%%   materializer_vnode: check_filter/7 Id and update_ops_element/3 the positions non_neg_integer() ->
%%     pos_integer() (element/2, ets:update_element/3).
%%   clocksi_materializer: the id of the last operation in the result of materialize/4, FirstHole and
%%     the result of materialize_intern/11 integer() -> non_neg_integer(); it becomes
%%     #materialized_snapshot.last_op_id :: op_num().
%%
%% Left as they are, although a declaration is the cause:
%%   clocksi_interactive_coord: the fields transaction, from and commit_time of #state{} say T |
%%     undefined (7 exceptions with record_undefined). init_state/3 builds the state with undefined in
%%     them and start_tx_internal/3 sets the transaction in the same callback, so the declaration is
%%     true. Without the undefined 4 more functions type check (wait_for_start_transaction/3,
%%     committing/3, prepare_done/2, abort/1) and init_state/3 fails (measured, not applied).
%%   antidote.hrl: the three fields of #op_number{} say T | undefined (3 exceptions), with a comment
%%     that inter_dc_log_sender_vnode needs it: its state starts with #op_number{}. Without the
%%     undefined logging_vnode:read_from_to_internal2/8 type checks and no function that type checks
%%     fails: inter_dc_log_sender_vnode:init/1, which builds #op_number{}, is an exception already
%%     (measured, not applied).
%%   clocksi_interactive_coord:execute_command/4, (atom(), term(), _, _): the type of the argument
%%     depends on the command. With one clause per command in the spec the function is not checked
%%     within the 10 s and execute_op/3, which passes a command and its argument on, fails (measured,
%%     not applied).
%%   dc_meta_data_utilities:get_env_meta_data/2 promises atom() for the value of a setting, which can
%%     be any term; logging_vnode:is_sync_log/0 gives it as its boolean(). It type checks if the
%%     promise is boolean() (measured, not applied: the function is not only for flags).

{study, antidote}.
{deps, ["antidote_crdt", "antidote_pb_codec", "erlzmq", "poolboy", "ranch", "riak_core", "vectorclock"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
%% The reason of an exception is the one of the first error that the checker reports for the function.
{reason, otp_no_spec,          fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, log_macro,            fixable,  "the ?LOG_ macros of logger.hrl end in erlang:apply(logger, macro_log, [..]), a term() for the checker and not the ok of that call: a function that gives the value of the macro as its result, or branches on it, fails"}.
{reason, free_result,          fixable,  "library spec whose type variables are bound only in when (rpc:call/4,5, application:get_env/2,3, ets:first/1, dets:sync/1, lists:foldl/3): any use of the result passes, a pattern or a branch on such a value is dead. The macro ?STATS of antidote.hrl is such a case on application:get_env/3"}.
{reason, dict_types,           fixable,  "key and value type of a dict:dict(K, V) are lost: the branches on a result of dict:find/2 or dict:fetch/2 and the patterns of a fun for dict:filter/2, dict:fold/3 or the pairs of dict:to_list/1 are dead"}.
{reason, map_types,            fixable,  "map types with more than one association or with mandatory associations are not supported: supervisor:sup_flags() and supervisor:child_spec() given as maps do not check"}.
{reason, bound_pattern,        fixable,  "a pattern with an already bound variable is not handled: the match counts as not exhaustive, a case clause whose pattern is the scrutinee variable as matching nothing"}.
{reason, narrowing,            fixable,  "a type test does not narrow: a filter X /= undefined in a comprehension, a case on is_binary(X) for its branches, X == undefined on the left of orelse for the right"}.
{reason, library_spec,         fixable,  "spec of a library function too imprecise"}.
{reason, body_exhaustiveness,  inherent, "exhaustiveness of a match or a case inside the body: the program lets it crash for the other values"}.
{reason, partial,              inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,            inherent, "defensive clause, dead for the spec"}.
{reason, nonempty_list,        inherent, "hd/1, lists:last/1 or a match with [H | _] on a list that the program knows is not empty"}.
{reason, number_range,         inherent, "range of a number (positive, not negative) that the types do not show"}.
{reason, bit_size,             fixable,  "a binary built with a segment of variable size is a bitstring() for the checker; that the size N * 8 makes whole bytes is arithmetic"}.
{reason, unchecked_result,     inherent, "a result that can be an error value, used as the success value"}.
{reason, untyped_value,        inherent, "term() from ets, disk_log, the stable meta data, element/2 of a tuple() or a container with term() values, used at the type the program expects"}.
{reason, call_reply,           inherent, "the reply of gen_server:call, gen_statem:call or a vnode command (riak_core_vnode_master:sync_command) is term(): the spec promises the type of the reply, or the body matches it"}.
{reason, message_term,         inherent, "the message of a process callback with a catch-all clause is term(), a clause uses its payload at the type the sender gives"}.
{reason, start_ret,            inherent, "result of starting a process, typed by the init function of the module: it gives neither ignore nor an error"}.
{reason, ets_new,              fixable,  "ets:new/2 gives a tid() when the table is not named"}.
{reason, correlated,           inherent, "the type of a value depends on another value (the op_type of a log operation for its payload, the CRDT type for its operation, the size kept next to a list, the state of a process for a field of its data, the result of a test in another function)"}.
{reason, deserialize,          inherent, "binary_to_term/1 gives term()"}.
{reason, record_undefined,     real,     "a record field declared T | undefined is used as T; the field is undefined at some time, so the declaration is true"}.
{reason, dep_spec,             real,     "imprecise type spec in the source of a dependency"}.
{reason, spec_misuse,          real,     "a function is used against its spec, without effect at run time"}.
{reason, spec_imprecise,       real,     "imprecise type spec in the source, of the function or of a function it calls, that a more precise one does not repair (see the header)"}.
{reason, source_bug,           real,     "error in the program"}.

{module, antidote, #{file => "antidote/src/antidote.erl",
                     overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
%% [Node] = log_utilities:get_preflist_from_key(..), a preflist of ?N = 1 nodes
{exception, antidote, get_log_operations_internal, 2, [ignore], body_exhaustiveness}.
%% lists:keyfind/3 gives tuple() | false, the case has {update_clock, ShouldUpdate}; behind it the list also has pairs {certify,
%% _}, which the key rules out
{exception, antidote, get_txn_property, 2, [ignore], library_spec}.

{module, antidote_app, #{file => "antidote/src/antidote_app.erl",
                         overlays => [{specs, "overlay_antidote.erl"},
                                      {deps, "overlay_riak_core_lite.erl"}],
                         timeout => 10000}}.
{exception, antidote_app, start, 2, [ignore], body_exhaustiveness}. % ok = logger:add_handler/3
%% {ok, DataDir} = application:get_env(antidote, data_dir)
{exception, antidote_app, validate_data_dir, 0, [ignore], body_exhaustiveness}.

{module, antidote_console, #{file => "antidote/src/antidote_console.erl",
                             overlays => [{specs, "overlay_antidote.erl"},
                                          {deps, "overlay_riak_core_lite.erl"}],
                             timeout => 10000}}.
%% the clause takes [NodeStr], the one argument of the console command
{exception, antidote_console, staged_join, 1, [ignore], partial}.
{exception, antidote_console, down, 1, [ignore], partial}. % the clause takes [Node], the one argument of the console command
%% riak_core_status:ringready/0 promises {error, any()}, the case has the two errors it gives
{exception, antidote_console, ringready, 1, [ignore], dep_spec}.

{module, antidote_dc_manager, #{file => "antidote/src/antidote_dc_manager.erl",
                                overlays => [{specs, "overlay_antidote.erl"},
                                             {deps, "overlay_riak_core_lite.erl"}],
                                timeout => 10000}}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, join_new_nodes, 1, [ignore], body_exhaustiveness}.
%% the first clause gives the value of ?LOG_WARNING as ok
{exception, antidote_dc_manager, plan_and_commit, 1, [ignore], log_macro}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, wait_until_ring_no_pending_changes, 0, [ignore], body_exhaustiveness}.
{exception, antidote_dc_manager, wait_until_ring_ready, 1, [ignore], free_result}. % case on rpc:call/4

{module, antidote_error_monitor, #{file => "antidote/src/antidote_error_monitor.erl",
                                   overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
{exception, antidote_error_monitor, log, 2, [ignore], free_result}. % ?STATS(..): the case of the macro on application:get_env/3

{module, antidote_ets_meta_data, #{file => "antidote/src/antidote_ets_meta_data.erl",
                                   overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{merged_data, Other}]
{exception, antidote_ets_meta_data, get_meta_data_sender_merged_data, 2, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_meta_data_as_map, 1, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_remote_meta_data_as_map, 1, [ignore], untyped_value}.

{module, antidote_ets_txn_caches, #{file => "antidote/src/antidote_ets_txn_caches.erl",
                                    overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{Key, List}]
{exception, antidote_ets_txn_caches, get_prepared_txn_by_key_and_table, 2, [ignore], untyped_value}.

{module, antidote_hooks, #{file => "antidote/src/antidote_hooks.erl",
                           overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as the hook {Module, Function}
{exception, antidote_hooks, get_hooks, 2, [ignore], untyped_value}.
%% the one clause takes {increment, 1} on an antidote_crdt_counter_pn: the example hook of the documentation
{exception, antidote_hooks, test_increment_hook, 1, [ignore], partial}.
{exception, antidote_hooks, test_post_hook, 1, [ignore], body_exhaustiveness}. % {ok, _CT} = antidote:update_objects/3

{module, antidote_node_event_handler, #{file => "antidote/src/antidote_node_event_handler.erl",
                                        overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.

{module, antidote_pb_process, #{file => "antidote/src/antidote_pb_process.erl",
                                overlays => [{specs, "overlay_antidote.erl"},
                                             {deps, "overlay_antidote_pb_codec.erl"}],
                                timeout => 10000}}.
{exception, antidote_pb_process, from_bin, 1, [ignore], deserialize}. % binary_to_term(Clock) for snapshot_time() | ignore | txid()
%% no clause for {validate_or_read_objects, _, _, _}, which antidote_pb_codec:request() has and the codec decodes
{exception, antidote_pb_process, process, 1, [ignore], source_bug}.

{module, antidote_pb_protocol, #{file => "antidote/src/antidote_pb_protocol.erl",
                                 overlays => [{specs, "overlay_antidote.erl"},
                                              {deps, "overlay_antidote_pb_codec.erl"},
                                              {deps, "overlay_ranch.erl"}],
                                 timeout => 10000}}.
%% {ok, Socket} = ranch:handshake(Ref), which can give {continue, _}
{exception, antidote_pb_protocol, init, 3, [ignore], body_exhaustiveness}.
%% io_lib:format/2 gives io_lib:chars(), a list of char(); iolist_to_binary/1 takes an iolist() of byte()
{exception, antidote_pb_protocol, handle, 3, [ignore], library_spec}.

{module, antidote_pb_sup, #{file => "antidote/src/antidote_pb_sup.erl",
                            overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_ranch.erl"}], timeout => 10000}}.
{exception, antidote_pb_sup, init, 1, [ignore], map_types}. % the supervisor flags as a map with three keys

{module, antidote_ring_event_handler, #{file => "antidote/src/antidote_ring_event_handler.erl",
                                        overlays => [{specs, "overlay_antidote.erl"},
                                                     {deps, "overlay_riak_core_lite.erl"}],
                                        timeout => 10000}}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, handle_event, 2, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, update_status, 0, [ignore], body_exhaustiveness}.

{module, antidote_stats, #{file => "antidote/src/antidote_stats.erl",
                           overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% erlang:cancel_timer(ExpensiveTimer): the field timer_expensive is undefined | reference(), undefined after the last tick,
%% when no message periodic_expensive_update comes anymore
{exception, antidote_stats, handle_info, 2, [ignore], correlated}.
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, antidote_stats, update_staleness, 0, [ignore], free_result}.
%% round/1 gives integer(); the staleness is not negative, the maximum of the fold starts at 0
{exception, antidote_stats, calculate_staleness, 0, [ignore], number_range}.
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, antidote_stats, update_dc_count, 0, [ignore], free_result}.
%% the filter ProcessInfo /= undefined does not narrow the result of erlang:process_info/1 for proplists:get_value/2
{exception, antidote_stats, update_processes_info, 1, [ignore], narrowing}.

{module, antidote_sup, #{file => "antidote/src/antidote_sup.erl",
                         overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% the child spec of antidote_pb_sup as a map with six keys, next to ten child specs that are tuples
{exception, antidote_sup, init, 1, [ignore], map_types}.

{module, antidote_warning_monitor, #{file => "antidote/src/antidote_warning_monitor.erl",
