%% from_ops/3: lists:last(Ops), the log records of a transaction end with its commit; commit = the op_type of the last record
%% (the sanity check of the source), and so its payload is matched as #commit_log_payload{}
{assertion, inter_dc_txn, {51, 25, "86bf06"}, assert_type, "[log_record(), ...]", nonempty_list}.
{assertion, inter_dc_txn, {54, 5, "e4e4cf"}, assert_pattern, "commit", body_exhaustiveness}.
{assertion, inter_dc_txn, {55, 5, "de4856"}, assert_pattern, "#commit_log_payload{commit_time = {_, _}, snapshot_time = _}", correlated}.
%% last_log_opid/1: lists:last(Ops), the log records of a transaction that is not a ping; commit = the op_type of the last
%% record (the sanity check of the source)
{assertion, inter_dc_txn, {83, 33, "86bf06"}, assert_type, "[log_record(), ...]", nonempty_list}.
{assertion, inter_dc_txn, {86, 13, "377430"}, assert_pattern, "commit", body_exhaustiveness}.
%% from_bin/1: binary_to_term(Msg), a term(), as the interdc_txn() that to_bin/1 packed
{assertion, inter_dc_txn, {111, 5, "f8fbdb"}, assert_type, "interdc_txn()", deserialize}.
%% pad/2: <<0:(N * 8), Binary/binary>> is a bitstring() for the checker, the spec promises binary()
{assertion, inter_dc_txn, {117, 14, "e1d7d4"}, assert_type, "binary()", bit_size}.
%% pad_or_trim/2: case Width - byte_size(Binary) of N when N == 0; N when N < 0; N: the difference counts as not negative, the
%% second clause as dead; the subject is annotated integer(). <<0:(N * 8), Binary/binary>> is a bitstring() for the checker, the
%% spec promises binary()
{assertion, inter_dc_txn, {125, 16, "665fd3"}, annotate_type, "integer()", guard_arith}.
{assertion, inter_dc_txn, {132, 13, "e1d7d4"}, assert_type, "binary()", bit_size}.

