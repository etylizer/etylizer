%% handle_handoff_data/2: {LogId, LogRecord} = binary_to_term(Data), a term(): the pair that encode_handoff_item/2 packed; {ok,
%% _OpId} = insert_log_record/4 and ok = disk_log:sync(Log)
{assertion, logging_vnode, {1133, 26, "7185d9"}, assert_type, "{log_id(), log_record()}", deserialize}.
{assertion, logging_vnode, {1137, 13, "568d6f"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, logging_vnode, {1138, 13, "566d30"}, assert_pattern, "ok", body_exhaustiveness}.
%% is_empty/1: the keys of the map of the logs, term() from dict:fetch_keys/1, are the log ids; case on no_elements/2 with true
%% and false: it gives {error, no_log_for_preflist} for a log id that is not in the map, here the ids are the keys of the map
{assertion, logging_vnode, {1146, 10, "e62c13"}, assert_type, "boolean()", body_exhaustiveness}.
{assertion, logging_vnode, {1146, 22, "1264a9"}, assert_type, "[log_id()]", dict_types}.
%% the field senders_awaiting_ack is declared dict:dict(log_id(), sender()), the clause for {sync, Log, LogId} takes a value of
%% it as a list of {Sender, OpId}. Nothing in the module puts an entry into the dict. The case on dets:sync/1 in front of it
%% type checks with the library overlay
{exception, logging_vnode, handle_info, 2, [ignore], spec_wrong}.
%% get_last_op_from_log/4 says log_id() for its first argument; it is the log that disk_log:open/1 gives, a term(), which it
%% hands to disk_log:sync/1 and disk_log:chunk/2. filename:join/2 in front of it type checks with the library overlay; behind it
%% {eof, NewMaxVector} = get_last_op_from_log(..)
{exception, logging_vnode, open_logs, 5, [ignore], spec_wrong}.
%% the spec of join_logs/3 says fun() for the fold fun, and so does the overlay spec of fold_log/4: lists:foldl/3 takes a fun of
%% two arguments. In front of it the case on disk_log:chunk/2 with eof and {Next, Ops}
{exception, logging_vnode, fold_log, 4, [ignore], source_bug}.
%% case ets:lookup(ClockTable, Key) of []; [{Key, Val}] with Key bound: with the result asserted as [] or one pair (ets:lookup/2
%% gives [tuple()]) the case counts as not exhaustive
{exception, logging_vnode, get_op_number, 2, [ignore], bound_pattern}.
%% get_op_numbers/1: ets:tab2list/1 gives [tuple()], the entries of the table are pairs {Key, OpNumber}
{assertion, logging_vnode, {1397, 5, "65861f"}, assert_type, "[{{log_id(), dcid()} | {log_id(), bucket(), dcid()}, op_number()}]", untyped_value}.
%% data_dir/0: value of application:get_env/2, a term(), as the directory name
{assertion, logging_vnode, {1405, 10, "473734"}, assert_type, "{ok, string()} | undefined", untyped_value}.

{module, materializer, #{file => "antidote/src/materializer.erl",
                         overlays => [{specs, "overlay_antidote.erl"},
                                      {deps, "overlay_antidote_crdt.erl"},
                                      {library, "overlay_riak_core_lite_lib.erl"},
                                      {library, "overlay_antidote_lib.erl"}],
                         timeout => 10000}}.

{module, materializer_vnode, #{file => "antidote/src/materializer_vnode.erl",
                               overlays => [{specs, "overlay_antidote.erl"},
                                            {deps, "overlay_riak_core_lite.erl"},
                                            {library, "overlay_riak_core_lite_lib.erl"},
                                            {library, "overlay_antidote_lib.erl"}],
                               timeout => 10000}}.
%% update/2: the reply of riak_core_vnode_master:sync_command/3 to {update, _, _}, a term(), is the result
{assertion, materializer_vnode, {148, 5, "a3e4a1"}, assert_type, "ok | {error, reason()}", call_reply}.
%% the clause takes [Partition] as riak_core_vnode passes it, a list type cannot say one element
{exception, materializer_vnode, init, 1, [no_exhaustiveness], partial}.
%% check_table_ready/1: case on the reply of riak_core_vnode_master:sync_command/4 to {check_ready}, a term(), with true and
%% false
{assertion, materializer_vnode, {198, 13, "d0bc91"}, assert_type, "boolean()", call_reply}.
%% the clause for {read, Key, Type, SnapshotTime, TxId} gives read/6 the state where it takes the partition; nothing in antidote
%% sends the request. In front of it the request is term() and hands its parts to read/6
{exception, materializer_vnode, handle_command, 3, [ignore], source_bug}.
%% [Key1 | _] = tuple_to_list(Key) in the fold fun F
{exception, materializer_vnode, handle_handoff_command, 3, [ignore], in_fun}.
%% handle_handoff_data/2: {_Key, Operation} = binary_to_term(Data), a term(): the entry of the operations cache that
%% encode_handoff_item/2 packed, a tuple() for insert_ops_cache_tuple/2
{assertion, materializer_vnode, {292, 25, "7185d9"}, assert_type, "{term(), tuple()}", deserialize}.
%% the spec promises true: the fun of dict:fold/3 gives the ok of lists:foreach/2, so the result is ok for a dict that is not
%% empty (the caller does not use it). Behind it the keys and values of the dict are term() for the fun
{exception, materializer_vnode, load_ops, 2, [ignore], spec_wrong}.
%% internal_store_ss/5: vector_orddict:first/1 gives {vectorclock(), term()}, the value is matched with #materialized_snapshot{}
%% and its last_op_id subtracted
{assertion, materializer_vnode, {399, 75, "4f94ee"}, assert_type, "{vectorclock(), materialized_snapshot()}", untyped_value}.
%% get_from_snapshot_cache/5: vector_orddict:get_smaller/2 gives {undefined | {vectorclock(), term()}, boolean()},
%% update_snapshot_from_cache/3 takes a snapshot time and a materialized_snapshot(); the clause {undefined, _} in front does not
%% narrow it either
{assertion, materializer_vnode, {511, 48, "6c01fc"}, assert_type, "{{snapshot_time(), materialized_snapshot()}, boolean()}", untyped_value}.
%% get_from_snapshot_log/3: logging_vnode:get_up_to_time/5 gives snapshot_get_response() | {error, reason()}, the spec promises
%% the response
{assertion, materializer_vnode, {519, 5, "255c36"}, assert_type, "snapshot_get_response()", spec_wrong}. % get_from_snapshot_log/3 passes {error, Reason} of logging_vnode:get_up_to_time/5 on as the response (read: needs a vnode)
%% {Key, Length, OpId, ListLen, OpsDict} = case .. end with Key bound by the head
{exception, materializer_vnode, snapshot_insert_gc, 4, [ignore], bound_pattern}.
%% prune_ops/2: ?FIRST_OP + Len with Len a non_neg_integer() is the position for element/2, a pos_integer(); element/2 of a
%% tuple() gives term(), the first operation goes into the result as op_and_id()
{assertion, materializer_vnode, {711, 21, "e7295a"}, assert_type, "op_and_id()", untyped_value}.
{assertion, materializer_vnode, {711, 39, "9bfb33"}, assert_type, "pos_integer()", arith_pos}.
%% check_filter/7: element/2 of a tuple() gives term(), the filter fun takes the operation as {non_neg_integer(),
%% clocksi_payload()}; Id + 1 for the position Id, a pos_integer(), is the next position
{assertion, materializer_vnode, {735, 10, "8bf4e3"}, assert_type, "op_and_id()", untyped_value}.
{assertion, materializer_vnode, {738, 34, "4bb557"}, assert_type, "pos_integer()", arith_pos}.
{assertion, materializer_vnode, {740, 34, "4bb557"}, assert_type, "pos_integer()", arith_pos}.
%% deconstruct_opscache_entry/1: {Length, ListLen} = element(2, Tuple) and OpId = element(3, Tuple) for a tuple(): element/2
%% gives term()
{assertion, materializer_vnode, {753, 25, "c12e29"}, assert_type, "{non_neg_integer(), non_neg_integer()}", untyped_value}.
{assertion, materializer_vnode, {754, 12, "635afe"}, assert_type, "non_neg_integer()", untyped_value}.
%% op_insert_gc/3: NewLength + ?FIRST_OP and Length + ?FIRST_OP with a non_neg_integer() length are positions for
%% update_ops_element/3, pos_integer(); true = update_ops_element/3, which promises boolean()
{assertion, materializer_vnode, {786, 13, "11ee57"}, assert_pattern, "true", body_exhaustiveness}.
{assertion, materializer_vnode, {787, 28, "be81c8"}, assert_type, "pos_integer()", arith_pos}.
{assertion, materializer_vnode, {790, 13, "e25f91"}, assert_pattern, "true", body_exhaustiveness}.
{assertion, materializer_vnode, {791, 25, "702783"}, assert_type, "pos_integer()", arith_pos}.
%% case ets:lookup(SnapshotCache, Key) of []; [{Key, SnapshotDictA}] with Key bound: with the result asserted as [] or one pair
%% (ets:lookup/2 gives [tuple()]) the case counts as not exhaustive
{exception, materializer_vnode, get_snapshot_dict, 2, [ignore], bound_pattern}.
%% get_ops_from_cache/2: case on ets:lookup/2, which gives [tuple()], with [] and [Tuple]: the table is a set with at most one
%% object for a key
{assertion, materializer_vnode, {885, 10, "7a4c15"}, assert_type, "[] | etylizer:cons(tuple(), [])", untyped_value}.
%% increment_op_id/2: ets:update_counter/3 gives integer(), the spec promises non_neg_integer()
{assertion, materializer_vnode, {898, 5, "d66ad6"}, assert_type, "non_neg_integer()", number_range}.
%% ets:lookup_element/3 gives term(), the spec promises the pair of the lengths; the call at 902:5 (hash 0dc36c) is the body of
%% the function and crashes the engine with an assertion
{exception, materializer_vnode, get_op_list_length, 2, [ignore], assertion_crash}.

{module, meta_data_manager, #{file => "antidote/src/meta_data_manager.erl",
