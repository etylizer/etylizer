{assertion, antidote_stats, {185, 52, "fcb3f2"}, assert_type, "[{atom(), term()}]", narrowing}.
{assertion, antidote_stats, {186, 45, "fcb3f2"}, assert_type, "[{atom(), term()}]", narrowing}.
