%% ?LOG_RECORD_VERSION = LogRecord#log_record.version, the check of the version
{exception, log_utilities, check_log_record_version, 1, [ignore], body_exhaustiveness}.

{module, logging_vnode, #{file => "antidote/src/logging_vnode.erl",
                          overlays => [{specs, "overlay_antidote.erl"},
                                       {deps, "overlay_riak_core_lite.erl"}],
                          timeout => 10000}}.
%% the spec says integer() for the partition, riak_core_vnode_master:get_vnode_pid/2 takes a partition(), which is not negative
{exception, logging_vnode, start_vnode, 1, [ignore], spec_imprecise}.
{exception, logging_vnode, read_from_to, 4, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/3
{exception, logging_vnode, read, 2, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/3
{exception, logging_vnode, append, 3, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, append_commit, 3, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, append_group, 4, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
%% riak_core_vnode_master:command/4 takes (Dest, Request, Sender, VMaster): the call has ?LOGGING_MASTER as the sender and
%% infinity as the master, the arguments of sync_command/4. No caller in antidote
{exception, logging_vnode, asyn_append_group, 4, [ignore], source_bug}.
{exception, logging_vnode, get_up_to_time, 5, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, get_from_time, 5, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, get_range, 6, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, get_all, 4, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, request_op_id, 3, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
{exception, logging_vnode, request_bucket_op_id, 4, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/4
%% dc_meta_data_utilities:get_env_meta_data/2 promises atom(), the setting sync_log is a boolean()
{exception, logging_vnode, is_sync_log, 0, [ignore], spec_imprecise}.
%% the clause takes [Partition] as riak_core_vnode passes it, a list type cannot say one element
{exception, logging_vnode, init, 1, [ignore], partial}.
%% the request is term(): {get_op_id, DCID, Partition} hands its parts to get_op_id/2
{exception, logging_vnode, handle_command, 3, [ignore], message_term}.
%% the terms of disk_log:chunk/2 are [term()], used as [{non_neg_integer(), clocksi_payload()}]
{exception, logging_vnode, read_internal, 3, [ignore], untyped_value}.
%% read_from_to_internal2/8 says disk_log:continuation() for the last continuation, which can be start
{exception, logging_vnode, read_from_to_internal, 6, [ignore], spec_imprecise}.
%% NewLastLOpId + 1 with #op_number.local, which is undefined | non_neg_integer()
{exception, logging_vnode, read_from_to_internal2, 8, [ignore], record_undefined}.
{exception, logging_vnode, get_last_op_from_log, 4, [ignore], body_exhaustiveness}. % ok = disk_log:sync(Log)
%% #op_number{node = {_, DCID}} = NewBucketOp, the field node is undefined | {node(), dcid()}
{exception, logging_vnode, get_max_op_numbers, 3, [ignore], record_undefined}.
%% the terms of disk_log:chunk/2 are [term()], filter_terms_for_key/6 takes [{non_neg_integer(), log_record()}]
{exception, logging_vnode, get_ops_from_log, 8, [ignore], untyped_value}.
%% the payload of an operation with op_type update goes to handle_update/8 as update_log_payload(), the field log_payload is
%% any_log_payload()
{exception, logging_vnode, filter_terms_for_key, 6, [ignore], correlated}.
{exception, logging_vnode, handle_commit, 8, [ignore], dict_types}. % case on dict:find/2
%% MinSnapshotTime == undefined on the left of orelse does not narrow it for vectorclock:ge/2 on the right
{exception, logging_vnode, check_min_time, 2, [ignore], narrowing}.
%% MaxSnapshotTime == undefined on the left of orelse does not narrow it for vectorclock:le/2 on the right
{exception, logging_vnode, check_max_time, 2, [ignore], narrowing}.
%% the request is term(): the fold fun out of #riak_core_fold_req_v2{} is applied
{exception, logging_vnode, handle_handoff_command, 3, [ignore], message_term}.
{exception, logging_vnode, handle_handoff_data, 2, [ignore], deserialize}. % {LogId, LogRecord} = binary_to_term(Data)
%% filename:join/2 gives file:filename_all(), which has binary(); LogPath ++ ".LOG" takes a list
{exception, logging_vnode, delete, 1, [ignore], library_spec}.
%% case on dets:sync/1, the reason of its error is a type variable
{exception, logging_vnode, handle_info, 2, [ignore], free_result}.
%% promises boolean(), gives {error, no_log_for_preflist} for a log that is not in the map (is_empty/1 has no clause for it)
{exception, logging_vnode, no_elements, 2, [ignore], spec_wrong}.
%% filename:join/2 gives file:filename_all(), which has binary(); LogPath ++ ".LOG" takes a list
{exception, logging_vnode, open_logs, 5, [ignore], library_spec}.
{exception, logging_vnode, get_log_from_map, 3, [ignore], dict_types}. % case on dict:find/2
{exception, logging_vnode, fold_log, 4, [ignore], body_exhaustiveness}. % case on disk_log:chunk/2 with eof and {Next, Ops}
%% ?STATS(..): the case of the macro on application:get_env/3
{exception, logging_vnode, insert_log_record, 4, [ignore], free_result}.
{exception, logging_vnode, get_op_number, 2, [ignore], untyped_value}. % case on ets:lookup/2 with [] and [{Key, Val}]
%% ets:tab2list/1 gives [tuple()]; the spec also flattens the entries {Key, OpNumber} into triples and quadruples
{exception, logging_vnode, get_op_numbers, 1, [ignore], untyped_value}.
{exception, logging_vnode, data_dir, 0, [ignore], free_result}. % case on application:get_env/2

{module, materializer, #{file => "antidote/src/materializer.erl",
                         overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, materializer, create_snapshot, 1, [ignore], crdt_type}. % antidote_crdt:new(Type)
{exception, materializer, update_snapshot, 3, [ignore], crdt_type}. % antidote_crdt:update(Type, Op, Snapshot)
{exception, materializer, check_operation, 1, [ignore], crdt_type}. % antidote_crdt:is_operation(Type, Update)

{module, materializer_vnode, #{file => "antidote/src/materializer_vnode.erl",
                               overlays => [{specs, "overlay_antidote.erl"},
                                            {deps, "overlay_riak_core_lite.erl"}],
                               timeout => 10000}}.
{exception, materializer_vnode, update, 2, [ignore], call_reply}. % reply of riak_core_vnode_master:sync_command/3
%% the clause takes [Partition] as riak_core_vnode passes it, a list type cannot say one element
{exception, materializer_vnode, init, 1, [ignore], partial}.
%% case on the reply of riak_core_vnode_master:sync_command/4 with true and false
{exception, materializer_vnode, check_table_ready, 1, [ignore], call_reply}.
%% the request is term(): {read, Key, Type, SnapshotTime, TxId} hands its parts to read/6. That clause also gives read/6 the
%% state where it takes the partition; nothing in antidote sends the request
{exception, materializer_vnode, handle_command, 3, [ignore], message_term}.
%% [Key1 | _] = tuple_to_list(Key) in the fold fun
{exception, materializer_vnode, handle_handoff_command, 3, [ignore], nonempty_list}.
{exception, materializer_vnode, handle_handoff_data, 2, [ignore], deserialize}. % {_Key, Operation} = binary_to_term(Data)
%% the fun of dict:fold/3: the patterns on the values of the dict are dead
{exception, materializer_vnode, load_ops, 2, [ignore], dict_types}.
%% vector_orddict:first/1 gives {vectorclock(), term()}, matched with #materialized_snapshot{}
{exception, materializer_vnode, internal_store_ss, 5, [ignore], untyped_value}.
%% promises {error, no_snapshot}, materialize_snapshot/7 gives {error, term()}: the reason of clocksi_materializer:materialize/4
{exception, materializer_vnode, internal_read, 7, [ignore], spec_wrong}.
%% vector_orddict:get_smaller/2 gives {undefined | {vectorclock(), term()}, boolean()}, update_snapshot_from_cache/3 takes a
%% materialized_snapshot(); the clause {undefined, _} does not narrow it either
{exception, materializer_vnode, get_from_snapshot_cache, 5, [ignore], untyped_value}.
%% logging_vnode:get_up_to_time/5 gives snapshot_get_response() | {error, reason()}, the spec promises the response
{exception, materializer_vnode, get_from_snapshot_log, 3, [ignore], unchecked_result}.
%% clocksi_materializer:materialize/4 promises integer() for the last op id, the field last_op_id of #materialized_snapshot{} is
%% not negative
{exception, materializer_vnode, materialize_snapshot, 7, [ignore], spec_imprecise}.
%% {Key, Length, OpId, ListLen, OpsDict} = case .. end with Key bound by the head
{exception, materializer_vnode, snapshot_insert_gc, 4, [ignore], bound_pattern}.
%% ?FIRST_OP + Len is an integer(), element/2 takes a pos_integer()
{exception, materializer_vnode, prune_ops, 2, [ignore], number_range}.
%% the spec says non_neg_integer() for Id, element/2 takes a pos_integer()
{exception, materializer_vnode, check_filter, 7, [ignore], spec_imprecise}.
%% {Length, ListLen} = element(2, Tuple) for a tuple()
{exception, materializer_vnode, deconstruct_opscache_entry, 1, [ignore], untyped_value}.
%% true = update_ops_element/3, which promises boolean()
{exception, materializer_vnode, op_insert_gc, 3, [ignore], body_exhaustiveness}.
%% the spec says fun() for the fold function, ets:foldl/3 takes a fun of two arguments
{exception, materializer_vnode, cache_table_fold, 3, [ignore], spec_imprecise}.
{exception, materializer_vnode, cache_is_empty, 1, [ignore], free_result}. % case on ets:first/1
%% case on ets:lookup/2 with [] and [{Key, SnapshotDictA}]
{exception, materializer_vnode, get_snapshot_dict, 2, [ignore], untyped_value}.
{exception, materializer_vnode, get_ops_from_cache, 2, [ignore], untyped_value}. % case on ets:lookup/2 with [] and [Tuple]
%% ets:update_counter/3 gives integer(), the spec promises non_neg_integer()
{exception, materializer_vnode, increment_op_id, 2, [ignore], number_range}.
{exception, materializer_vnode, get_op_list_length, 2, [ignore], untyped_value}. % ets:lookup_element/3 gives term()
%% the spec says non_neg_integer() for the positions, ets:update_element/3 takes pos_integer()
{exception, materializer_vnode, update_ops_element, 3, [ignore], spec_imprecise}.

{module, meta_data_manager, #{file => "antidote/src/meta_data_manager.erl",
                              overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% the spec says [term()], the clause takes [Name] as start_link/1 passes it
{exception, meta_data_manager, init, 1, [ignore], partial}.
%% the message is term(): {send_meta_data, NodeId, Data} hands NodeId to antidote_ets_meta_data:insert_remote_meta_data/3 as an
%% atom()
{exception, meta_data_manager, handle_cast, 2, [ignore], message_term}.

{module, meta_data_manager_sup, #{file => "antidote/src/meta_data_manager_sup.erl",
                                  overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.

{module, meta_data_sender, #{file => "antidote/src/meta_data_sender.erl",
                             overlays => [{specs, "overlay_antidote.erl"},
                                          {deps, "overlay_riak_core_lite.erl"}],
                             timeout => 10000}}.
{exception, meta_data_sender, start, 1, [ignore], call_reply}. % reply of gen_statem:call/2
%% the spec says [term()], the clause takes [Name] as start_link/1 passes it
{exception, meta_data_sender, init, 1, [ignore], partial}.
%% {WillChange, Data} = get_merged_meta_data(Name, CheckNodes), which can give not_ready
{exception, meta_data_sender, send_meta_data, 3, [ignore], body_exhaustiveness}.
%% the fun of lists:foldl/3: its case on maps:find/2 has a dead branch
{exception, meta_data_sender, update, 6, [ignore], free_result}.
%% update/6 says [atom()] for the entries, here they are the partitions; fun put_meta/3 takes a partition_id()
{exception, meta_data_sender, get_merged_meta_data, 2, [ignore], spec_wrong}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, meta_data_sender, get_node_list, 0, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, meta_data_sender, get_node_and_partition_list, 0, [ignore], body_exhaustiveness}.

{module, meta_data_sender_sup, #{file => "antidote/src/meta_data_sender_sup.erl",
                                 overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.

{module, stable_meta_data_server, #{file => "antidote/src/stable_meta_data_server.erl",
                                    overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% promises [tuple()], get_all_values_from_stable_meta_data_table/0 promises [term()]
{exception, stable_meta_data_server, read_all_meta_data, 0, [ignore], spec_imprecise}.
{exception, stable_meta_data_server, sync_meta_data, 0, [ignore], call_reply}. % ok = gen_server:call/2
{exception, stable_meta_data_server, broadcast_meta_data_list, 1, [ignore], call_reply}. % ok = gen_server:call/2
{exception, stable_meta_data_server, broadcast_meta_data_internal, 3, [ignore], call_reply}. % ok = gen_server:call/2
{exception, stable_meta_data_server, broadcast_meta_data_merge, 4, [ignore], call_reply}. % ok = gen_server:call/2
%% {ok, DataDir} = application:get_env(antidote, data_dir)
{exception, stable_meta_data_server, init, 1, [ignore], body_exhaustiveness}.
%% the request is term(): case IsEnv of true; false for {update_meta_data, KeyValueList, IsEnv}
{exception, stable_meta_data_server, handle_call, 3, [ignore], message_term}.
%% promises ets:tid(), ets:new/2 with named_table gives the name
{exception, stable_meta_data_server, create_stable_meta_data_table, 0, [ignore], spec_wrong}.
%% case on ets:lookup/2 with [] and [{Key, Value}]
{exception, stable_meta_data_server, get_value_by_table, 2, [ignore], untyped_value}.

{module, stable_time_functions, #{file => "antidote/src/stable_time_functions.erl",
                                  overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
{exception, stable_time_functions, update, 2, [ignore], defensive}. % case Last of undefined, Last is an integer()
%% the spec says map(), vectorclock:min/1 takes its values as [vectorclock()]
{exception, stable_time_functions, merge, 1, [ignore], spec_imprecise}.

{module, vector_orddict, #{file => "antidote/src/vector_orddict.erl",
                           overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
%% get_smaller_from_id_internal/3 says [{vectorclock, term()}, ...]: the atom vectorclock for the type, and a non-empty list
%% although its first clause takes []
{exception, vector_orddict, get_smaller_from_id, 3, [ignore], spec_wrong}.
%% the spec says the atom vectorclock for the clock, vectorclock:get/2 takes a vectorclock()
{exception, vector_orddict, get_smaller_from_id_internal, 3, [ignore], spec_wrong}.
%% the clauses take [] with size 0 and a non-empty list: the size is 0 exactly for the empty list
{exception, vector_orddict, insert_bigger_internal, 4, [ignore], correlated}.
%% the spec says non_neg_integer() for Start, lists:sublist/3 takes a pos_integer()
{exception, vector_orddict, sublist, 3, [ignore], spec_imprecise}.
%% no clause for the empty vector_orddict(); the one caller checks the size before
{exception, vector_orddict, first, 1, [ignore], partial}.
%% lists:last/1 on the list of a vector_orddict(), which can be empty; no caller in antidote
{exception, vector_orddict, last, 1, [ignore], partial}.

{module, wait_init, #{file => "antidote/src/wait_init.erl", overlays => [{specs, "overlay_antidote.erl"}], timeout => 10000}}.
{exception, wait_init, check_ready, 1, [ignore], free_result}. % case on rpc:call/4

