%% try_store/2: {ok, _} = logging_vnode:append_group/4
{assertion, inter_dc_dep_vnode, {162, 13, "a60ffb"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{exception, inter_dc_dep_vnode, push_txn, 2, [ignore], bound_pattern}. % DCID = Txn#interdc_txn.dcid with DCID bound by the head
%% pop_txn/2: the value of dict:fetch/2 is term(), queue:drop/1 takes a queue (the assertion is on the variable, on the call it
%% crashes the engine)
{assertion, inter_dc_dep_vnode, {224, 27, "ee1127"}, assert_type, "queue:queue(interdc_txn())", dict_types}.
%% #update_log_payload{} = LogRecord#log_operation.log_payload in the fun of lists:map/2: inter_dc_txn:ops_by_type(Txn, update)
%% gives the operations with op_type update as [log_record()], with any_log_payload()
{exception, inter_dc_dep_vnode, updates_to_clocksi_payloads, 1, [ignore], in_fun}.

