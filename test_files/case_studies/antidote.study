%% case Length of 0; Length: the second pattern is the scrutinee, the case counts as not exhaustive. In front of it {Length,
%% _ListLen} = element(2, Tuple) for a tuple(), behind it {Id, _Op} = element(.., Tuple)
{exception, clocksi_materializer, get_first_id, 1, [ignore], bound_pattern}.
%% materialize_intern/11: {Length, _ListLen} = element(2, TupleOps) and the operation element(.., TupleOps) for a tuple():
%% element/2 gives term(); its position (?FIRST_OP + Length - 1) - Location is an integer(), element/2 takes a pos_integer()
{assertion, clocksi_materializer, {234, 26, "850d46"}, assert_type, "{non_neg_integer(), non_neg_integer()}", untyped_value}.
{assertion, clocksi_materializer, {246, 17, "5f4f22"}, assert_type, "{integer(), clocksi_payload()}", untyped_value}.
{assertion, clocksi_materializer, {246, 50, "7b8b7a"}, assert_type, "pos_integer()", number_range}.
%% materialize_intern_perform/12: OpId - 1 is an integer(), the first hole is the id of an operation and not negative
{assertion, clocksi_materializer, {287, 60, "5114a5"}, assert_type, "non_neg_integer()", number_range}.

{module, clocksi_readitem, #{file => "antidote/src/clocksi_readitem.erl",
