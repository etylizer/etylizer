%% get_address/0: [_, Hostname] = string:tokens/2 of the node name; {ok, List} = inet:getif() and hd(List), the node has an
%% interface; the value of application:get_env/3, a term(), is the port number
{assertion, inter_dc_query_router, {71, 5, "c9de2b"}, assert_pattern, "[_, _]", body_exhaustiveness}.
{assertion, inter_dc_query_router, {79, 17, "e1a26e"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, inter_dc_query_router, {80, 34, "74ec78"}, assert_type, "[{inet:ip_address(), inet:ip_address() | undefined, inet:ip_address()}, ...]", nonempty_list}.
{assertion, inter_dc_query_router, {83, 12, "32ef36"}, assert_type, "inet:port_number()", untyped_value}.
%% get_address_list/0: {ok, List} = inet:getif(); [_, Hostname] = string:tokens/2 of the node name; the value of
%% application:get_env/3, a term(), is the port number
{assertion, inter_dc_query_router, {89, 5, "e1a26e"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, inter_dc_query_router, {92, 5, "c9de2b"}, assert_pattern, "[_, _]", body_exhaustiveness}.
{assertion, inter_dc_query_router, {98, 12, "32ef36"}, assert_type, "inet:port_number()", untyped_value}.
%% handle_info/2: the message is term(): BinaryMsg of {zmq, Socket, BinaryMsg, _} goes to
%% inter_dc_utils:check_version_and_req_id/1 and Socket to finish_send_response/4 as a zmq_socket(); the field id of the state
%% has no type, it is the binary that the first message of a request brings
{assertion, inter_dc_query_router, {128, 64, "b8948e"}, assert_type, "<<_:32, _:_*8>>", message_term}.
{assertion, inter_dc_query_router, {143, 52, "9b7137"}, assert_type, "binary()", untyped_value}.
{assertion, inter_dc_query_router, {143, 63, "f1bb56"}, assert_type, "zmq_socket()", message_term}.
{assertion, inter_dc_query_router, {151, 75, "9b7137"}, assert_type, "binary()", untyped_value}.
{assertion, inter_dc_query_router, {151, 86, "f1bb56"}, assert_type, "zmq_socket()", message_term}.
%% the message is term(): the request type of {send_response, BinaryResponse, #inter_dc_query_state{}} goes into the binary
%% <<ReqType, BinaryResponse/binary>> as an integer; the variable ReqType at 171:28 (hash 04edf6) crashes the engine with an
%% assertion. The response, the zmq id and the request id take assert_type binary()
{exception, inter_dc_query_router, handle_cast, 2, [ignore], assertion_crash}.
%% finish_send_response/4: ok = erlzmq:send/3
{assertion, inter_dc_query_router, {186, 5, "ee50dd"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, inter_dc_query_router, {187, 5, "f3d469"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, inter_dc_query_router, {188, 5, "4c8c06"}, assert_pattern, "ok", body_exhaustiveness}.
%% get_router_bind_ip/0: value of application:get_env/3, a term(), as the address string
{assertion, inter_dc_query_router, {192, 5, "bdebfe"}, assert_type, "string()", untyped_value}.

