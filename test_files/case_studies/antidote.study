{assertion, clocksi_downstream, {72, 67, "161c33"}, assert_type, "overlay_antidote:bcounter()", correlated}.

{module, clocksi_interactive_coord, #{file => "antidote/src/clocksi_interactive_coord.erl",
                                      overlays => [{specs, "overlay_antidote.erl"},
                                                   {library, "overlay_riak_core_lite_lib.erl"},
                                                   {library, "overlay_antidote_lib.erl"}],
                                      timeout => 10000}}.
%% start_link/0: promises {ok, pid()}, gen_statem:start_link/3 gives gen_statem:start_ret(): the init function of the module
%% gives neither ignore nor an error
{assertion, clocksi_interactive_coord, {82, 5, "ec0cbb"}, assert_type, "{ok, pid()}", start_ret}.
%% perform_singleitem_operation/4: hd(Preflist) of log_utilities:get_preflist_from_key/1, a preflist of one node
{assertion, clocksi_interactive_coord, {99, 16, "8cc281"}, assert_type, "[index_node(), ...]", nonempty_list}.
%% case on antidote_hooks:execute_pre_commit_hook/3 with {Key, Type, Params1}, Key and Type bound by the head
{exception, clocksi_interactive_coord, perform_singleitem_update, 5, [ignore], bound_pattern}.
%% (State#state.transaction)#transaction.txn_id, the field transaction is undefined | tx()
{exception, clocksi_interactive_coord, wait_for_start_transaction, 3, [ignore], record_undefined}.
%% receive_prepared/3: the clause for info hands the value of the message, any(), to the clause for cast, which takes {prepared,
%% Time}, abort or timeout
{assertion, clocksi_interactive_coord, {277, 28, "3ce9b5"}, assert_type, "{prepared, clock_time()} | abort | timeout", message_term}.
%% the field transaction is undefined | tx(), clocksi_vnode:commit/3 takes a tx(); the field commit_time is undefined |
%% clock_time() as well
{exception, clocksi_interactive_coord, committing, 3, [ignore], record_undefined}.
%% {reply, From, {ok, CommitTime}} with the field from, undefined | gen_statem:from(); behind it the clause for info hands the
%% value of the message, any(), to the clause for cast
{exception, clocksi_interactive_coord, single_committing, 3, [ignore], record_undefined}.
%% {reply, CoordState#state.from, {ok, _}} with the field from, undefined | gen_statem:from(). In front of it the field
%% return_accumulator is list() | ok | {error, reason()}; while the reads come in it is the list that replace_first/3 takes, and
%% replace_first/3 can give error: with both asserted as list() the function still fails against the clause of its spec for cast
{exception, clocksi_interactive_coord, receive_read_objects_result, 3, [ignore], record_undefined}.
%% {reply, CoordState#state.from, {ok, _}} with the field from, undefined | gen_statem:from(). In front of it the field
%% return_accumulator is list() | ok | {error, reason()}; while the reads come in it is the list that replace_first/3 takes (not
%% tried with assertions, the function is as receive_read_objects_result/3)
{exception, clocksi_interactive_coord, receive_validate_or_read_objects_result, 3, [ignore], record_undefined}.
%% {reply, State#state.from, NewAcc}, the field from is undefined | gen_statem:from(); behind it the clause for info as in
%% receive_prepared/3
{exception, clocksi_interactive_coord, receive_logging_responses, 3, [ignore], record_undefined}.
%% receive_committed/3: the clause for info hands the value of the message, any(), to the clause for cast, which takes committed
{assertion, clocksi_interactive_coord, {518, 29, "3ce9b5"}, assert_type, "committed", message_term}.
%% the spec says atom() and term() for the command and its argument, the clauses take seven commands, four of them with a tuple
{exception, clocksi_interactive_coord, execute_command, 4, [ignore], source_bug}.
%% Transaction#transaction.txn_id, the field transaction is undefined | tx()
{exception, clocksi_interactive_coord, reply_to_client, 1, [ignore], record_undefined}.
%% case lists:keyfind(Partition, 1, ..) of false; {Partition, WS} with Partition bound: the case counts as not exhaustive
{exception, clocksi_interactive_coord, apply_tx_updates_to_snapshot, 4, [ignore], bound_pattern}.
%% replace_first/3: [NotMyKey | replace_first(..)]: the rest is error when the key is not in the list; the callers put every key
%% there first
{assertion, clocksi_interactive_coord, {869, 17, "9c79a0"}, assert_type, "list()", unchecked_result}.
%% case lists:keyfind(Partition, 1, UpdatedPartitions) of false; {Partition, WS} with Partition bound: the case counts as not
%% exhaustive
{exception, clocksi_interactive_coord, perform_read, 4, [ignore], bound_pattern}.
%% case lists:keyfind(Partition, 1, UpdatedPartitions) of false; {Partition, WS} with Partition bound: the case counts as not
%% exhaustive
{exception, clocksi_interactive_coord, perform_validate_or_read, 4, [ignore], bound_pattern}.
%% case lists:keyfind(Partition, 1, UpdatedPartitions) of false; {Partition, WS} with Partition bound: the case counts as not
%% exhaustive
{exception, clocksi_interactive_coord, perform_update, 5, [ignore], bound_pattern}.
%% Transaction = State#state.transaction with Transaction bound by the head; behind it the field is undefined | tx()
{exception, clocksi_interactive_coord, prepare, 1, [ignore], bound_pattern}.
%% the field transaction is undefined | tx(), clocksi_vnode:single_commit/2 and commit/3 take a tx()
{exception, clocksi_interactive_coord, prepare_done, 2, [ignore], record_undefined}.
%% max(PrepareTime, ReceivedPrepareTime) with the field prepare_time, undefined | clock_time(): prepare_done/2 takes a
%% clock_time(). It type checked before step IV because max/2 of OTP gives a type variable that is bound only in when; with the
%% library overlay the result is the type of one of the arguments
{exception, clocksi_interactive_coord, process_prepared, 2, [ignore], record_undefined}.
%% the field transaction is undefined | tx(), clocksi_vnode:abort/2 takes a tx()
{exception, clocksi_interactive_coord, abort, 1, [ignore], record_undefined}.

