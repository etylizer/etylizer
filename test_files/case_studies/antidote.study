#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% apps/antidote (src, include) of https://github.com/AntidoteDB/antidote as of commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221, unchanged: the 55 modules of the Antidote server and
%% its three headers. This is the raw result: no overlay, no flag, no assertion. 414 of the 722
%% functions have a spec in the source, the other 308 are checked with dynamic() arguments and
%% result.
%%
%% The dependencies are case studies of their own in this directory, and the driver passes every
%% directory below this one that holds sources or headers to the engine. So all modules that
%% antidote calls are found: antidote_crdt, vectorclock, antidote_pb_codec, erlzmq, ranch and
%% riak_core (the package riak_core_lite; -include_lib("riak_core/include/riak_core_vnode.hrl") of
%% logging_vnode, materializer_vnode and inter_dc_log_sender_vnode resolves from this directory).
%% A call into a dependency is checked against the spec in its source; a function without one takes
%% and gives dynamic(), as riak_core_vnode_master:sync_command/3,4 and riak_core_status:ring_status/0.
%% antidote_stats is only reached by messages (the macro ?STATS casts to its collector).
%%
%% The driver defines no macro. So the tests under -ifdef(TEST) are not checked, and meta_data_sender
%% takes the variant of -else for -ifdef(EUNIT): get_node_list/0 and get_node_and_partition_list/0.
%%
%% All 55 modules run: 504 functions type check as they are, 218 do not. One of the 218 is a name
%% error (zmq_utils:connection_string/1 calls inet_parse:ntoa/1, which has no spec in OTP), none is
%% an internal error. The source of each of the 218 was read, no exception has the reason unknown.

{study, antidote}.
{deps, ["antidote_crdt", "antidote_pb_codec", "erlzmq", "poolboy", "ranch", "riak_core", "vectorclock"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), unknown.
%% The reason of an exception is the one of the first error that the checker reports for the function.
{reason, otp_no_spec,          fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, log_macro,            fixable,  "the ?LOG_ macros of logger.hrl end in erlang:apply(logger, macro_log, [..]), a term() for the checker and not the ok of that call: a function that gives the value of the macro as its result fails"}.
{reason, free_result,          fixable,  "library spec whose type variables are bound only in when (rpc:call/4,5, application:get_env/2,3, ets:first/1, lists:foldl/3): any use of the result passes, a pattern or a branch on such a value is dead"}.
{reason, dict_types,           fixable,  "key and value type of a dict:dict(K, V) are lost: the branches on a result of dict:find/2 and the patterns of a fun given to dict:filter/2 or dict:fold/3 are dead"}.
{reason, bound_pattern,        fixable,  "a pattern with an already bound variable is not handled: the match counts as not exhaustive"}.
{reason, narrowing,            fixable,  "a type test does not narrow: a filter X /= undefined in a comprehension, a case on is_binary(X) for its branches"}.
{reason, library_spec,         fixable,  "spec of a library function too imprecise"}.
{reason, body_exhaustiveness,  inherent, "exhaustiveness of a match or a case inside the body: the program lets it crash for the other values"}.
{reason, partial,              inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,            inherent, "defensive clause, dead for the spec"}.
{reason, nonempty_list,        inherent, "hd/1, lists:last/1 or a match with [H | _] on a list that the program knows is not empty"}.
{reason, number_range,         inherent, "range of a number (positive, not negative) that the types do not show"}.
{reason, bit_size,             fixable,  "a binary built with a segment of variable size is a bitstring() for the checker; that the size N * 8 makes whole bytes is arithmetic"}.
{reason, unchecked_result,     inherent, "a result that can be an error value, used as the success value"}.
{reason, untyped_value,        inherent, "term() from ets, disk_log, the stable meta data, element/2 of a tuple() or a container with term() values, used at the type the program expects"}.
{reason, call_reply,           inherent, "the reply of gen_server:call, gen_statem:call or a vnode command is term(): the spec promises the type of the reply, or the body matches it"}.
{reason, start_ret,            inherent, "result of starting a process, typed by the init function of the module: it gives neither ignore nor an error"}.
{reason, ets_new,              fixable,  "ets:new/2 gives a tid() when the table is not named"}.
{reason, correlated,           inherent, "the type of a value depends on another value (the op_type of a log operation for its payload, the size kept next to a list)"}.
{reason, deserialize,          inherent, "binary_to_term/1 gives term()"}.
{reason, record_undefined,     real,     "a record field declared T | undefined is used as T"}.
{reason, crdt_type,            real,     "antidote.hrl says type() :: atom() for a CRDT type, the functions of antidote_crdt take antidote_crdt:typ()"}.
{reason, dep_spec,             real,     "imprecise type spec in the source of a dependency"}.
{reason, spec_misuse,          real,     "a function is used against its spec, without effect at run time"}.
{reason, spec_imprecise,       real,     "imprecise type spec in the source"}.
{reason, spec_wrong,           real,     "wrong type in the source"}.
{reason, source_bug,           real,     "error in the program"}.

{module, antidote, #{file => "antidote/src/antidote.erl", timeout => 10000}}.
%% [Node] = log_utilities:get_preflist_from_key(..), a preflist of ?N = 1 nodes
{exception, antidote, get_log_operations_internal, 2, [ignore], body_exhaustiveness}.
%% promises {ok, {[term()], [object_token()]}}, cure:validate_or_read_objects/3 gives {ok, [valid | {invalid, term(),
%% binary()}]}
{exception, antidote, validate_or_read_objects, 3, [ignore], spec_wrong}.
{exception, antidote, type_check_update, 1, [ignore], crdt_type}. % antidote_crdt:is_operation(Type, {Op, Param})
%% the spec says atom() for the property, the clauses take update_clock and certify
{exception, antidote, get_txn_property, 2, [ignore], spec_imprecise}.

{module, antidote_app, #{file => "antidote/src/antidote_app.erl", timeout => 10000}}.
{exception, antidote_app, start, 2, [ignore], body_exhaustiveness}. % ok = logger:add_handler/3
%% {ok, DataDir} = application:get_env(antidote, data_dir)
{exception, antidote_app, validate_data_dir, 0, [ignore], body_exhaustiveness}.

{module, antidote_console, #{file => "antidote/src/antidote_console.erl", timeout => 10000}}.
%% riak_core_status:ringready/0 promises {error, any()}, the case has the two errors it gives
{exception, antidote_console, ringready, 1, [ignore], dep_spec}.

{module, antidote_dc_manager, #{file => "antidote/src/antidote_dc_manager.erl", timeout => 10000}}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, join_new_nodes, 1, [ignore], body_exhaustiveness}.
%% the first clause gives the value of ?LOG_WARNING as ok
{exception, antidote_dc_manager, plan_and_commit, 1, [ignore], log_macro}.
%% {ok, CurrentRing} = riak_core_ring_manager:get_my_ring()
{exception, antidote_dc_manager, wait_until_ring_no_pending_changes, 0, [ignore], body_exhaustiveness}.
{exception, antidote_dc_manager, wait_until_ring_ready, 1, [ignore], free_result}. % case on rpc:call/4

{module, antidote_error_monitor, #{file => "antidote/src/antidote_error_monitor.erl", timeout => 10000}}.

{module, antidote_ets_meta_data, #{file => "antidote/src/antidote_ets_meta_data.erl", timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{merged_data, Other}]
{exception, antidote_ets_meta_data, get_meta_data_sender_merged_data, 2, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_meta_data_as_map, 1, [ignore], untyped_value}.
%% ets:tab2list/1 gives [tuple()], maps:from_list/1 wants pairs
{exception, antidote_ets_meta_data, get_remote_meta_data_as_map, 1, [ignore], untyped_value}.
%% promises true, ets:insert_new/2 gives boolean()
{exception, antidote_ets_meta_data, insert_remote_meta_data_new, 3, [ignore], spec_wrong}.

{module, antidote_ets_txn_caches, #{file => "antidote/src/antidote_ets_txn_caches.erl", timeout => 10000}}.
%% case on ets:lookup/2 with [] and [{Key, List}]
{exception, antidote_ets_txn_caches, get_prepared_txn_by_key_and_table, 2, [ignore], untyped_value}.
%% get_prepared_cache_name/1 promises cache_id(), which has ets:tid(); ets:new/2 wants the atom it gives
{exception, antidote_ets_txn_caches, create_prepared_txns_cache, 1, [ignore], spec_imprecise}.

{module, antidote_hooks, #{file => "antidote/src/antidote_hooks.erl", timeout => 10000}}.
{exception, antidote_hooks, test_post_hook, 1, [ignore], body_exhaustiveness}. % {ok, _CT} = antidote:update_objects/3

{module, antidote_node_event_handler, #{file => "antidote/src/antidote_node_event_handler.erl", timeout => 10000}}.

{module, antidote_pb_process, #{file => "antidote/src/antidote_pb_process.erl", timeout => 10000}}.
%% binary_to_term(Clock) for snapshot_time() | ignore | txid(); the spec says binary() for a clock that the case tests for
%% undefined
{exception, antidote_pb_process, from_bin, 1, [ignore], deserialize}.
%% no clause for {validate_or_read_objects, _, _, _}, which antidote_pb_codec:request() has and the codec decodes
{exception, antidote_pb_process, process, 1, [ignore], source_bug}.

{module, antidote_pb_protocol, #{file => "antidote/src/antidote_pb_protocol.erl", timeout => 10000}}.
%% {ok, Socket} = ranch:handshake(Ref), which can give {continue, _}
{exception, antidote_pb_protocol, init, 3, [ignore], body_exhaustiveness}.
%% antidote_pb_process:process/1 promises antidote_pb_codec:response(), the reply as a client decodes it; it gives, and
%% antidote_pb_codec:encode_response/1 takes, response_in(): the objects that were read next to their values
{exception, antidote_pb_protocol, handle, 3, [ignore], spec_wrong}.

{module, antidote_pb_sup, #{file => "antidote/src/antidote_pb_sup.erl", timeout => 10000}}.

{module, antidote_ring_event_handler, #{file => "antidote/src/antidote_ring_event_handler.erl", timeout => 10000}}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, handle_event, 2, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, antidote_ring_event_handler, update_status, 0, [ignore], body_exhaustiveness}.

{module, antidote_stats, #{file => "antidote/src/antidote_stats.erl", timeout => 10000}}.
%% the filter ProcessInfo /= undefined does not narrow the result of erlang:process_info/1 for proplists:get_value/2
{exception, antidote_stats, update_processes_info, 1, [ignore], narrowing}.

{module, antidote_sup, #{file => "antidote/src/antidote_sup.erl", timeout => 10000}}.

{module, antidote_warning_monitor, #{file => "antidote/src/antidote_warning_monitor.erl", timeout => 10000}}.

{module, bcounter_mgr, #{file => "antidote/src/bcounter_mgr.erl", timeout => 10000}}.
{exception, bcounter_mgr, request_remote, 2, [ignore], body_exhaustiveness}. % {ok, [Obj], _} = antidote:read_objects/3

{module, clocksi_downstream, #{file => "antidote/src/clocksi_downstream.erl", timeout => 10000}}.
%% antidote_crdt:require_state_downstream(Type, Update)
{exception, clocksi_downstream, generate_downstream_op, 6, [ignore], crdt_type}.

{module, clocksi_interactive_coord, #{file => "antidote/src/clocksi_interactive_coord.erl", timeout => 10000}}.
%% promises {ok, pid()}, gen_statem:start_link/3 gives gen_statem:start_ret()
{exception, clocksi_interactive_coord, start_link, 0, [ignore], start_ret}.
%% hd(Preflist) of log_utilities:get_preflist_from_key/1
{exception, clocksi_interactive_coord, perform_singleitem_operation, 4, [ignore], nonempty_list}.
%% the spec says list() for the properties, create_transaction_record/3 takes txn_properties()
{exception, clocksi_interactive_coord, perform_singleitem_update, 5, [ignore], spec_imprecise}.
%% {ok, State} = start_tx_internal(..), which promises {ok, state()} | {error, any()} and gives no error
{exception, clocksi_interactive_coord, wait_for_start_transaction, 3, [ignore], spec_imprecise}.
%% the spec says {committed | clock_time()}, a tuple of one element, for the event {committed, CommitTime}; and
%% gen_statem:event_handler_result(state()) as prepare_done/2
{exception, clocksi_interactive_coord, single_committing, 3, [ignore], spec_wrong}.
%% the spec says proplists:proplist() for the properties, the field properties is txn_properties()
{exception, clocksi_interactive_coord, init_state, 3, [ignore], spec_imprecise}.
%% the spec says proplists:proplist() for the properties, create_transaction_record/3 takes txn_properties()
{exception, clocksi_interactive_coord, start_tx_internal, 3, [ignore], spec_imprecise}.
%% antidote:get_txn_property/2 promises atom(), the case has update_clock and no_update_clock
{exception, clocksi_interactive_coord, create_transaction_record, 3, [ignore], spec_imprecise}.
%% the spec says atom() and term() for the command and its argument, the clauses take seven commands, four of them with a tuple
{exception, clocksi_interactive_coord, execute_command, 4, [ignore], source_bug}.
%% the field updated_partitions is list(), lists:keyfind/3 takes a list of tuples
{exception, clocksi_interactive_coord, apply_tx_updates_to_snapshot, 4, [ignore], spec_imprecise}.
%% the field updated_partitions is list(), lists:keyfind/3 takes a list of tuples
{exception, clocksi_interactive_coord, has_tx_updates, 2, [ignore], spec_imprecise}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_read, 4, [ignore], library_spec}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_validate_or_read, 4, [ignore], library_spec}.
%% lists:keyfind/3 gives tuple() | false, the case has {Partition, WS} with Partition bound
{exception, clocksi_interactive_coord, perform_update, 5, [ignore], library_spec}.
%% the field op of #update_log_payload{} is op(), a pair {op_name(), op_param()}; it holds the downstream effect(), a term().
%% Reported where the log operation goes to logging_vnode:asyn_append/4
{exception, clocksi_interactive_coord, async_log_propagation, 5, [ignore], spec_wrong}.
%% Transaction = State#state.transaction with Transaction bound by the head; behind it the field is undefined | tx()
{exception, clocksi_interactive_coord, prepare, 1, [ignore], bound_pattern}.
%% gen_statem:event_handler_result(state()) makes the record the type of the state name: {next_state, single_committing, _} is
%% no such result
{exception, clocksi_interactive_coord, prepare_done, 2, [ignore], spec_wrong}.

{module, clocksi_interactive_coord_sup, #{file => "antidote/src/clocksi_interactive_coord_sup.erl", timeout => 10000}}.

{module, clocksi_materializer, #{file => "antidote/src/clocksi_materializer.erl", timeout => 10000}}.
%% {Length, _ListLen} = element(2, Tuple) for a tuple()
{exception, clocksi_materializer, get_first_id, 1, [ignore], untyped_value}.
%% the spec says snapshot_time() | ignore for MinSnapshotTime, materialize_intern/11 takes a snapshot_time()
{exception, clocksi_materializer, materialize, 4, [ignore], spec_imprecise}.
%% {Length, _ListLen} = element(2, TupleOps) for a tuple()
{exception, clocksi_materializer, materialize_intern, 11, [ignore], untyped_value}.
%% the spec says snapshot_time() for PrevTime, the case tests it for ignore and materialize_intern_perform/12 passes
%% snapshot_time() | ignore
{exception, clocksi_materializer, is_op_in_snapshot, 7, [ignore], spec_wrong}.

{module, clocksi_readitem, #{file => "antidote/src/clocksi_readitem.erl", timeout => 10000}}.
%% the spec says term() for the sender, the only clause takes {fsm, Sender}
{exception, clocksi_readitem, async_read_data_item, 6, [ignore], spec_imprecise}.
%% the spec says term() for the sender, the only clause takes {fsm, Sender}
{exception, clocksi_readitem, async_validate_or_read_data_item, 7, [ignore], spec_imprecise}.

{module, clocksi_vnode, #{file => "antidote/src/clocksi_vnode.erl", timeout => 10000}}.
%% case on logging_vnode:append/3 with {ok, _} and {error, timeout}, it promises {error, term()}
{exception, clocksi_vnode, handle_command, 3, [ignore], body_exhaustiveness}.
%% antidote_ets_txn_caches:get_prepared_txn_by_key_and_table/2 promises list(), lists:keymember/3 takes a list of tuples
{exception, clocksi_vnode, set_prepared, 5, [ignore], spec_imprecise}.
%% case on logging_vnode:append_commit/3 with {ok, _} and {error, timeout}, it promises {error, term()}
{exception, clocksi_vnode, commit, 5, [ignore], body_exhaustiveness}.
%% antidote_ets_txn_caches:get_prepared_txn_by_key_and_table/2 promises list(), lists:keydelete/3 takes a list of tuples
{exception, clocksi_vnode, clean_prepared, 3, [ignore], spec_imprecise}.
%% antidote:get_txn_property/2 promises atom(), the case has true and false
{exception, clocksi_vnode, certification_check, 4, [ignore], spec_imprecise}.
%% lists:foldl/3 with a fun that takes a tuple {Key, Type, Op}
{exception, clocksi_vnode, update_materializer, 3, [ignore], free_result}.
%% the spec says list() for the prepared transactions, the case takes [{Time, _TxId} | _]
{exception, clocksi_vnode, get_min_prep, 1, [ignore], spec_imprecise}.
%% the spec says list() for the prepared transactions, the clause takes [{Time, TxId} | Rest]
{exception, clocksi_vnode, get_time, 2, [ignore], spec_imprecise}.
{exception, clocksi_vnode, get_committed_txn, 2, [ignore], untyped_value}. % case on ets:lookup/2 with [{_, CommitTime}] and []

{module, cure, #{file => "antidote/src/cure.erl", timeout => 10000}}.
{exception, cure, abort_transaction, 1, [ignore], call_reply}. % case on the reply of gen_statem:call/2
{exception, cure, validate_or_read_objects, 3, [ignore], call_reply}. % case on the reply of gen_statem:call/3
{exception, cure, obtain_objects, 3, [ignore], call_reply}. % case on the reply of gen_statem:call/3
{exception, cure, update_objects, 2, [ignore], call_reply}. % case on the reply of gen_statem:call/3
%% the spec says list() for the properties, clocksi_istart_tx/2 takes txn_properties()
{exception, cure, update_objects, 3, [ignore], spec_imprecise}.
%% case Objects of [_O]; [_H | _T]: no clause for [], a static read of no objects ends in case_clause (obtain_objects/3 answers
%% it with {ok, []})
{exception, cure, obtain_objects, 4, [ignore], source_bug}.
{exception, cure, clocksi_istart_tx, 2, [ignore], call_reply}. % reply of gen_statem:call/2
{exception, cure, clocksi_full_icommit, 1, [ignore], call_reply}. % reply of gen_statem:call/3
{exception, cure, clocksi_iprepare, 1, [ignore], call_reply}. % reply of gen_statem:call/3
{exception, cure, clocksi_icommit, 1, [ignore], call_reply}. % reply of gen_statem:call/3

{module, dc_meta_data_utilities, #{file => "antidote/src/dc_meta_data_utilities.erl", timeout => 10000}}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as boolean()
{exception, dc_meta_data_utilities, is_restart, 0, [ignore], untyped_value}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as atom()
{exception, dc_meta_data_utilities, get_env_meta_data, 2, [ignore], untyped_value}.
%% stable_meta_data_server:read_all_meta_data/0 promises [tuple()], the fun takes pairs
{exception, dc_meta_data_utilities, load_env_meta_data, 0, [ignore], spec_imprecise}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as atom()
{exception, dc_meta_data_utilities, get_meta_data_name, 0, [ignore], untyped_value}.
%% lists:foldl/3 with a fun that takes a record #descriptor{}
{exception, dc_meta_data_utilities, store_dc_descriptors, 1, [ignore], free_result}.
%% value of stable_meta_data_server:read_meta_data/1, a term(), as the dict for dict:fold/3
{exception, dc_meta_data_utilities, get_dc_descriptors, 0, [ignore], untyped_value}.

{module, dc_utilities, #{file => "antidote/src/dc_utilities.erl", timeout => 10000}}.
{exception, dc_utilities, get_my_dc_id, 0, [ignore], body_exhaustiveness}. % {ok, Ring} = riak_core_ring_manager:get_my_ring()
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, dc_utilities, get_my_dc_nodes, 0, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, dc_utilities, partition_to_indexnode, 1, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, dc_utilities, get_all_partitions, 0, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, dc_utilities, get_all_partitions_nodes, 0, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, dc_utilities, get_my_partitions, 0, [ignore], body_exhaustiveness}.
%% vectorclock:map/2 as a foreach: the fun gives the value of ?LOG_DEBUG where the spec wants a pos_integer()
{exception, dc_utilities, check_staleness, 0, [ignore], spec_misuse}.
%% case on meta_data_sender:get_merged_data/2 with a clause for undefined; the result has the type of the default, a
%% vectorclock()
{exception, dc_utilities, get_stable_snapshot, 0, [ignore], defensive}.
%% now_microsec() - ?OLD_SS_MICROSEC is an integer(), the spec promises pos_integer()
{exception, dc_utilities, get_scalar_stable_time, 0, [ignore], number_range}.
%% erlang:system_time/1 gives integer(), the spec promises non_neg_integer()
{exception, dc_utilities, now_microsec, 0, [ignore], number_range}.

{module, inter_dc_dep_vnode, #{file => "antidote/src/inter_dc_dep_vnode.erl", timeout => 10000}}.
%% dc_utilities:call_local_vnode_sync/3 gives any(), the reply to {txn, Txn} is ok
{exception, inter_dc_dep_vnode, handle_transaction, 1, [ignore], call_reply}.
%% dc_utilities:call_local_vnode_sync/3 gives any(), the reply to {set_dependency_clock, Vector} is ok
{exception, inter_dc_dep_vnode, set_dependency_clock, 2, [ignore], call_reply}.
%% the spec says [partition_id()], the clause takes [Partition] as riak_core_vnode passes it
{exception, inter_dc_dep_vnode, init, 1, [ignore], partial}.
{exception, inter_dc_dep_vnode, try_store, 2, [ignore], body_exhaustiveness}. % {ok, _} = logging_vnode:append_group/4
{exception, inter_dc_dep_vnode, push_txn, 2, [ignore], bound_pattern}. % DCID = Txn#interdc_txn.dcid with DCID bound by the head
%% the fun of lists:map/2 matches the payload with #update_log_payload{}, inter_dc_txn:ops_by_type(Txn, update) gives
%% [log_record()] with any_log_payload()
{exception, inter_dc_dep_vnode, updates_to_clocksi_payloads, 1, [ignore], correlated}.

{module, inter_dc_log_sender_vnode, #{file => "antidote/src/inter_dc_log_sender_vnode.erl", timeout => 10000}}.
%% dc_utilities:call_vnode_sync/3 gives any(), the reply to {start_timer} is ok
{exception, inter_dc_log_sender_vnode, start_timer, 1, [ignore], call_reply}.
%% dc_utilities:call_vnode_sync/3 gives any(), the reply to {update_last_log_id, OpId} is ok
{exception, inter_dc_log_sender_vnode, update_last_log_id, 2, [ignore], call_reply}.
%% the field timer is any(), erlang:cancel_timer/1 takes a reference()
{exception, inter_dc_log_sender_vnode, del_timer, 1, [ignore], spec_imprecise}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, inter_dc_log_sender_vnode, set_timer, 2, [ignore], body_exhaustiveness}.

{module, inter_dc_manager, #{file => "antidote/src/inter_dc_manager.erl", timeout => 10000}}.
%% inter_dc_conn_err() has {error, {error, connection_error}}, connect_nodes/6 gives {error, connection_error}
{exception, inter_dc_manager, observe_dc, 2, [ignore], spec_wrong}.
{exception, inter_dc_manager, connect_nodes, 6, [ignore], free_result}. % case on rpc:call/5
