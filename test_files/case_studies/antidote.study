{assertion, meta_data_sender, {161, 5, "959f6b"}, assert_pattern, "{_, _}", body_exhaustiveness}.
{assertion, meta_data_sender, {163, 42, "e13d42"}, assert_type, "map()", untyped_value}.
%% maps:map(fun(NodeId, _Val) -> ok = RemoveFun(Name, NodeId) end, NodeErase): the keys of the map() are term(), RemoveFun takes
%% the E of the spec ([E] for the entries); the map cannot be asserted as #{E => term()}. The case on maps:find/2 in the fold
%% fun type checks with the library overlay; behind it the match ok = RemoveFun(..) is inside a fun
{exception, meta_data_sender, update, 6, [ignore], assert_tyvar}.
%% get_node_list/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, meta_data_sender, {291, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% get_node_and_partition_list/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, meta_data_sender, {302, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.

{module, meta_data_sender_sup, #{file => "antidote/src/meta_data_sender_sup.erl",
