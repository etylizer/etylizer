{module, inter_dc_query_dealer, #{file => "antidote/src/inter_dc_query_dealer.erl",
                                  overlays => [{specs, "overlay_antidote.erl"},
                                               {deps, "overlay_erlzmq.erl"},
                                               {library, "overlay_riak_core_lite_lib.erl"},
                                               {library, "overlay_antidote_lib.erl"}],
                                  timeout => 10000}}.
%% perform_request/4: the reply of gen_server:call/2 to {any_request, ..}, a term(), is the result
{assertion, inter_dc_query_dealer, {85, 5, "23ad93"}, assert_type, "ok | unknown_dc", call_reply}.
%% add_dc/2: ok = gen_server:call/3
{assertion, inter_dc_query_dealer, {90, 5, "dedbe9"}, assert_pattern, "ok", call_reply}.
%% del_dc/1: ok = gen_server:call/3
{assertion, inter_dc_query_dealer, {95, 5, "c23211"}, assert_pattern, "ok", call_reply}.
%% error = dict:find(Key, CurrentDict) and {ok, Socket} = connect_to_node(AddressList) in the funs of the clause for {add_dc, _,
%% _}. In front of them, in the clause for {any_request, ..}: the socket out of dict:find/2 is term(), and ok = erlzmq:send/2
{exception, inter_dc_query_dealer, handle_call, 3, [ignore], in_fun}.
%% Func(RestBinary) with the field func of #request_cache_entry{}, function() | undefined. In front of it the message is term():
%% BinaryMsg of {zmq, _, BinaryMsg, _} goes to inter_dc_utils:check_message_version/1, and the binary match on its result
{exception, inter_dc_query_dealer, handle_info, 2, [ignore], record_undefined}.
%% terminate/2: the pairs of dict:to_list/1 are {term(), term()}, the fun closes the socket of each
{assertion, inter_dc_query_dealer, {188, 22, "f2d79a"}, assert_type, "[{{dcid(), term()}, zmq_socket()}]", dict_types}.
%% del_dc/2: the fun of dict:filter/2 takes the key as {DictDCID, _DictPartition}: it is reported as dead (key and value of a
%% dict have no type), annotated with its type it type checks. The pairs of dict:to_list/1 are {term(), term()}, the fold fun
%% closes the socket of each
{assertion, inter_dc_query_dealer, {205, 20, "8d351d"}, annotate_type, "fun(({dcid(), term()}, zmq_socket()) -> boolean())", dict_types}.
{assertion, inter_dc_query_dealer, {216, 49, "917ba4"}, assert_type, "[{{dcid(), term()}, zmq_socket()}]", dict_types}.
%% ok = zmq_utils:close_socket(Socket1) at 233:5: the match (hash 01a833) and the call at 233:10 (hash 01e56a) both crash the
%% engine with an assertion. In front of it ok = erlzmq:setsockopt/3 and ok = erlzmq:send/2 take assert_pattern
{exception, inter_dc_query_dealer, connect_to_node, 1, [ignore], assertion_crash}.
%% create_queries_table/0: promises ets:tid(), ets:new/2 gives ets:table(): the table is not named
{assertion, inter_dc_query_dealer, {257, 5, "e018fc"}, assert_type, "ets:tid()", ets_new}.
%% case ets:lookup(Table, ReqIdBinary) of []; [{ReqIdBinary, Val}] with ReqIdBinary bound: with the result asserted as [] or one
%% pair (ets:lookup/2 gives [tuple()]) the case counts as not exhaustive
{exception, inter_dc_query_dealer, get_request, 2, [ignore], bound_pattern}.

{module, inter_dc_query_response, #{file => "antidote/src/inter_dc_query_response.erl",
                                    overlays => [{specs, "overlay_antidote.erl"},
                                                 {library, "overlay_riak_core_lite_lib.erl"},
                                                 {library, "overlay_antidote_lib.erl"}],
                                    timeout => 10000}}.
%% the spec says [Num] when Num :: any(), the field id of the state is a non_neg_integer(); start_link/1 passes the number of
%% the worker. Behind it the clause takes a list of one element (flag)
{exception, inter_dc_query_response, init, 1, [ignore], spec_imprecise}.
%% handle_cast/2: the message is term(): the binaries of {get_entries, BinaryQuery, QueryState} and {request_permissions,
%% BinaryRequest, QueryState} go to binary_to_term/1 and the query state to inter_dc_query_router:send_response/2;
%% binary_to_term/1 gives term(), matched with {read_log, Partition, From, To} for get_entries_internal/3 and with
%% {request_permissions, Operation, _, _, _} for bcounter_mgr:process_transfer/1 (that match takes assert_pattern: the call
%% crashes the engine with an assertion)
{assertion, inter_dc_query_response, {90, 39, "685eb4"}, assert_type, "{read_log, partition_id(), log_opid(), log_opid()}", deserialize}.
{assertion, inter_dc_query_response, {90, 54, "bd3484"}, assert_type, "binary()", message_term}.
{assertion, inter_dc_query_response, {97, 60, "f42301"}, assert_type, "inter_dc_query_state()", message_term}.
{assertion, inter_dc_query_response, {100, 5, "d6a0bf"}, assert_pattern, "{request_permissions, _, _, _, _}", deserialize}.
{assertion, inter_dc_query_response, {100, 79, "3bf8f2"}, assert_type, "binary()", message_term}.
{assertion, inter_dc_query_response, {101, 18, "3bf8f2"}, assert_type, "binary()", message_term}.
{assertion, inter_dc_query_response, {102, 40, "b9e022"}, assert_type, "{transfer, overlay_antidote:bcounter_transfer()}", deserialize}.
