%% the cluster is the id of the DC
{assertion, dc_utilities, {67, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, dc_utilities, {68, 5, "e185da"}, assert_type, "dcid()", untyped_value}.
%% get_my_dc_nodes/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, dc_utilities, {73, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% partition_to_indexnode/1: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, dc_utilities, {79, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% get_all_partitions/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, dc_utilities, {92, 22, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% get_all_partitions_nodes/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, dc_utilities, {107, 22, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% get_my_partitions/0: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, dc_utilities, {119, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% vectorclock:map/2 as a foreach: the fun gives the value of ?LOG_DEBUG where the spec wants a pos_integer()
{exception, dc_utilities, check_staleness, 0, [ignore], spec_misuse}.
%% get_stable_snapshot/0: case on meta_data_sender:get_merged_data/2 with a clause for undefined; the result has the type of the
%% default, a vectorclock(): the subject is annotated vectorclock() | undefined
{assertion, dc_utilities, {254, 10, "39d2d2"}, annotate_type, "vectorclock() | undefined", defensive}.
%% get_scalar_stable_time/0: now_microsec() - ?OLD_SS_MICROSEC is no pos_integer() for the checker, the spec promises one;
%% vectorclock:min_clock/2 gives non_neg_integer(), the result takes a pos_integer(): the entries of a clock are positive
{assertion, dc_utilities, {276, 47, "e86fb0"}, assert_type, "pos_integer()", number_range}.
{assertion, dc_utilities, {280, 19, "9e18d1"}, assert_type, "pos_integer()", number_range}.
%% now_microsec/0: erlang:system_time/1 gives integer(), the spec promises non_neg_integer()
{assertion, dc_utilities, {298, 5, "11d3bc"}, assert_type, "non_neg_integer()", number_range}.

{module, inter_dc_dep_vnode, #{file => "antidote/src/inter_dc_dep_vnode.erl",
