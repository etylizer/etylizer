%% the spec says term() for the sender, the only clause takes {fsm, Sender}
{exception, clocksi_readitem, async_validate_or_read_data_item, 7, [ignore], spec_imprecise}.

{module, clocksi_vnode, #{file => "antidote/src/clocksi_vnode.erl",
                          overlays => [{specs, "overlay_antidote.erl"},
                                       {deps, "overlay_riak_core_lite.erl"}],
                          timeout => 10000}}.
%% clocksi_materializer:materialize_eager/3 says [op()] for the effects to apply; materializer:materialize_eager/3, which it
%% calls, says [effect()]
{exception, clocksi_vnode, read_data_item, 5, [ignore], spec_wrong}.
%% clocksi_materializer:materialize_eager/3 says [op()] for the effects to apply; materializer:materialize_eager/3, which it
%% calls, says [effect()]
{exception, clocksi_vnode, validate_or_read_data_item, 6, [ignore], spec_wrong}.
%% reply of riak_core_vnode_master:sync_command/4; behind it antidote_ets_txn_caches:get_prepared_txns_by_key/2 promises list()
%% for the prepared transactions
{exception, clocksi_vnode, get_active_txns_key, 2, [ignore], call_reply}.
%% the clause takes [{Node, WriteSet}]: a transaction that wrote to one partition
{exception, clocksi_vnode, single_commit, 2, [ignore], partial}.
%% the clause takes [{Node, WriteSet}]: a transaction that wrote to one partition
{exception, clocksi_vnode, single_commit_sync, 2, [ignore], partial}.
%% the clause takes [Partition] as riak_core_vnode passes it, a list type cannot say one element
{exception, clocksi_vnode, init, 1, [ignore], partial}.
%% case on the reply of riak_core_vnode_master:sync_command/4 with true and false
{exception, clocksi_vnode, check_table_ready, 1, [ignore], call_reply}.
%% the request is term(): {prepare, Transaction, WriteSet} hands its parts to prepare/6
{exception, clocksi_vnode, handle_command, 3, [ignore], message_term}.
%% the prepared transactions are a list() in the source (#state.prepared_dict, get_min_prep/1, get_time/2) and so in the
%% overlay; orddict:store/3 takes an orddict
{exception, clocksi_vnode, prepare, 6, [ignore], spec_imprecise}.
%% antidote_ets_txn_caches:get_prepared_txn_by_key_and_table/2 promises list(), lists:keymember/3 takes a list of tuples
{exception, clocksi_vnode, set_prepared, 5, [ignore], spec_imprecise}.
%% case on logging_vnode:append_commit/3 with {ok, _} and {error, timeout}, it promises {error, term()}
{exception, clocksi_vnode, commit, 5, [ignore], body_exhaustiveness}.
%% the prepared transactions are a list() in the source (#state.prepared_dict, get_min_prep/1, get_time/2) and so in the
%% overlay; orddict:erase/2 takes an orddict
{exception, clocksi_vnode, clean_and_notify, 3, [ignore], spec_imprecise}.
%% antidote_ets_txn_caches:get_prepared_txn_by_key_and_table/2 promises list(), lists:keydelete/3 takes a list of tuples
{exception, clocksi_vnode, clean_prepared, 3, [ignore], spec_imprecise}.
%% antidote:get_txn_property/2 promises atom(), the case has true and false
{exception, clocksi_vnode, certification_check, 4, [ignore], spec_imprecise}.
%% lists:foldl/3 with a fun that takes a tuple {Key, Type, Op}
{exception, clocksi_vnode, update_materializer, 3, [ignore], free_result}.
%% lists:foldl/3 with a fun that takes a tuple {KeyPrime, _Type, Op}
{exception, clocksi_vnode, reverse_and_filter_updates_per_key, 2, [ignore], free_result}.
%% the spec says list() for the prepared transactions, the case takes [{Time, _TxId} | _]
{exception, clocksi_vnode, get_min_prep, 1, [ignore], spec_imprecise}.
%% the spec says list() for the prepared transactions, the clause takes [{Time, TxId} | Rest]
{exception, clocksi_vnode, get_time, 2, [ignore], spec_imprecise}.
{exception, clocksi_vnode, get_committed_txn, 2, [ignore], untyped_value}. % case on ets:lookup/2 with [{_, CommitTime}] and []

{module, cure, #{file => "antidote/src/cure.erl",
                 overlays => [{specs, "overlay_antidote.erl"}, {deps, "overlay_antidote_crdt.erl"}], timeout => 10000}}.
{exception, cure, abort_transaction, 1, [ignore], call_reply}. % case on the reply of gen_statem:call/2
