%% [{log_id(), log_record()}]
{assertion, logging_vnode, {823, 5, "566d30"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, logging_vnode, {830, 47, "87f97c"}, assert_type, "[{log_id(), log_record()}]", untyped_value}.
