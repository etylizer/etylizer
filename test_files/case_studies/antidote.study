%% the case on perform_read_internal/5 has {ok, Snapshot} only (the clause for {error, Reason} is commented out in the source,
%% TODO: dialyzer says this can never happen); it is in the fun of spawn_link/2
{exception, clocksi_readitem, async_read_data_item, 6, [ignore], in_fun}.
%% validate_or_read_data_item/6: result of rpc:call/4, a term(), as the result of perform_validate_or_read_internal/6
{assertion, clocksi_readitem, {87, 5, "9450d5"}, assert_type, "{ok, {invalid, snapshot(), object_token()}} | {ok, valid} | {error, term()}", untyped_value}.

{module, clocksi_vnode, #{file => "antidote/src/clocksi_vnode.erl",
                          overlays => [{specs, "overlay_antidote.erl"},
                                       {deps, "overlay_riak_core_lite.erl"},
                                       {library, "overlay_riak_core_lite_lib.erl"},
                                       {library, "overlay_antidote_lib.erl"}],
                          timeout => 10000}}.
%% get_active_txns_key/2: the reply of riak_core_vnode_master:sync_command/4 to {get_active_txns, _}, a term(), is the result
{assertion, clocksi_vnode, {141, 13, "2eb7c1"}, assert_type, "{ok, [{txid(), clock_time()}]}", call_reply}.
%% the clause takes [{Node, WriteSet}]: a transaction that wrote to one partition
{exception, clocksi_vnode, single_commit, 2, [no_exhaustiveness], partial}.
%% single_commit_sync/2: the clause takes [{Node, WriteSet}]: a transaction that wrote to one partition; the reply of
%% riak_core_vnode_master:sync_command/3 to {single_commit, _, _}, a term(), is the result
{assertion, clocksi_vnode, {180, 5, "450808"}, assert_type, "{committed, clock_time()} | abort | {error, reason()}", call_reply}.
{exception, clocksi_vnode, single_commit_sync, 2, [no_exhaustiveness], partial}.
%% the clause takes [Partition] as riak_core_vnode passes it, a list type cannot say one element
{exception, clocksi_vnode, init, 1, [no_exhaustiveness], partial}.
%% check_table_ready/1: case on the reply of riak_core_vnode_master:sync_command/4 to {check_tables_ready}, a term(), with true
%% and false
{assertion, clocksi_vnode, {240, 13, "d66158"}, assert_type, "boolean()", call_reply}.
%% handle_command/3: the request is term(): the transaction, the write set and the commit time of {prepare, _, _},
%% {single_commit, _, _}, {commit, _, _, _} and {abort, _, _} go to prepare/6, commit/5 and clean_and_notify/3 at their types.
%% The cases on the result of prepare/6, which promises {error, reason()}, have timeout, no_updates and write_conflict; the case
%% on logging_vnode:append/3 has {error, timeout}
{assertion, clocksi_vnode, {281, 45, "d898e1"}, assert_type, "{{ok, op_id()} | {error, timeout | no_updates | write_conflict}, clock_time(), overlay_antidote:prepared_dict()}", call_reply}.
{assertion, clocksi_vnode, {282, 9, "1a35d8"}, assert_type, "tx()", message_term}.
{assertion, clocksi_vnode, {282, 22, "d9cb6c"}, assert_type, "overlay_antidote:write_set()", message_term}.
{assertion, clocksi_vnode, {308, 45, "d898e1"}, assert_type, "{{ok, op_id()} | {error, timeout | no_updates | write_conflict}, clock_time(), overlay_antidote:prepared_dict()}", call_reply}.
{assertion, clocksi_vnode, {309, 9, "1a35d8"}, assert_type, "tx()", message_term}.
{assertion, clocksi_vnode, {309, 22, "d9cb6c"}, assert_type, "overlay_antidote:write_set()", message_term}.
{assertion, clocksi_vnode, {314, 35, "1a35d8"}, assert_type, "tx()", message_term}.
{assertion, clocksi_vnode, {314, 60, "d9cb6c"}, assert_type, "overlay_antidote:write_set()", message_term}.
{assertion, clocksi_vnode, {345, 21, "1a35d8"}, assert_type, "tx()", message_term}.
{assertion, clocksi_vnode, {345, 34, "607721"}, assert_type, "clock_time()", message_term}.
{assertion, clocksi_vnode, {345, 48, "1f9ac8"}, assert_type, "overlay_antidote:write_set()", message_term}.
{assertion, clocksi_vnode, {361, 12, "1a35d8"}, assert_type, "tx()", message_term}.
{assertion, clocksi_vnode, {369, 22, "afca6d"}, assert_type, "{ok, op_id()} | {error, timeout}", call_reply}.
{assertion, clocksi_vnode, {374, 48, "1f9ac8"}, assert_type, "overlay_antidote:write_set()", message_term}.
{assertion, clocksi_vnode, {376, 48, "1f9ac8"}, assert_type, "overlay_antidote:write_set()", message_term}.
%% reset_prepared/5: the value of dict:fetch/2, a term(), is the tail of the list of the prepared transactions of the key (the
%% assertion is on the list, on the call it crashes the engine)
{assertion, clocksi_vnode, {472, 82, "869048"}, assert_type, "[{txid(), clock_time()}]", dict_types}.
%% commit/5: case on logging_vnode:append_commit/3 with {ok, _} and {error, timeout}, it promises {error, term()}
{assertion, clocksi_vnode, {503, 18, "fc0fa1"}, assert_type, "{ok, op_id()} | {error, timeout}", call_reply}.
%% get_committed_txn/2: case on ets:lookup/2, which gives [tuple()], with [{_, CommitTime}] and []: the table is a set with at
%% most one object for a key, the commit time of the transaction
{assertion, clocksi_vnode, {691, 10, "e033c1"}, assert_type, "[] | etylizer:cons({term(), clock_time()}, [])", untyped_value}.

{module, cure, #{file => "antidote/src/cure.erl",
                 overlays => [{specs, "overlay_antidote.erl"},
                              {deps, "overlay_antidote_crdt.erl"},
                              {library, "overlay_riak_core_lite_lib.erl"},
                              {library, "overlay_antidote_lib.erl"}],
                 timeout => 10000}}.
%% abort_transaction/1: case on the reply of gen_statem:call/2 to {abort, []}, a term(), with {error, aborted} and {error,
%% Reason}
{assertion, cure, {66, 10, "7bafa1"}, assert_type, "{error, reason()}", call_reply}.
%% validate_or_read_objects/3: case on the reply of gen_statem:call/3 to {validate_or_read_objects, _}, a term(), with {ok,
%% Results} and {error, Reason}
{assertion, cure, {95, 9, "5f1c16"}, assert_type, "{ok, [valid | {invalid, snapshot(), object_token()}]} | {error, reason()}", call_reply}.
%% obtain_objects/3: case on the reply of gen_statem:call/3 to {read_objects, _}, a term(), with {ok, Res} and {error, Reason}
{assertion, cure, {111, 10, "42a1b7"}, assert_type, "{ok, [snapshot()]} | {error, reason()}", call_reply}.
%% case on the reply of gen_statem:call/3 with ok, {aborted, TxId} and {error, Reason}, TxId bound by the head: with the reply
%% asserted as ok | {aborted, txid()} | {error, reason()} the case counts as not exhaustive
{exception, cure, update_objects, 2, [ignore], bound_pattern}.
%% update_objects/3: {ok, TxId} = clocksi_istart_tx/2, which promises {error, reason()} as well
{assertion, cure, {139, 5, "b01f18"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% case Objects of [_O]; [_H | _T]: no clause for [], a static read of no objects ends in case_clause (obtain_objects/3 answers
%% it with {ok, []})
{exception, cure, obtain_objects, 4, [ignore], source_bug}.
%% clocksi_istart_tx/2: {ok, Pid} = clocksi_interactive_coord_sup:start_fsm(), the result of supervisor:start_child/2; the reply
%% of gen_statem:call/2 to {start_tx, _, _}, a term(), is the result
{assertion, cure, {220, 5, "a17b27"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, cure, {221, 5, "67d41a"}, assert_type, "{ok, txid()} | {error, reason()}", call_reply}.
%% clocksi_full_icommit/1: the replies of gen_statem:call/3 to {prepare, empty} (given as the result when it is not {ok, _}) and
%% to commit are term()
{assertion, cure, {230, 13, "a5ac1d"}, assert_type, "{aborted, txid()} | {ok, {txid(), snapshot_time()}} | {error, reason()}", call_reply}.
{assertion, cure, {232, 13, "8bdb36"}, assert_type, "{aborted, txid()} | {error, reason()}", call_reply}.
%% clocksi_iprepare/1: the reply of gen_statem:call/3 to {prepare, two_phase}, a term(), is the result when it is not {error,
%% {aborted, TxId}}
{assertion, cure, {258, 13, "b0c93b"}, assert_type, "{aborted, txid()} | {ok, non_neg_integer()}", call_reply}.
%% clocksi_icommit/1: the reply of gen_statem:call/3 to commit, a term(), is the result
{assertion, cure, {263, 5, "dfd1b9"}, assert_type, "{aborted, txid()} | {ok, {txid(), snapshot_time()}}", call_reply}.

{module, dc_meta_data_utilities, #{file => "antidote/src/dc_meta_data_utilities.erl",
                                   overlays => [{specs, "overlay_antidote.erl"},
                                                {library, "overlay_riak_core_lite_lib.erl"},
                                                {library, "overlay_antidote_lib.erl"}],
                                   timeout => 10000}}.
%% is_restart/0: value of stable_meta_data_server:read_meta_data/1, a term(), as the flag has_started
{assertion, dc_meta_data_utilities, {64, 13, "2caa2e"}, assert_type, "boolean()", untyped_value}.
%% get_env_meta_data/2: the value of a setting out of stable_meta_data_server:read_meta_data/1 or application:get_env/3, a
%% term(), as the atom() that the spec promises
{assertion, dc_meta_data_utilities, {78, 13, "2caa2e"}, assert_type, "atom()", untyped_value}.
{assertion, dc_meta_data_utilities, {82, 13, "8ef7f9"}, assert_type, "atom()", untyped_value}.
%% load_env_meta_data/0: the key of a pair of stable_meta_data_server:read_all_meta_data/0 is a term(): Name of {env, Name} goes
%% to application:set_env/3 as an atom(). The match is in the fun of lists:foreach/2: the fun is annotated with a type that says
%% an {env, _} key has an atom(), and cast to the fun type for the pairs
{assertion, dc_meta_data_utilities, {90, 9, "aac595"}, assert_type, "fun(({key(), term()}) -> ok)", untyped_value}.
{assertion, dc_meta_data_utilities, {90, 9, "aac595"}, annotate_type, "fun(({{env, atom()} | etylizer:without(term(), {env, term()}), term()}) -> ok)", untyped_value}.
%% get_meta_data_name/0: value of stable_meta_data_server:read_meta_data/1, a term(), as the name of the meta data, an atom()
{assertion, dc_meta_data_utilities, {108, 5, "79de2d"}, assert_type, "{ok, atom()} | error", untyped_value}.
%% store_dc_descriptors/1: MergeFunc goes to stable_meta_data_server:broadcast_meta_data_merge/4 as a function(): the fun inside
%% it that takes #descriptor{} is reported as dead (this branch never matches); the fun is annotated with its type
{assertion, dc_meta_data_utilities, {113, 17, "3a97ca"}, annotate_type, "fun(([descriptor()], dict:dict(dcid(), descriptor())) -> dict:dict(dcid(), descriptor()))", fun_any}.
%% get_dc_descriptors/0: value of stable_meta_data_server:read_meta_data/1, a term(), as the dict of the descriptors that
%% store_dc_descriptors/1 keeps; its values, term() for dict:fold/3, are the result
{assertion, dc_meta_data_utilities, {129, 10, "8821ff"}, assert_type, "{ok, dict:dict(dcid(), descriptor())} | error", untyped_value}.
{assertion, dc_meta_data_utilities, {131, 13, "912380"}, assert_type, "[descriptor()]", dict_types}.

{module, dc_utilities, #{file => "antidote/src/dc_utilities.erl",
                         overlays => [{specs, "overlay_antidote.erl"},
                                      {deps, "overlay_riak_core_lite.erl"},
