%% finish_op_load/1: the fun of dict:fold/3 takes the value as the list of the operations of the key, the dict has term(): the
%% fun is cast to the fun type of dict:fold/3
{assertion, logging_vnode, {966, 9, "39ea97"}, assert_type, "fun((term(), term(), dict:dict(key(), [{non_neg_integer(), clocksi_payload()}])) -> dict:dict(key(), [{non_neg_integer(), clocksi_payload()}]))", dict_types}.
