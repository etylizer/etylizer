%% {remove_node, NodeId} goes to antidote_ets_meta_data as an atom(); true =
%% antidote_ets_meta_data:insert_remote_meta_data_new/3, which gives boolean()
{assertion, meta_data_manager, {91, 66, "ab55e0"}, assert_type, "atom()", message_term}.
{assertion, meta_data_manager, {94, 5, "54fcd0"}, assert_pattern, "true", body_exhaustiveness}.
{assertion, meta_data_manager, {94, 70, "ab55e0"}, assert_type, "atom()", message_term}.
{assertion, meta_data_manager, {97, 71, "ab55e0"}, assert_type, "atom()", message_term}.

