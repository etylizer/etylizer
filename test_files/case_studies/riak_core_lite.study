{assertion, riak_core_gossip, {174, 49, "6bcf50"}, assert_type, "riak_core_ring:riak_core_ring()", message_term}.
{assertion, riak_core_gossip, {177, 49, "6bcf50"}, assert_type, "riak_core_ring:riak_core_ring()", message_term}.
%% handle_info/2: {Tokens, _} = application:get_env(riak_core, gossip_limit, {45, 10000}), the value of the environment is
