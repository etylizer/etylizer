%% the next of a ring that is resized has no others
{assertion, riak_core_ring, {952, 49, "91df3b"}, assert_type, "[overlay_riak_core_lite:ring_resize_entry()]", partial}.
%% case lists:keyfind(Target, 1, ResizeTransfers) of false; {Target, _, complete}; {Target, Mods, awaiting}: the patterns repeat
%% the bound Target, the case counts as not exhaustive
{exception, riak_core_ring, resize_transfer_status, 4, [ignore], bound_pattern}.
%% resize_transfers/2: {ok, Transfers} = get_meta({resize, Source}, [], State) is term() from the meta dict, the spec promises
%% [resize_transfer()]
{assertion, riak_core_ring, {1151, 5, "cb8016"}, assert_type, "[resize_transfer()]", untyped_value}.
%% field chring is chash:chash() or undefined, returned as {ok, chash:chash()}; behind it {ok, CHRing} from get_meta/2 is term()
{exception, riak_core_ring, resized_ring, 1, [ignore], record_undefined}.
{exception, riak_core_ring, vnode_type, 3, [ignore], catch_pattern}. % catch error:{badmatch, _}; type checks with error:_
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, ring_ready, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, ring_ready_info, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2; behind it {ok, FutureCHash} = resized_ring(State0), catch
%% error:{badmatch, _} and a fold fun for '$resize' entries only
{exception, riak_core_ring, future_ring, 2, [ignore], record_undefined}.
