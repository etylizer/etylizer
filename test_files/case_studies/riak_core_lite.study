{module, riak_core_handoff_receiver, #{file => "riak_core/src/riak_core_handoff_receiver.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
