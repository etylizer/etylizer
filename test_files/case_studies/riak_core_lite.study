%% field chring is chash:chash() or undefined, the spec says chash:chash()
{exception, riak_core_ring, chash, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/1
{exception, riak_core_ring, all_members, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, members, 2, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, active_members, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, ready_members, 1, [ignore], record_undefined}.
%% field chring is chash:chash() or undefined, given to chash:nodes/1
{exception, riak_core_ring, all_owners, 1, [ignore], record_undefined}.
%% field meta is dict:dict() or undefined, given to dict:to_list/1
{exception, riak_core_ring, equal_rings, 2, [ignore], record_undefined}.
%% field meta is dict:dict() or undefined, given to dict:find/2; behind it the branches {ok, _} on dict:find/2 are dead
%% (dict_types)
{exception, riak_core_ring, get_meta, 2, [ignore], record_undefined}.
%% field meta is dict:dict() or undefined, given to dict:fetch_keys/1; behind it the fold fun on {bucket, Bucket} never matches
{exception, riak_core_ring, get_buckets, 1, [ignore], record_undefined}.
%% {Idx, Owner} = lists:keyfind(Idx, 1, all_owners(State)), false for an index that is not in the ring (callers catch the
%% badmatch); with assert_pattern {_, _} the match stays open, Idx is bound
{exception, riak_core_ring, index_owner, 2, [ignore], bound_pattern}.
%% field chring is chash:chash() or undefined, given to chash:size/1 (a field access takes no assertion); in front of it
%% chash:size/1 is the length of a list, non_neg_integer(), where the spec promises pos_integer()
{exception, riak_core_ring, num_partitions, 1, [ignore], record_undefined}.
%% field chring is chash:chash() or undefined, CHRing goes to chash:size/1; in front of it chash:size/1 is non_neg_integer()
%% where the spec promises pos_integer()
{exception, riak_core_ring, future_num_partitions, 1, [ignore], record_undefined}.
%% field chring is chash:chash() or undefined, given to chash:successors/2
{exception, riak_core_ring, preflist, 2, [ignore], record_undefined}.
%% random_node/1: length(L) is non_neg_integer(), riak_core_rand:uniform/1 wants pos_integer(); L = all_members(State) is not
%% empty (length(L) itself, 382:38, crashes the engine with an assertion)
{assertion, riak_core_ring, {381, 9, "c04447"}, assert_type, "[node(), ...]", nonempty_list}.
%% random_other_index/1: hd(my_indices(State)) in the branch where no other node owns an index
{assertion, riak_core_ring, {394, 16, "5a1d7d"}, assert_type, "[chash:index_as_int(), ...]", nonempty_list}.
%% field chring is chash:chash() or undefined, Ring is the start value of the fold with chash:update/3; behind it
%% proplists:substitute_aliases/2 gives [term()] for orddict:from_list/1, and the fields members and seen can be undefined
{exception, riak_core_ring, rename_node, 3, [ignore], record_undefined}.
%% field chring is chash:chash() or undefined, given to chash:next_index/2
{exception, riak_core_ring, responsible_index, 2, [ignore], record_undefined}.
%% future_index/5: RingTop = trunc(math:pow(2, 160) - 1) is integer(), so the rem is integer() where the result is an index.
%% case OrigPos - OwnerPos of P when P < 0 -> ..; P -> ..: the first clause is reported as dead until the subject is annotated
%% integer()
{assertion, riak_core_ring, {541, 29, "d1c143"}, annotate_type, "integer()", guard_arith}.
{assertion, riak_core_ring, {560, 44, "f47c96"}, assert_type, "chash:index_as_int()", number_range}.
%% field chring is chash:chash() or undefined, given to chash:lookup/2
{exception, riak_core_ring, transfer_node, 3, [ignore], record_undefined}.
%% field meta is dict:dict() or undefined, given to dict:find/2; behind it the branch {ok, OldM} on dict:find/2 is dead
%% (dict_types)
{exception, riak_core_ring, update_meta, 3, [ignore], record_undefined}.
%% field meta is dict:dict() or undefined, given to dict:find/2; behind it the branch {ok, _} on dict:find/2 is dead
%% (dict_types)
{exception, riak_core_ring, remove_meta, 2, [ignore], record_undefined}.
%% field vclock is vclock:vclock() or undefined, given to vclock:increment/2
{exception, riak_core_ring, increment_vclock, 2, [ignore], record_undefined}.
%% field rvsn is vclock:vclock() or undefined, returned as vclock:vclock()
{exception, riak_core_ring, ring_version, 1, [ignore], record_undefined}.
%% field rvsn is vclock:vclock() or undefined, given to vclock:increment/2
{exception, riak_core_ring, increment_ring_version, 2, [ignore], record_undefined}.
%% field members is the orddict or undefined, the first clause gives it to the second
{exception, riak_core_ring, member_status, 2, [ignore], record_undefined}.
%% field members is the orddict or undefined, used as the generator of the comprehension
{exception, riak_core_ring, all_member_status, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to orddict:find/2
{exception, riak_core_ring, get_member_meta, 3, [ignore], record_undefined}.
%% field vclock is vclock:vclock() or undefined, given to vclock:increment/2
{exception, riak_core_ring, update_member_meta, 5, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to orddict:is_key/2
{exception, riak_core_ring, update_member_meta, 6, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to orddict:is_key/2
{exception, riak_core_ring, clear_member_meta, 3, [ignore], record_undefined}.
%% field vclock is vclock:vclock() or undefined, given to vclock:increment/2
{exception, riak_core_ring, set_member, 4, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to orddict:update/4
{exception, riak_core_ring, set_member, 5, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, claiming_members, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, down_members, 1, [ignore], record_undefined}.
%% catch error:{badmatch, _}; behind it the fun for lists:foldl/3 with the pattern {Idx, NewOwner} never matches
{exception, riak_core_ring, change_owners, 2, [ignore], catch_pattern}.
