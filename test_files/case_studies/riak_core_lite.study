#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% The Hex package riak_core_lite, version 0.10.1, which antidote (commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221) locks as its riak_core; both checksums of the downloaded
%% package are the ones in antidote's rebar.lock. Vendored unchanged: src (47 modules, without
%% riak_core.app.src), include and LICENSE. The directory is called riak_core, the name of the OTP
%% application, so that -include_lib("riak_core/include/riak_core_vnode.hrl") in other code resolves
%% from the directory of the manifests.
%%
%% Raw: no overlay, no flag, no assertion. 267 of the 1149 functions have a spec, the other 882 are
%% checked with dynamic() arguments and result.
%%
%% The driver defines no macro. So the code under -ifdef(TEST) (34 places), -ifdef(PROPER) and
%% -ifdef(PULSE) is not checked; riak_core_test_util has nothing else. riak_core:stop/1 is the
%% variant of -else (init:stop()), and the -ifndef(namespaced_types) of chashbin selects the first of
%% two identical declarations of the record chashbin.
%%
%% poolboy, the one dependency, is not vendored: 6 functions of riak_core_vnode_worker_pool call it.

{study, riak_core_lite}.
{deps, ["poolboy"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), benign (dead for the spec, kept on purpose), unknown.
%% The reasons of this step are from reading the place of the first error of each function.
{reason, unresolved_dep,      fixable,  "a module of another app is not on the search path of the driver"}.
{reason, otp_no_spec,         fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, unknown_type,        real,     "the record chashbin names the type erlang:tuple/1, which does not exist; internal error of the checker"}.
{reason, crash_follow_up,     fixable,  "internal error only in the run of the whole module, after a function with the unknown type"}.
{reason, catch_pattern,       fixable,  "a catch clause with a tuple pattern fails to type check"}.
{reason, guard_float,         fixable,  "a guard that compares a float() with an integer makes the next clause dead"}.
{reason, map_keys,            fixable,  "a map expression with two keys is rejected by a map type with these keys"}.
{reason, narrowing,           fixable,  "the type test on the left of andalso does not narrow the variable for the right"}.
{reason, library_spec,        fixable,  "spec of a library function too imprecise"}.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a match or a case inside the body"}.
{reason, partial,             inherent, "partial function, the callers rule out the missing case"}.
{reason, defensive,           benign,   "defensive clause, dead for the spec"}.
{reason, nonempty_list,       inherent, "hd/1, tl/1 or lists:nth/2 on a list that the program knows is not empty"}.
{reason, number_range,        inherent, "range of a number (positive, not negative) that the types do not show"}.
{reason, unchecked_result,    inherent, "a result that can be undefined or an error value, used as the success value"}.
{reason, untyped_value,       inherent, "term() from a proplist, a dict, ets, a persistent term, an rpc or a tuple(), used at the type the program expects"}.
{reason, call_reply,          inherent, "the reply of gen_server:call or gen_statem:call is term(), the spec promises the type of the reply"}.
{reason, deserialize,         inherent, "binary_to_term/1 gives term()"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, spec_wrong,          real,     "wrong type in the source"}.
{reason, source_bug,          real,     "error in the program"}.

{module, chash, #{file => "riak_core/src/chash.erl", timeout => 10000}}.
%% {IndexAsInt, X} = proplists:lookup(IndexAsInt, Nodes), which can give none
{exception, chash, lookup, 2, [ignore], body_exhaustiveness}.
{exception, chash, merge_rings, 2, [ignore], body_exhaustiveness}. % {NumPartitions, NodesB} = CHashB with NumPartitions bound
{exception, chash, predecessors, 3, [ignore], spec_imprecise}. % max_n/2 gives integer(), lists:split/2 wants non_neg_integer()
{exception, chash, ring_increment, 1, [ignore], number_range}. % div gives integer(), the spec says pos_integer()
{exception, chash, successors, 3, [ignore], spec_imprecise}. % max_n/2 gives integer(), lists:split/2 wants non_neg_integer()
{exception, chash, update, 3, [ignore], library_spec}. % lists:keyreplace/4 gives [tuple()]

