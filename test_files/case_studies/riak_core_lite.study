%% lists:keyfind/3 gives tuple() or false, next_owner_status/2 wants false or an entry of next
{exception, riak_core_ring, next_owner, 3, [ignore], library_spec}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, ring_ready, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2
{exception, riak_core_ring, ring_ready_info, 1, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to get_members/2; behind it {ok, FutureCHash} = resized_ring(State0), catch
%% error:{badmatch, _} and a fold fun for '$resize' entries only
{exception, riak_core_ring, future_ring, 2, [ignore], record_undefined}.
