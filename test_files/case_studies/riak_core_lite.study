%% field sock is port() or undefined for gen_tcp:send/2
{exception, riak_core_handoff_receiver, process_message, 3, [ignore], catch_pattern}.
{exception, riak_core_handoff_receiver, safe_peername, 2, [ignore], otp_no_spec}. % inet_parse:ntoa/1
