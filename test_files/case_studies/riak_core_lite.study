{module, riak_core_node_watcher, #{file => "riak_core/src/riak_core_node_watcher.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% service_up/2: the reply to {service_up, Id, Pid} is ok
{assertion, riak_core_node_watcher, {80, 5, "816bb5"}, assert_type, "ok", call_reply}.
%% service_up/4: the reply to {service_up, Id, Pid, MFA, Options} is ok
{assertion, riak_core_node_watcher, {129, 5, "95842a"}, assert_type, "ok", call_reply}.
%% suspend_health_checks/0: the reply to suspend_healths is ok or already_disabled
{assertion, riak_core_node_watcher, {144, 5, "48b118"}, assert_type, "ok | already_disabled", call_reply}.
%% resume_health_checks/0: the reply to resume_healths is ok or already_enabled
{assertion, riak_core_node_watcher, {147, 5, "f6e3aa"}, assert_type, "ok | already_enabled", call_reply}.
%% service_down/1: the reply to {service_down, Id} is ok
{assertion, riak_core_node_watcher, {150, 5, "812339"}, assert_type, "ok", call_reply}.
%% gen_server:call(.., infinitiy): the timeout is misspelled, and handle_call/3 has no clause for {service_down, Id,
%% health_check}. The error is reported for the whole call, whose reply is term() as well (call_reply)
{exception, riak_core_node_watcher, service_down, 2, [ignore], source_bug}.
%% node_up/0: the reply to {node_status, up} is ok
{assertion, riak_core_node_watcher, {158, 5, "227751"}, assert_type, "ok", call_reply}.
%% node_down/0: the reply to {node_status, down} is ok
{assertion, riak_core_node_watcher, {161, 5, "8fe794"}, assert_type, "ok", call_reply}.
%% services/0: the reply to services is the list of the services
{assertion, riak_core_node_watcher, {164, 5, "a75217"}, assert_type, "[atom()]", call_reply}.
%% init/1: ok = net_kernel:monitor_nodes(true). Behind it (?MODULE) = ets:new(..)
{assertion, riak_core_node_watcher, {200, 5, "ea27d2"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, riak_core_node_watcher, {202, 7, "a4d151"}, assert_pattern, "riak_core_node_watcher", result_by_args}.
%% case {State#state.status, Status} of {up, down}; {down, up}; {Status, Status}: the last pattern repeats the bound Status, the
%% case counts as not exhaustive. In front of it application:get_env/3 and proplists:get_value/3 give term(), and Status of
%% {node_status, Status} is term()
{exception, riak_core_node_watcher, handle_call, 3, [ignore], bound_pattern}.
%% handle_info/2: case erlang:get(Mref) of undefined -> ..; Id -> ..: the process dictionary gives term(), Id is the id of a
%% service
{assertion, riak_core_node_watcher, {336, 10, "8aa685"}, assert_type, "atom()", untyped_value}.
%% check_node_valid/1: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_node_watcher, {377, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% delete_service_mref/1: case erlang:get(Id) of undefined -> ..; Mref -> ..: the process dictionary gives term(), Mref is a
%% monitor
{assertion, riak_core_node_watcher, {397, 28, "a68427"}, assert_type, "reference()", untyped_value}.
%% schedule_broadcast/1: {ok, Interval} = application:get_env(riak_core, gossip_interval), which can give undefined and has
%% term() for the time of erlang:send_after/3
{assertion, riak_core_node_watcher, {414, 22, "3776f4"}, assert_type, "{ok, non_neg_integer()}", untyped_value}.
%% case ets:lookup(?MODULE, {by_node, Node}) of [{{by_node, Node}, Ss}]; []: the pattern repeats the bound Node, the case counts
%% as not exhaustive; ets:lookup/2 gives [tuple()]
{exception, riak_core_node_watcher, internal_get_services, 1, [ignore], bound_pattern}.
%% case ets:lookup(?MODULE, {by_service, Service}) of [{{by_service, Service}, Ns}]; []: the pattern repeats the bound Service,
%% the case counts as not exhaustive; ets:lookup/2 gives [tuple()]
{exception, riak_core_node_watcher, internal_get_nodes, 1, [ignore], bound_pattern}.
%% case InCheck#health_check.interval_tref of undefined -> ok; _ -> erlang:cancel_timer(InCheck#health_check.interval_tref): the
%% field is a reference() or undefined, and a field access takes no assertion
{exception, riak_core_node_watcher, health_fsm, 4, [ignore], narrowing}.
%% handle_fsm_exit/3: the clauses for true have the guards HPFails >= MaxHPFails and HPFails < MaxHPFails
{exception, riak_core_node_watcher, handle_fsm_exit, 3, [no_exhaustiveness], clause_guards}.
%% all_health_fsms/2: {ok, C1} = health_fsm(Msg, S, C): the answer to suspend and resume is always ok, the result type of
%% health_fsm/3 has up, down and remove too
{assertion, riak_core_node_watcher, {787, 12, "4e425d"}, assert_pattern, "{ok, _}", result_by_args}.
%% determine_time/2: trunc/1 gives integer(), the result is the time of erlang:send_after/3
{assertion, riak_core_node_watcher, {795, 5, "ef1535"}, assert_type, "non_neg_integer()", arith_range}.

{module, riak_core_node_watcher_events, #{file => "riak_core/src/riak_core_node_watcher_events.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% add_callback/1: gen_event:add_handler/3 gives term(), the reply depends on init/1 of the handler; for this module it is ok,
%% or {'EXIT', Reason} if the callback fails
{assertion, riak_core_node_watcher_events, {55, 5, "3c9db6"}, assert_type, "ok | {'EXIT', term()}", call_reply}.
%% add_sup_callback/1: gen_event:add_sup_handler/3 gives term(), the reply depends on init/1 of the handler; for this module it
%% is ok, or {'EXIT', Reason} if the callback fails
{assertion, riak_core_node_watcher_events, {59, 5, "cb6fa1"}, assert_type, "ok | {'EXIT', term()}", call_reply}.
%% the clause takes a list of exactly one element, [Fn], as add_callback/1, add_sup_callback/1 and add_guarded_callback/1 pass
%% it
{exception, riak_core_node_watcher_events, init, 1, [no_exhaustiveness], partial}.

{module, riak_core_priority_queue, #{file => "riak_core/src/riak_core_priority_queue.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% is_queue({pqueue, [x]}) fails in the fun on {P, Q} instead of giving false
{exception, riak_core_priority_queue, is_queue, 1, [ignore], source_bug}.
%% in/2 gives pqueue() for the squeue() of a priority, the entry {P, in(X, Q)} needs an squeue(); see join/2
{exception, riak_core_priority_queue, in, 3, [ignore], spec_imprecise}.
%% out/1 gives pqueue() for the rest of the squeue() of a priority, the entry {P, Q1} needs an squeue() (see join/2); in front
%% of it no clause for {pqueue, []} and [V | Out] = lists:reverse(In, [])
{exception, riak_core_priority_queue, out, 1, [ignore], source_bug}.
{exception, riak_core_priority_queue, out, 2, [no_exhaustiveness], partial}. % no clause for {pqueue, []}
%% out/1 gives pqueue() for the rest of the squeue() of a priority, the entry {P, Q1} needs an squeue() (see join/2); in front
%% of it no clause for {pqueue, []} and {{value, V}, Q1} = out(Q)
{exception, riak_core_priority_queue, pout, 1, [ignore], source_bug}.
%% join/2 says pqueue() for the join of two squeue()s, which the queue of a priority is. The overloaded spec (squeue(),
%% squeue()) -> squeue(); (pqueue(), pqueue()) -> pqueue() type checks join/2 and merge/3, but join/2 then takes the checker 32
%% seconds (the timeout is 10), so the spec is left as it is
{exception, riak_core_priority_queue, join, 2, [ignore], spec_imprecise}.
%% join/2 gives pqueue(), the queue of a priority is an squeue(); see join/2
{exception, riak_core_priority_queue, merge, 3, [ignore], spec_imprecise}.

