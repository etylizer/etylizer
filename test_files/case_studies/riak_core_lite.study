{exception, riak_core_vnode_manager, transform_repair_records, 1, [ignore], library_spec}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, riak_core_vnode_manager, maybe_create_repair, 7, [ignore], body_exhaustiveness}.
%% Partition and Mod of {Partition, Mod, start_vnode} are term(), get_vnode/3 takes an index and a module; the other requests
%% have the same. Behind it {ok, Ring} = riak_core_ring_manager:get_my_ring() (434)
{exception, riak_core_vnode_manager, handle_cast, 2, [ignore], message_term}.
%% case ets:lookup(T, {Idx, Mod}) of [I]; []: ets:lookup/2 gives [tuple()], the table is a set with at most one object for a
%% key; behind it I#idxrec.pid on a tuple()
{exception, riak_core_vnode_manager, idx2vnode, 3, [ignore], untyped_value}.
%% case ets:lookup(T, MonRef) of [#monrec{key = {Index, Mod}}]; []: ets:lookup/2 gives [tuple()]; behind it Mod and Index of the
%% record go to unregister_vnode_stats/2 as term()
{exception, riak_core_vnode_manager, delmon, 2, [ignore], untyped_value}.
%% [Result] = get_vnode([Idx], Mod, State): a list of one index gives a list of one pid. The overlay spec has two branches, this
%% is the one for a single index. Behind it in the branch for a list: {ok, Pid} = riak_core_vnode_sup:start_vnode(..) (633), and
%% riak_core_util:pmap/3 says list(), dict:from_list/1 wants pairs (649)
{exception, riak_core_vnode_manager, get_vnode, 3, [ignore], body_exhaustiveness}.
%% case dict:find({Mod, Idx}, Fwd) of {ok, ForwardTo}: the branch is dead
{exception, riak_core_vnode_manager, get_forward, 3, [ignore], dict_types}.
%% case dict:find({Mod, Index}, Completed) of {ok, NextOwner}: the branch is dead
{exception, riak_core_vnode_manager, check_forward_precomputed, 5, [ignore], dict_types}.
%% the fun of dict:fold/3 takes the key as {Mod, Idx}, the clause is dead; the same fun with orddict:fold/3 type checks
{exception, riak_core_vnode_manager, update_forwarding, 4, [ignore], dict_types}.
%% case dict:find({Mod, Idx}, VNodes) of {ok, Pid}: the branch is dead
{exception, riak_core_vnode_manager, change_forward, 4, [ignore], dict_types}.
%% lists:flatten/1 gives [term()], dict:from_list/1 wants pairs
{exception, riak_core_vnode_manager, update_handoff, 4, [ignore], library_spec}.
%% {true, Type, TargetNode} with all four vnode types: only a primary and a fallback get a target node from
%% determine_handoff_target/5, which is what the case in update_handoff/4 expects
{exception, riak_core_vnode_manager, should_handoff, 4, [ignore], correlated}.
%% lists:keysearch/3 gives {value, tuple()} or false, the case matches {value, {App, Mod}}; the list is the term() of
%% application:get_env/2 and Mod is bound in the pattern
{exception, riak_core_vnode_manager, app_for_vnode_module, 1, [ignore], library_spec}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, riak_core_vnode_manager, maybe_trigger_handoff, 4, [ignore], body_exhaustiveness}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring()
{exception, riak_core_vnode_manager, get_all_vnodes_status, 1, [ignore], body_exhaustiveness}.
%% ordsets:subtract/2 gives ordset(_), so Idx of {Idx, Mod} is term(); the field never_started has partition()
{exception, riak_core_vnode_manager, update_never_started, 3, [ignore], library_spec}.
%% lists:foldl/3 with a fun on a record, fun (R = #repair{..}, Repairs2)
{exception, riak_core_vnode_manager, check_repairs, 1, [ignore], free_result}.
%% [_, Before] = chash:predecessors(.., 2) and [After] = chash:successors(.., 1)
{exception, riak_core_vnode_manager, repair_pairs, 2, [ignore], body_exhaustiveness}.
{exception, riak_core_vnode_manager, get_repair, 2, [ignore], library_spec}. % lists:keyfind/3 gives tuple()
{exception, riak_core_vnode_manager, remove_repair, 2, [ignore], library_spec}. % lists:keydelete/3 gives [tuple()]
{exception, riak_core_vnode_manager, replace_repair, 2, [ignore], library_spec}. % lists:keyreplace/4 gives [tuple()]
%% the clause takes a list of exactly three pairs, which is what repair_pairs/2 builds
{exception, riak_core_vnode_manager, get_minus_one, 1, [ignore], partial}.
%% the clause takes a list of exactly three pairs, which is what repair_pairs/2 builds
{exception, riak_core_vnode_manager, get_plus_one, 1, [ignore], partial}.

{module, riak_core_vnode_master, #{file => "riak_core/src/riak_core_vnode_master.erl",
