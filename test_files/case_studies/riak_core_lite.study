%% no clause for a list of vnodes with a sender that is not a triple (ignore); the only caller passes one vnode
{exception, riak_core_vnode_master, coverage, 5, [ignore], partial}.
%% the head takes a list of four elements, a list type does not say its length; start_link/3 passes four atoms; nothing behind
%% it
{exception, riak_core_vnode_master, init, 1, [ignore], partial}.
