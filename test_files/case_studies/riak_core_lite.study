%% responsible_preflists/1: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_util, {916, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, riak_core_util, {960, 15, "3291b4"}, assert_type, "[{atom(), term()}]", untyped_value}. % determine_all_n/1: application:get_env/3
%% determine_all_n/1: the fold collects proplists:get_value(n_val, Props), which is term()
{assertion, riak_core_util, {963, 12, "f75f2c"}, assert_type, "[pos_integer(), ...]", untyped_value}.

{module, riak_core_vnode, #{file => "riak_core/src/riak_core_vnode.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% init/1: the head takes a list of four elements, [Mod, Index, InitialInactivityTimeout, Forward], as start_link/4 passes it; a
%% list type has one type for all elements, each is used at the type of its position
{assertion, riak_core_vnode, {262, 28, "678afd"}, assert_type, "partition()", arg_list}.
{assertion, riak_core_vnode, {262, 41, "91f447"}, assert_type, "module()", arg_list}.
{assertion, riak_core_vnode, {263, 30, "80f93a"}, assert_type, "node() | [{partition(), node()}]", arg_list}.
{assertion, riak_core_vnode, {264, 41, "9d874a"}, assert_type, "non_neg_integer()", arg_list}.
{exception, riak_core_vnode, init, 1, [no_exhaustiveness], partial}.
%% riak_core_vnode_worker_pool:start_link/5 gets the atom worker_props (305) where the callback init_worker/3 of
%% riak_core_vnode_worker declares the properties as [{atom(), term()}]; in front of it Props of Mod:init/1 and so the pool
%% configuration are term()
{exception, riak_core_vnode, do_init, 1, [ignore], source_bug}.
%% wait_for_init/1: gen_fsm_compat:sync_send_event/3 gives term(), the reply of started/3 and active/3 is ok
{assertion, riak_core_vnode, {323, 5, "263e09"}, assert_type, "ok", call_reply}.
%% get_mod_index/1: gen_fsm_compat:sync_send_all_state_event/2 gives term(), the reply to get_mod_index is {Mod, Index}
{assertion, riak_core_vnode, {331, 5, "20afc9"}, assert_type, "{module(), riak_core_vnode:partition()}", call_reply}.
%% core_status/1: gen_fsm_compat:sync_send_all_state_event/2 gives term(), the reply to core_status is {Mode, Status}
{assertion, riak_core_vnode, {352, 5, "cb85ff"}, assert_type, "overlay_riak_core_lite:vn_core_status()", call_reply}.
%% forward_or_vnode_command/3: {ok, R} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_vnode, {410, 11, "ab210d"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% field pool_pid is pid() or undefined, riak_core_vnode_worker_pool:handle_work/3 takes a pid() (see vnode_coverage/4); in
%% front of it case catch Mod:handle_command(..), the catch gives term()
{exception, riak_core_vnode, vnode_command, 3, [ignore], record_undefined}.
%% field pool_pid is pid() or undefined, riak_core_vnode_worker_pool:handle_work/3 takes a pid(); the field really is undefined
%% for a vnode module without a pool, {async, ..} from such a module is dropped silently by gen_statem:cast(undefined, _)
{exception, riak_core_vnode, vnode_coverage, 4, [ignore], record_undefined}.
%% field pool_pid is pid() or undefined, riak_core_vnode_worker_pool:handle_work/3 takes a pid(); the field really is undefined
%% for a vnode module without a pool, {async, ..} from such a module is dropped silently by gen_statem:cast(undefined, _)
{exception, riak_core_vnode, vnode_handoff_command, 4, [ignore], record_undefined}.
%% forward_request/6: the third clause gives the handoff target (none or a pair) to vnode_forward/5, which takes the pair; with
%% a handoff type other than resize and undefined the state has a target, the two fields are set together
{assertion, riak_core_vnode, {524, 29, "f249cb"}, assert_type, "{partition(), node()}", correlated}.
%% case lists:keyfind(FutureIndex, 1, Forward) of false; {FutureIndex, FutureOwner}: the pattern repeats the bound FutureIndex,
%% the case counts as not exhaustive. In front of it the one clause with the guard is_list(Forward), the field forward can be a
%% node
{exception, riak_core_vnode, vnode_resize_command, 4, [ignore], bound_pattern}.
%% active/2: {ok, R} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_vnode, {577, 11, "ab210d"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% {ok, NewRing} -> NewRing = NewRing (732), a match with the bound NewRing that counts as not exhaustive; in front of it the
%% clause for a handoff that is not a resize takes SeenIdxs == [] and a target with the own index
{exception, riak_core_vnode, mark_handoff_complete, 5, [ignore], bound_pattern}.
%% field handoff_type is ho_type() or undefined, mark_handoff_complete/5 takes a ho_type(); in front of it the field
%% handoff_target is none or {partition(), node()}, the callers check the target for none or set it
{exception, riak_core_vnode, finish_handoff, 2, [ignore], record_undefined}.
%% maybe_shutdown_pool/1: case is_pid(Pool) of true -> .. does not narrow Pool (pid() or undefined) for
%% riak_core_vnode_worker_pool:shutdown_pool/2; the type test is the subject of a case here, not the left of andalso
{assertion, riak_core_vnode, {796, 53, "12d170"}, assert_type, "pid()", narrowing}.
%% riak_core_vnode_worker_pool:start_link/5 gets the atom worker_props (982) as in do_init/1; in front of it From of
%% {'$vnode_proxy_ping', From, Ref, Msgs} is term() for riak_core_vnode_proxy:cast/2, and the field pool_config is tuple() or
%% undefined for the match with {pool, WorkerModule, PoolSize, WorkerArgs}
{exception, riak_core_vnode, handle_info, 3, [ignore], source_bug}.
%% is_pid(Pool) andalso is_process_alive(Pool) with pool_pid pid() or undefined; behind it is_tuple(R) andalso element(1, R) ==
%% shutdown in ?NORMAL_REASON: the macro puts its four uses of Reason at one position (1037:63), an assertion there would say
%% tuple() for all of them
{exception, riak_core_vnode, terminate, 3, [ignore], narrowing}.
%% maybe_handoff/3: is_pid(HPid) andalso is_process_alive(HPid) with handoff_pid pid() or undefined; behind it {ok, R} =
%% riak_core_ring_manager:get_my_ring()
{assertion, riak_core_vnode, {1071, 37, "d6b399"}, assert_type, "pid()", narrowing}.
{assertion, riak_core_vnode, {1083, 11, "ab210d"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% reply/2: the clause {server, undefined, From} also takes the placeholder {server, undefined, undefined} that
%% riak_core_vnode_master puts into a request and replaces by the From of the call before a vnode sees it;
%% riak_core_send_msg:reply_unreliable/2 takes a From
{assertion, riak_core_vnode, {1149, 41, "47e66f"}, assert_type, "{pid(), term()}", partial}.
%% no clause for the placeholder {server, undefined, undefined} of riak_core_vnode_master, see reply/2
{exception, riak_core_vnode, monitor, 1, [no_exhaustiveness], partial}.
%% {_StateName, State} = gen_fsm_compat:sync_send_all_state_event(Pid, current_state), the reply is term(): the call (1221:9)
%% and the variable State (1223:6, 1223:23) crash the engine with an assertion
{exception, riak_core_vnode, get_modstate, 1, [ignore], assertion_crash}.

{module, riak_core_vnode_manager, #{file => "riak_core/src/riak_core_vnode_manager.erl", timeout => 10000,
