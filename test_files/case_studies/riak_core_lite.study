%% it
{exception, riak_core_vnode_master, init, 1, [no_exhaustiveness], partial}.
%% field index of #riak_vnode_req_v1{} is partition() or undefined, riak_core_vnode_proxy:reg_name/3 takes a partition()
{exception, riak_core_vnode_master, do_proxy_cast, 3, [ignore], record_undefined}.
