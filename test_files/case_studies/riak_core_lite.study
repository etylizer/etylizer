{module, riak_core_claimant, #{file => "riak_core/src/riak_core_claimant.erl",
                             overlays => [{specs, "overlay_riak_core_lite.erl"}], timeout => 10000}}.
%% gen_server:call/3 gives term(), the reply of plan is the result of generate_plan/2 or {error, ring_not_ready}
{exception, riak_core_claimant, plan, 0, [ignore], call_reply}.
%% gen_server:call/3 gives term(), the reply of commit is ok, {error, Reason} or the bare atom error (commit_staged/1 line 278)
{exception, riak_core_claimant, commit, 0, [ignore], call_reply}.
{exception, riak_core_claimant, clear, 0, [ignore], call_reply}. % gen_server:call/3 gives term(), the reply of clear is ok
%% gen_server:call/3 gives term(), the reply of stage is ok or {error, atom()}
{exception, riak_core_claimant, stage, 2, [ignore], call_reply}.
%% {ok, Ring} = riak_core_ring_manager:get_my_ring(), which can be {error, no_ring}
{exception, riak_core_claimant, claimant, 0, [ignore], body_exhaustiveness}.
%% Node and Action of the request {stage, Node, Action} are term(), maybe_stage/4 wants a node and an action
{exception, riak_core_claimant, handle_call, 3, [ignore], message_term}.
{exception, riak_core_claimant, generate_plan, 2, [ignore], library_spec}. % lists:ukeysort/2 gives [tuple()]
%% hd(NextRings), compute_all_next_rings/4 always gives at least one transition
{exception, riak_core_claimant, generate_plan, 3, [ignore], nonempty_list}.
%% PlannedRing is the field next_ring, riak_core_ring() or undefined; commit_staged/1 lets only a state with a planned ring
%% through. The field really is undefined when nothing is planned
{exception, riak_core_claimant, maybe_commit_staged, 3, [ignore], partial}.
%% the only clause wants no staged changes ([]), valid_request/4 passes all of them: resize_ring/1 while a change is staged is a
%% function_clause in the server. Behind it the case at 444 without {true, 0, false}
{exception, riak_core_claimant, valid_resize_request, 3, [ignore], source_bug}.
%% {_, {Change, Node}} with the filter Change == replace or force_replace: Node stays node() or the integer() of {resize,
%% integer()}
{exception, riak_core_claimant, existing_replacements, 1, [ignore], correlated}.
%% catch error:{badmatch, false}; behind it the fun of lists:foldl/3 as in apply_changes/2
{exception, riak_core_claimant, compute_resize, 2, [ignore], catch_pattern}.
%% hd(riak_core_ring:preflist(Key, Resized)), a ring has at least one partition; the same for hd(chash:predecessors(..)) at 641
{exception, riak_core_claimant, schedule_first_resize_transfer, 4, [ignore], nonempty_list}.
%% lists:foldl/3 of OTP: the argument types of the fun are variables bound only in when, so the pattern {Node, Cmd} in the fun
%% head is dead
{exception, riak_core_claimant, apply_changes, 2, [ignore], free_result}.
%% ordsets:intersection/2 gives ordset(term()), the element goes to refresh_ring/2 as a node
{exception, riak_core_claimant, inform_removed_nodes, 3, [ignore], library_spec}.
%% NextClaimant = hd(Members ++ [undefined]): the result of hd/1 of OTP is a variable bound only in when, the clause {true,
%% Node} is dead
{exception, riak_core_claimant, maybe_update_claimant, 2, [ignore], free_result}.
%% ordsets:subtract/2 gives ordset(term()), the element goes to Log as {index, owner, next owner}
{exception, riak_core_claimant, update_ring, 6, [ignore], library_spec}.
%% lists:foldl/3 of OTP: the argument types of the fun are variables bound only in when, so the pattern {Idx, _, _, _, _} in the
%% fun head is dead
{exception, riak_core_claimant, transfer_ownership, 2, [ignore], free_result}.
%% riak_core_rand:uniform(length(Active)): Active is the active members without the leaving owner, empty if all other members
%% are down, and uniform(0) is a function_clause
{exception, riak_core_claimant, handle_down_nodes, 2, [ignore], source_bug}.
%% lists:ukeysort/2 gives [tuple()], riak_core_ring:set_pending_changes/2 takes the entries of next
{exception, riak_core_claimant, remove_node, 7, [ignore], library_spec}.
%% {ok, FutureCHash} = riak_core_ring:resized_ring(CState1), undefined if the ring is not resized; change/2 calls only if
%% is_resizing/1
{exception, riak_core_claimant, replace_node_during_resize, 4, [ignore], body_exhaustiveness}.
%% the kind (first argument) decides the data: ownership and reassign come with a ring, next with a node; a fun type for Log has
%% only the union, so CState is a ring or a node
{exception, riak_core_claimant, log, 2, [ignore], correlated}.

