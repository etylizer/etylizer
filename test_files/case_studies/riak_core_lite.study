{assertion, riak_core_vnode_manager, {428, 30, "91f447"}, assert_type, "module()", message_term}.
{assertion, riak_core_vnode_manager, {434, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
{assertion, riak_core_vnode_manager, {435, 33, "91f447"}, assert_type, "module()", message_term}.
{assertion, riak_core_vnode_manager, {435, 38, "678afd"}, assert_type, "partition()", message_term}.
{assertion, riak_core_vnode_manager, {438, 32, "91f447"}, assert_type, "module()", message_term}.
{assertion, riak_core_vnode_manager, {438, 37, "678afd"}, assert_type, "partition()", message_term}.
{assertion, riak_core_vnode_manager, {439, 44, "91f447"}, assert_type, "module()", message_term}.
{assertion, riak_core_vnode_manager, {439, 49, "678afd"}, assert_type, "partition()", message_term}.
{assertion, riak_core_vnode_manager, {439, 56, "9591bb"}, assert_type, "pid()", message_term}.
{assertion, riak_core_vnode_manager, {443, 24, "438d47"}, assert_type, "inactive | handoff_complete | handoff_error", message_term}.
{assertion, riak_core_vnode_manager, {443, 31, "91f447"}, assert_type, "module()", message_term}.
{assertion, riak_core_vnode_manager, {443, 36, "d20ab8"}, assert_type, "partition()", message_term}.
{assertion, riak_core_vnode_manager, {443, 41, "9591bb"}, assert_type, "pid()", message_term}.
{assertion, riak_core_vnode_manager, {453, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% idx2vnode/3: case ets:lookup(T, {Idx, Mod}) of [I]; []: ets:lookup/2 gives [tuple()], the table is a set with at most one
%% object for a key; the record idxrec has no field types, I#idxrec.pid is term()
{assertion, riak_core_vnode_manager, {596, 5, "949720"}, assert_type, "pid() | no_match", untyped_value}.
{assertion, riak_core_vnode_manager, {596, 10, "67b4f8"}, assert_type, "[] | etylizer:cons(#idxrec{}, [])", untyped_value}.
%% delmon/2: case ets:lookup(T, MonRef) of [#monrec{key = {Index, Mod}}]; []: ets:lookup/2 gives [tuple()], the table is a set
%% with at most one object for a key, and the record monrec has no field types
{assertion, riak_core_vnode_manager, {603, 10, "1f73b0"}, assert_type, "[] | etylizer:cons({monrec, reference(), {partition(), module()}}, [])", untyped_value}.
%% the guard not is_list(Idx) of the first clause does not keep the second clause, which takes a list of indices, from being
%% checked for the branch of the overlay spec with one index. In front of it [Result] = get_vnode([Idx], Mod, State); behind it
%% {ok, Pid} = riak_core_vnode_sup:start_vnode(..) (633), and riak_core_util:pmap/3 says list(), dict:from_list/1 wants pairs
%% (649)
{exception, riak_core_vnode_manager, get_vnode, 3, [ignore], narrowing}.
%% get_forward/3: case dict:find({Mod, Idx}, Fwd) of {ok, ForwardTo}: the value of the dict is term()
{assertion, riak_core_vnode_manager, {663, 26, "ccaa47"}, assert_type, "overlay_riak_core_lite:vm_forward()", dict_types}.
%% check_forward_precomputed/5: case dict:find({Mod, Index}, Completed) of {ok, NextOwner}: the value of the dict is term()
{assertion, riak_core_vnode_manager, {690, 41, "8d7969"}, assert_type, "overlay_riak_core_lite:vm_forward()", dict_types}.
%% update_forwarding/4: the fun of dict:fold/3 takes the key as {Mod, Idx} and the value as the forward, the dict has term():
%% annotated with its type and cast to the fun type of dict:fold/3
{assertion, riak_core_vnode_manager, {718, 15, "d99bdb"}, assert_type, "fun((term(), term(), ok) -> ok)", dict_types}.
{assertion, riak_core_vnode_manager, {718, 15, "d99bdb"}, annotate_type, "fun(({module(), partition()}, overlay_riak_core_lite:vm_forward(), ok) -> ok)", dict_types}.
%% change_forward/4: case dict:find({Mod, Idx}, VNodes) of {ok, Pid}: the value of the dict is term()
{assertion, riak_core_vnode_manager, {735, 42, "9591bb"}, assert_type, "pid()", dict_types}.
%% should_handoff/4: {true, Type, TargetNode} with all four vnode types: only a primary and a fallback get a target node from
%% determine_handoff_target/5, which is what the case in update_handoff/4 expects
{assertion, riak_core_vnode_manager, {783, 27, "f1964a"}, assert_type, "{true, primary | {fallback, node()}, node()}", narrowing}.
%% case lists:keysearch(Mod, 2, Mods) of {value, {App, Mod}}; false: the pattern repeats the bound Mod, the case counts as not
%% exhaustive; Mods is the term() of application:get_env/2
{exception, riak_core_vnode_manager, app_for_vnode_module, 1, [ignore], bound_pattern}.
%% maybe_trigger_handoff/4: case dict:find({Mod, Idx}, HO) of {ok, {resize, _, '$resize'}}; {ok, {delete, local, '$delete'}};
%% {ok, {_, _, TargetNode}}; error: the value of the dict is term(). {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_vnode_manager, {847, 10, "af2adf"}, assert_type, "error | {ok, {atom(), atom(), node() | '$resize' | '$delete'}}", dict_types}.
{assertion, riak_core_vnode_manager, {849, 24, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% MergeFn = fun (_, V1, V2) when is_list(V1) and is_list(V2) -> V1 ++ V2; ..: without an annotation its clauses are reported as
%% dead, with one the guard does not narrow V1 and V2 for ++. In front of it {ok, Ring} = riak_core_ring_manager:get_my_ring();
%% the values of the dicts are term()
{exception, riak_core_vnode_manager, get_all_vnodes_status, 1, [ignore], in_fun}.
%% repair_pairs/2: [_, Before] = chash:predecessors(.., 2) and [After] = chash:successors(.., 1)
{assertion, riak_core_vnode_manager, {1012, 5, "4e82eb"}, assert_pattern, "[_, _]", body_exhaustiveness}.
{assertion, riak_core_vnode_manager, {1014, 5, "978b26"}, assert_pattern, "[_]", body_exhaustiveness}.
%% the clause takes a list of exactly three pairs, which is what repair_pairs/2 builds
{exception, riak_core_vnode_manager, get_minus_one, 1, [no_exhaustiveness], partial}.
%% the clause takes a list of exactly three pairs, which is what repair_pairs/2 builds
{exception, riak_core_vnode_manager, get_plus_one, 1, [no_exhaustiveness], partial}.
{assertion, riak_core_vnode_manager, {559, 22, "ce4a50"}, assert_type, "non_neg_integer()", untyped_value}. % schedule_management_timer/0: application:get_env/3
{assertion, riak_core_vnode_manager, {578, 13, "c0626f"}, assert_type, "non_neg_integer()", untyped_value}. % limit_ownership_handoff/2: application:get_env/3

{module, riak_core_vnode_master, #{file => "riak_core/src/riak_core_vnode_master.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% coverage/5: no clause for a list of vnodes with a sender that is not a triple (ignore); the only caller passes one vnode.
%% {Type, {Ref, {Index, Node}}, From} is a sender() again: Type decides the shape of From
{assertion, riak_core_vnode_master, {121, 39, "b5ab11"}, assert_type, "sender()", union_elimination}.
{exception, riak_core_vnode_master, coverage, 5, [no_exhaustiveness], partial}.
