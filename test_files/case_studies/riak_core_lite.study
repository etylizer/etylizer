{assertion, riak_core_handoff_manager, {214, 37, "4e93ad"}, assert_type, "pid() | undefined", untyped_value}.
%% the guard X == max_concurrency orelse element(1, X) == shutdown andalso element(2, X) == max_concurrency on a term(), and
%% is_pid(Vnode) on the left of andalso: a guard takes no assertion
{exception, riak_core_handoff_manager, handle_info, 2, [ignore], narrowing}.
