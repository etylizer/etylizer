{exception, chashbin, to_chash, 1, [ignore], unknown_type}.
{exception, chashbin, to_list, 1, [ignore], unknown_type}.
{exception, chashbin, to_list_filter, 2, [ignore], unknown_type}.
{exception, chashbin, responsible_index, 2, [ignore], unknown_type}.
{exception, chashbin, responsible_position, 2, [ignore], unknown_type}.
{exception, chashbin, num_partitions, 1, [ignore], unknown_type}.
{exception, chashbin, iterator, 2, [ignore], unknown_type}.
{exception, chashbin, itr_value, 1, [ignore], unknown_type}.
{exception, chashbin, itr_next, 1, [ignore], unknown_type}.
{exception, chashbin, itr_pop, 2, [ignore], unknown_type}.
{exception, chashbin, itr_next_while, 2, [ignore], unknown_type}.
{exception, chashbin, create_bin, 3, [ignore], crash_follow_up}. % alone: an expression fails to type check
{exception, chashbin, index_position, 2, [ignore], crash_follow_up}. % alone it type checks

