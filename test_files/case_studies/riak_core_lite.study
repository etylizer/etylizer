%% {ok, Interval} = application:get_env(..)
{exception, riak_core_node_watcher, schedule_broadcast, 1, [ignore], body_exhaustiveness}.
%% ordsets:subtract/2 gives ordset(_), the services in it are atoms
{exception, riak_core_node_watcher, node_update, 2, [ignore], library_spec}.
%% ordsets:subtract/2 gives ordset(_), the peers in it are nodes
{exception, riak_core_node_watcher, peers_update, 2, [ignore], library_spec}.
{exception, riak_core_node_watcher, internal_get_services, 1, [ignore], untyped_value}. % ets:lookup/2
{exception, riak_core_node_watcher, internal_get_nodes, 1, [ignore], untyped_value}. % ets:lookup/2
%% case InCheck#health_check.interval_tref of undefined -> ok; _ -> erlang:cancel_timer(InCheck#health_check.interval_tref): the
