{module, riak_core_priority_queue, #{file => "riak_core/src/riak_core_priority_queue.erl",
                                   overlays => [{specs, "overlay_riak_core_lite.erl"}], timeout => 10000}}.
%% is_queue({pqueue, [x]}) fails in the fun on {P, Q} instead of giving false
{exception, riak_core_priority_queue, is_queue, 1, [ignore], source_bug}.
{exception, riak_core_priority_queue, len, 1, [ignore], library_spec}. % lists:sum/1 gives number()
{exception, riak_core_priority_queue, in, 3, [ignore], library_spec}. % lists:keysearch/3 gives {value, tuple()} | false
{exception, riak_core_priority_queue, out, 1, [ignore], partial}. % no clause for {pqueue, []}
{exception, riak_core_priority_queue, out, 2, [ignore], partial}. % no clause for {pqueue, []}
{exception, riak_core_priority_queue, pout, 1, [ignore], partial}. % no clause for {pqueue, []}
%% join/2 says pqueue() for the join of two squeue()s, which the queue of a priority is. The overloaded spec (squeue(),
%% squeue()) -> squeue(); (pqueue(), pqueue()) -> pqueue() type checks join/2 and merge/3, but join/2 then takes the checker 32
%% seconds (the timeout is 10), so the spec is left as it is
{exception, riak_core_priority_queue, join, 2, [ignore], spec_imprecise}.
%% join/2 gives pqueue(), the queue of a priority is an squeue(); see join/2
{exception, riak_core_priority_queue, merge, 3, [ignore], spec_imprecise}.

