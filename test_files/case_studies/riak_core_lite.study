#!/usr/bin/env -S sh -c 'exec "$(dirname "$0")/../../.github/scripts/ety_case_study" "$0" "$@"'
%% -*- erlang -*-
%% Case study manifest, see .github/scripts/ety_case_study.
%%
%% The Hex package riak_core_lite, version 0.10.1, which antidote (commit
%% ed9cfbcaad53c9b5de15bfcef7befef44b5b4221) locks as its riak_core; both checksums of the downloaded
%% package are the ones in antidote's rebar.lock. Vendored: src (47 modules, without riak_core.app.src),
%% include and LICENSE. The code is unchanged; declarations (-type, -spec, record field types,
%% -export_type) that were wrong or too imprecise are corrected, see the list below. The directory is
%% called riak_core, the name of the OTP application, so that
%% -include_lib("riak_core/include/riak_core_vnode.hrl") in other code resolves from the directory of
%% the manifests.
%%
%% 267 of the 1149 functions have a spec in the source. overlay_riak_core_lite.erl gives a spec to each
%% of the other 882. Every module is checked with the whole overlay, so that a call into another
%% module of the package is checked against the spec of the callee.
%%
%% Library specs, flags and assertions (step IV). 944 functions type check as they are, 32 with a flag
%% (27 without the exhaustiveness check of their clauses, 5 without the redundancy check), 173 are
%% ignored; 359 assertions (286 assert_type, 69 assert_pattern, 4 annotate_type) in 39 modules. Each
%% flag and each assertion is needed: without it exactly its function fails.
%%   overlay_riak_core_lite_lib.erl, for all modules, has specs for functions of OTP whose spec says too
%%     little: the key functions of lists, lists:foldl/3, foldr/3, mapfoldl/3, seq/2,3, sum/1 and
%%     flatten/1, ordsets:subtract/2 and intersection/2, max/2, min/2, length/1, integer_to_list/1,
%%     crypto:hash/2, filename:join/2, string:to_lower/1 and erl_posix_msg:message/1. Where OTP gives a
%%     result as a type variable that is bound only in when, and that so fits every type, it says term():
%%     hd/1, tl/1, erlang:get/1, application:get_env/2,3, get_key/2 and start/1, and dict:find/2, fetch/2,
%%     fetch_keys/1, to_list/1, fold/3 and merge/3 (the parameters of dict:dict(K, V) do not appear in
%%     the definition of the type). overlay_riak_core_lite_lib_gen.erl, for gen_fsm_compat, has
%%     gen:start/5,6 and sys:handle_debug/4.
%%   With term() for these results 14 functions that type checked before need an assertion for a value
%%     of the application environment or of a dict, and two others turn out to be wrong:
%%     riak_core_ring:fresh/1 (the assertion crashes the engine) and
%%     riak_core_ring_manager:do_write_ringfile/1 (a deep list as file name). The overlay is on every
%%     module, also on the 26 where it changes no verdict.
%%   An assertion is an unchecked cast (assert_type, assert_pattern) of a value whose type the checker
%%     cannot know; the 4 annotate_type are checked. A function that also has a real error (class real)
%%     gets no assertion and stays ignored.
%%   Not finished: 12 functions of riak_core_claim, 6 of riak_core_claim_util and
%%     riak_core_handoff_sender:start_fold_/8 (reason not_finished).
%%
%% The driver defines no macro. So the code under -ifdef(TEST) (34 places), -ifdef(PROPER) and
%% -ifdef(PULSE) is not checked; riak_core_test_util has nothing else. riak_core:stop/1 is the
%% variant of -else (init:stop()), and the -ifndef(namespaced_types) of chashbin selects the first of
%% two identical declarations of the record chashbin.
%%
%% poolboy, the one dependency, is a case study of its own; the driver finds its source there. Its 6
%% callers in riak_core_vnode_worker_pool are checked since it does: terminate/3 type checks, the other
%% five are not finished (reason not_finished, with their first error).
%%
%% Declarations corrected in the source: 104 in 19 modules and the 2 headers, old -> new. Only -type,
%% -spec, -export_type and the types of record fields; no function body, clause head, guard or macro.
%% Where the overlay repeats a declaration of the source (the tuples that stand for records, the node
%% and index types of riak_core_ring, action() of riak_core_claimant) it follows.
%%
%% A type that does not exist:
%%   chashbin: field nodes of #chashbin{} (both variants) erlang:tuple(node()) -> tuple(). There is no
%%     erlang:tuple/1; the checker ended with an internal error in every function that touches the record
%%     or a chashbin:chashbin(), and in functions checked after one of those.
%%
%% Nodes, term() -> node(). chash allows any term as the owner of a partition and riak_core_ring mixed
%% term() and node(); all users have node():
%%   chash: chash_node().
%%   riak_core_ring: fields nodename, next (owner and next owner), claimant and seen of #chstate{};
%%     resize_transfer() (also ordsets:ordset(node()) -> ordsets:ordset(module()) for the modules that are
%%     done); all_members/1, all_owners/1, all_preflists/2, fresh/1, fresh/2, index_owner/2,
%%     future_owner/2, owner_node/1, preflist/2, random_node/1, random_other_node/1,
%%     random_other_active_node/1, transfer_node/3, all_next_owners/1, schedule_resize_transfer/3,
%%     reschedule_resize_transfers/3, awaiting_resize_transfer/3, resize_transfer_status/4,
%%     resize_transfer_complete/4, complete_resize_transfers/3, resize_transfers/2,
%%     set_resize_transfers/3, vnode_type/2.
%%
%% Indices, integer() -> non_neg_integer(). An index is the value of 160 bits; riak_core_util and
%% riak_core_vnode_proxy already said non_neg_integer():
%%   chash: index_as_int(), of which partition() and index() of the headers, of riak_core_apl and of
%%     chashbin are aliases; IntegerKey of next_index/2.
%%   riak_core_ring, integer() -> chash:index_as_int(): field next of #chstate{}, resize_transfer(),
%%     all_owners/1, all_preflists/2, responsible_index/2 (result), future_index/3,4 (OrigIdx and result),
%%     is_future_index/4 (OrigIdx), transfer_node/3, indices/2, future_indices/2, all_next_owners/1,
%%     deletion_complete/3, handoff_complete/3, vnode_type/2 and the resize transfer functions above.
%%   riak_core_vnode: fields forward and handoff_target of #state{}, {integer(), node()} ->
%%     {partition(), node()}.
%%   riak_core_vnode_manager: field never_started of #state{} [{integer(), term()}] -> [{partition(),
%%     module()}], field known_modules [term()] -> [module()]; maybe_retry/3 tuple() -> {index(), node()}
%%     for the source.
%%
%% Keys, binary() -> chash:index() (160 bits, what chash:successors/3 and chashbin:iterator/2 take):
%%   riak_core_ring: preflist/2, responsible_index/2.
%%   riak_core_apl, binary() -> docidx(): get_apl_ann/4, get_apl_ann_chbin/4, get_primary_apl/3,4,
%%     get_primary_apl_chbin/4.
%%
%% Other ranges of numbers:
%%   chash: N of predecessors/3 and successors/3, N and result of max_n/2, result of size/1, integer()
%%     -> non_neg_integer() (lists:split/2, length/1).
%%   chashbin: itr_pop/2 pos_integer() -> non_neg_integer(); 0 works, and n_val() of riak_core_apl is
%%     non_neg_integer().
%%   riak_core_ring: ring_size() non_neg_integer() -> pos_integer(), chash:fresh/2 divides by it; N of
%%     all_preflists/2 integer() -> non_neg_integer() (lists:sublist/2).
%%   riak_core_claimant: resize_ring/1 integer() -> riak_core_ring:ring_size().
%%   riak_core_util: N of multi_keydelete/3 non_neg_integer() -> pos_integer() (lists:keydelete/3), N of
%%     build_tree/3 integer() -> non_neg_integer() (lists:duplicate/2).
%%   riak_core_vnode: send_command_after/2 integer() -> non_neg_integer() (a timer).
%%
%% Types that say something else than the code does:
%%   riak_core_vnode.hrl: sender(), {sender_type(), reference() | tuple(), pid()} -> {fsm | raw,
%%     reference() | tuple(), pid()} | {server, reference() | tuple() | undefined, {pid(), term()}}. The
%%     third element of a server sender is the From of a gen_server call (reply/2, monitor/1,
%%     riak_core_vnode_master).
%%   riak_core_apl: get_apl_ann/2 and get_apl_ann_with_pnum/1 riak_core_bucket:bucket() ->
%%     {riak_core_bucket:bucket(), binary()}, the argument is a bucket and a key.
%%   riak_core_base64url: decode/1, decode_to_string/1, mime_decode/1, mime_decode_to_string/1 iodata()
%%     -> string() | binary(); encode/1, encode_to_string/1 iodata() -> [byte()] | binary(). The clauses
%%     take a flat string or a binary, no deep list.
%%   riak_core_bucket: error of set_bucket/2 [{atom(), atom()}] -> [{atom(), string()}], the same in
%%     riak_core_bucket_props:validate/4: an error is a property and a message.
%%   riak_core_claim: rebalance_deltas/3, increase_keeps/4, increase_takes/4 take the triples {Node,
%%     Own, Delta}, [{node(), integer()}] -> [{node(), non_neg_integer(), integer()}]; build_nodelist/6
%%     (Acc and result), backfill_ring/4 (Acc and result), solve_tail_violations/4 (result) [node()] ->
%%     [node() | [node()]], the caller flattens the list.
%%   riak_core_claimant: action() gets {resize, riak_core_ring:ring_size()} and abort_resize, which
%%     resize_ring/1 and abort_resize/0 stage; plan/0 [action()] -> [{node(), action() | join}]; commit/0
%%     gets the bare error that commit_staged/1 answers for not_changed.
%%   riak_core_node_watcher: service_up/3,4 mfa() -> {atom(), atom(), [any()]} as field callback of
%%     #health_check{}, the third element is the list of the arguments.
%%   riak_core_vnode: get_modstate/1 {atom(), state()} -> {atom(), term()}, the second element is the
%%     state of the vnode module.
%%   riak_core_vnode_proxy: call_reply/1 {atom(), term()} -> {ok, term()} | {'EXIT', term()}.
%%   riak_core_vnode_worker_pool: field shutdown of #state{} {pid(), reference()} -> gen_statem:from().
%%
%% Types that say too little:
%%   chashbin: Bin of create_bin/3 binary() -> owners_bin(), it is the result of the first clause;
%%     -export_type gets iterator/0 for riak_core_apl.
%%   riak_core_apl: iterator() term() -> chashbin:iterator() | done, chashbin() term() ->
%%     chashbin:chashbin().
%%   riak_core_ring: member_status/2 [node()] -> the type of field members, which the second clause
%%     takes; get_buckets/1 [term()] -> [riak_core_bucket:bucket()].
%%   riak_core_bucket: get_buckets/1 list() -> [properties()].
%%   riak_core_util: build_tree/3 (Nodes :: [term()]) -> orddict:orddict() becomes (Nodes :: [Node]) ->
%%     orddict:orddict(Node, [Node]); job_class_disabled_message/2 (atom(), term()) -> binary() | string()
%%     becomes (binary, term()) -> binary(); (text, term()) -> string().
%%   riak_core_vnode.hrl: field foldfun of #riak_core_fold_req_v1{} and #riak_core_fold_req_v2{} fun()
%%     -> fun((term(), term(), term()) -> term()), the guard of make_fold_reqv/5.
%%   riak_core_handoff.hrl: fields of #handoff_status{}: timestamp tuple() -> erlang:timestamp(); the
%%     fun in size function() -> fun(() -> {non_neg_integer(), bytes | objects} | undefined), get_size/1
%%     calls it.
%%   riak_core_handoff_manager: send_handoff/8 list() -> [handoff_status()].
%%   riak_core_handoff_sender: fields of #ho_acc{}: filter function() -> predicate(), socket any() ->
%%     gen_tcp:socket().
%%   riak_core_vnode_worker_pool: field monitors of #state{} list() -> [{pid(), reference(), term(),
%%     term()}] (the sender is a riak_core_vnode sender(), which this module cannot name).
%%   gen_fsm_compat: terminate/7, _ -> atom() for StateName and _ -> [sys:dbg_opt()] for Debug.
%%   vclock: BucketProps of prune/3 term() -> [{atom(), term()}].
%%
%% Left as they are, although a declaration is the cause:
%%   riak_core_ring: the six fields of #chstate{} that say T | undefined (vclock, chring, meta, members,
%%     seen, rvsn; 40 exceptions with record_undefined). nearly_equal/2 and equal_cstate/3 build copies
%%     of a ring with undefined in these fields to compare the rest, so the declaration is true. Without
%%     the undefined 33 more functions of the module type check and none fails (measured, not applied):
%%     the two functions only compare the copies, and a record with a field outside its type is an
%%     error only where it is used as the record type.
%%   riak_core_priority_queue: join/2 needs the overloaded spec (squeue(), squeue()) -> squeue();
%%     (pqueue(), pqueue()) -> pqueue(), which takes the checker 32 s.
%%   riak_core_util:safe_rpc/5 (timeout() for rpc:call/5) and riak_core_claim:build_nodelist/6
%%     (integer() for lengths): a tighter range moves the error to the callers.

{study, riak_core_lite}.
{deps, ["poolboy"]}.

%% {reason, Id, Class, Text}. Class: real (the program or its spec is wrong), inherent (correct at
%% run time, not provable by types), fixable (gap in the type system or checker), benign (dead for the spec, kept on purpose), unknown.
%% The reason of an exception with ignore is the one of what blocks the function in the end: the first error that no library
%% spec, flag or assertion takes away without hiding a real error. Its comment names what is in front of it and behind it.
%% The reason of an assertion is the one of the value that it casts, the reason of a flag the one of the clauses.
{reason, otp_no_spec,         fixable,  "calls an OTP function that has no spec, which is a name error"}.
{reason, catch_pattern,       fixable,  "a catch clause with a tuple pattern fails to type check"}.
{reason, guard_float,         fixable,  "a guard that compares a float() with an integer makes the next clause dead"}.
{reason, map_keys,            fixable,  "a map expression with two keys is rejected by a map type with these keys"}.
{reason, bit_segment,         fixable,  "an integer segment of a binary pattern is non_neg_integer(), its size gives no range"}.
{reason, narrowing,           fixable,  "a type test does not narrow: the left of andalso for the right, a case on is_pid(X) or on a record field for its branches, a guard for a clause of an overloaded spec"}.
{reason, overload_spec,       fixable,  "a function that dispatches on literal kinds needs an intersection spec, for itself and for its fun parameter"}.
{reason, catch_value,         fixable,  "the value of a catch follows from what its body can raise: terminate/7 only exits"}.
{reason, dict_types,          fixable,  "key and value type of a dict:dict(K, V) are lost, the program fills the dict with one type"}.
{reason, tuple_any,           fixable,  "needs a type for tuples of any size, {T, ...}: element/2 on a tuple of nodes"}.
{reason, arith_range,         fixable,  "the range of an arithmetic result follows from guards and the ranges of the operands, operator and BIF types are too coarse"}.
{reason, nonempty_result,     fixable,  "a list built with a cons cell and passed through lists:reverse/1 is not empty"}.
{reason, clause_guards,       fixable,  "the guards of the clauses of the function cover the type of the argument together"}.
{reason, result_by_args,      fixable,  "the result for these literal arguments is one case of the result type of the callee: ets:new/2 with named_table, crypto:hash(sha, _)"}.
{reason, union_elimination,   fixable,  "variables bound from a union of tuples lose their correlation (etylizer#28)"}.
{reason, body_exhaustiveness, inherent, "exhaustiveness of a match or a case inside the body: the program lets it crash for the other values"}.
{reason, partial,             inherent, "partial function, the callers rule out the missing case; as an assertion: a value that only the missing case does not fit"}.
{reason, defensive,           benign,   "defensive clause, dead for the spec"}.
{reason, nonempty_list,       inherent, "hd/1, tl/1 or lists:nth/2 on a list that the program knows is not empty"}.
{reason, number_range,        inherent, "range of a number (positive, not negative, a byte) that the types do not show"}.
{reason, unchecked_result,    inherent, "a result that can be undefined or an error value, used as the success value"}.
{reason, untyped_value,       inherent, "term() from a proplist, a dict, ets, the application environment, the process dictionary, a persistent term, an rpc, a catch or a tuple(), used at the type the program expects"}.
{reason, call_reply,          inherent, "the reply of gen_server:call, gen_statem:call, gen_fsm_compat, gen_event or proc_lib:start_link is term(), the spec promises the type of the reply"}.
{reason, message_term,        inherent, "the message of a process callback with a catch-all clause is term(), a clause uses its payload at the type the sender gives"}.
{reason, correlated,          inherent, "the type of a value depends on another value (a tag, a flag, a second field), a test on that one does not narrow it"}.
{reason, list_shape,          inherent, "the shape of a list that a list type cannot say: one cons cell with a binary as tail"}.
{reason, deserialize,         inherent, "binary_to_term/1 gives term()"}.
{reason, record_undefined,    real,     "a record field declared T | undefined is used as T"}.
{reason, spec_imprecise,      real,     "imprecise type spec in the source"}.
{reason, source_bug,          real,     "error in the program"}.
{reason, assertion_crash,     fixable,  "needs an assertion that crashes the engine: assertions:hash/1 fails for a hash below 16#110000"}.
{reason, bound_pattern,       fixable,  "a pattern with an already bound variable is not handled: the match counts as not exhaustive, no assertion closes it"}.
{reason, binary_pattern,      fixable,  "a binary pattern with sized segments counts as matching every binary, a clause after it is reported as dead"}.
{reason, guard_arith,         fixable,  "case A - B of P when P < 0 -> ..; P -> .. end: the first clause is reported as dead, annotating the subject integer() repairs it"}.
{reason, fun_partial,         fixable,  "partial fun: the flags cover the clauses of the function only, and a fun with an annotation has to be exhaustive"}.
{reason, assert_tyvar,        fixable,  "needs an assertion with a type variable of the spec, which the type of an assertion cannot name"}.
{reason, arg_list,            inherent, "the arguments of init/1 and the Misc of the sys callbacks come as one list, a list type has one type for all elements: each is used at the type of its position"}.
{reason, case_guards,         fixable,  "the guards of the clauses of a case cover the type together (N == 0 and N > 0 for a non_neg_integer()), which the checker does not see; neither a flag nor an assertion reaches the case"}.
{reason, inet_backend,        inherent, "a gen_tcp:socket() is a port() with the default inet backend, the source keeps its sockets as port()"}.
{reason, in_fun,              fixable,  "needs an assertion inside a fun, which the assertions do not reach (assertions:visit/4 skips the clauses of a fun)"}.
{reason, checker_timeout,     fixable,  "the check of the function runs into the timeout"}.
{reason, map_types,           fixable,  "map types with more than one association or with mandatory associations are not supported"}.
{reason, not_finished,        unknown,  "not finished in step IV: the comment names the first error as it was when the function was last looked at"}.

%% Library specs that overlays correct
{correction, erlang, hd, 1, spec_imprecise}.
{correction, erlang, tl, 1, spec_imprecise}.
{correction, erlang, max, 2, spec_imprecise}.
{correction, erlang, min, 2, spec_imprecise}.
{correction, erlang, length, 1, spec_imprecise}.
{correction, erlang, integer_to_list, 1, spec_imprecise}.
{correction, lists, foldl, 3, spec_imprecise}.
{correction, lists, mapfoldl, 3, spec_imprecise}.
{correction, lists, keytake, 3, spec_imprecise}.
{correction, lists, seq, 2, spec_imprecise}.
{correction, lists, seq, 3, spec_imprecise}.
{correction, lists, sum, 1, spec_imprecise}.
{correction, lists, flatten, 1, spec_imprecise}. % doubtful: the io_lib:chars() arrow
{correction, ordsets, subtract, 2, spec_imprecise}.
{correction, ordsets, intersection, 2, spec_imprecise}.
{correction, crypto, hash, 2, spec_imprecise}.
{correction, filename, join, 2, spec_imprecise}.
{correction, gen, start, 5, spec_imprecise}.
{correction, gen, start, 6, spec_imprecise}.
{correction, sys, handle_debug, 4, spec_imprecise}. % doubtful: domain widening of the fun

{module, chash, #{file => "riak_core/src/chash.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% {IndexAsInt, X} = proplists:lookup(IndexAsInt, Nodes), which can give none; with assert_pattern {_, _} the match stays open,
%% IndexAsInt is bound
{exception, chash, lookup, 2, [ignore], bound_pattern}.
%% {NumPartitions, NodesB} = CHashB with NumPartitions bound
{exception, chash, merge_rings, 2, [ignore], bound_pattern}.
%% ring_increment/1: div gives integer(), the spec says pos_integer()
{assertion, chash, {188, 16, "1b1a59"}, assert_type, "pos_integer()", number_range}.

{module, chashbin, #{file => "riak_core/src/chashbin.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% to_list/1: element/2 on the tuple of the nodes gives term(), the result has node(); behind it Id out of the 16 bit segment is
%% non_neg_integer(), element/2 wants pos_integer()
{assertion, chashbin, {99, 12, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {99, 20, "9b7137"}, assert_type, "pos_integer()", number_range}.
%% to_list_filter/2: element/2 on the tuple of the nodes gives term(), the result has node(); behind it Id out of the 16 bit
%% segment is non_neg_integer(), element/2 wants pos_integer()
{assertion, chashbin, {110, 12, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {110, 20, "9b7137"}, assert_type, "pos_integer()", number_range}.
{assertion, chashbin, {112, 20, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {112, 28, "9b7137"}, assert_type, "pos_integer()", number_range}.
%% itr_value/1: <<_:Pos/binary-unit:176, Idx:160/integer, Id:16/integer, _/binary>> = Bin; behind it element/2 as in to_list/1
{assertion, chashbin, {172, 5, "54fa09"}, assert_pattern, "<<_:Pos/binary-unit:176, _:160/integer, _:16/integer, _/binary>>", body_exhaustiveness}.
{assertion, chashbin, {175, 13, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {175, 21, "9b7137"}, assert_type, "pos_integer()", number_range}.
%% itr_pop/2: case Bin of <<_:Pos/binary-unit:176, Bin2:N/binary-unit:176, _/binary>> -> ..; _ -> ..: the first pattern counts
%% as matching every binary, the second clause is reported as dead; the subject is annotated term(). Id out of the 16 bit
%% segment is non_neg_integer(), element/2 wants pos_integer() and gives term() for the node
{assertion, chashbin, {199, 14, "4a7272"}, annotate_type, "term()", binary_pattern}.
{assertion, chashbin, {202, 22, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {202, 30, "9b7137"}, assert_type, "pos_integer()", number_range}.
{assertion, chashbin, {210, 27, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {210, 35, "9b7137"}, assert_type, "pos_integer()", number_range}.
{assertion, chashbin, {212, 27, "a02cd7"}, assert_type, "node()", tuple_any}.
{assertion, chashbin, {212, 35, "9b7137"}, assert_type, "pos_integer()", number_range}.
%% itr_next_while/2: itr_next/1 gives done behind the last position, itr_next_while/2 takes an iterator: a predicate that holds
%% for the whole ring ends in a function_clause of itr_value/1 (riak_core_apl:first_up/2 documents the crash)
{assertion, chashbin, {227, 36, "a0197a"}, assert_type, "iterator()", unchecked_result}.
%% {Owner, Id} = lists:keyfind(Owner, 1, Nodes), false for an owner without id; with assert_pattern {_, _} the match stays open,
%% Owner is bound
{exception, chashbin, create_bin, 3, [ignore], bound_pattern}.

{module, gen_fsm_compat, #{file => "riak_core/src/gen_fsm_compat.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"},
                      {library, "overlay_riak_core_lite_lib_gen.erl"}]}}.
{exception, gen_fsm_compat, stop, 1, [ignore], otp_no_spec}. % gen:stop/1
{exception, gen_fsm_compat, stop, 3, [ignore], otp_no_spec}. % gen:stop/3
{exception, gen_fsm_compat, sync_send_event, 2, [ignore], otp_no_spec}. % gen:call/3
{exception, gen_fsm_compat, sync_send_event, 3, [ignore], otp_no_spec}. % gen:call/4
{exception, gen_fsm_compat, sync_send_all_state_event, 2, [ignore], otp_no_spec}. % gen:call/3
{exception, gen_fsm_compat, sync_send_all_state_event, 3, [ignore], otp_no_spec}. % gen:call/4
%% gen:get_proc_name/1, gen:get_parent/0, gen:debug_options/2, gen:hibernate_after/1
{exception, gen_fsm_compat, enter_loop, 6, [ignore], otp_no_spec}.
%% gen:name/1, gen:debug_options/2, gen:hibernate_after/1, gen:unregister_name/1
{exception, gen_fsm_compat, init_it, 6, [ignore], otp_no_spec}.
{exception, gen_fsm_compat, decode_msg, 10, [ignore], otp_no_spec}. % sys:handle_system_msg/7
%% system_continue/3: the clause takes Misc as the list of six elements that decode_msg/10 gives to sys; a list type has one
%% type for all elements, each is used at the type of its position
{assertion, gen_fsm_compat, {448, 24, "e75d36"}, assert_type, "atom()", arg_list}.
{assertion, gen_fsm_compat, {448, 46, "91f447"}, assert_type, "module()", arg_list}.
{assertion, gen_fsm_compat, {448, 51, "d2e992"}, assert_type, "overlay_riak_core_lite:fsm_time()", arg_list}.
{assertion, gen_fsm_compat, {449, 10, "23fff0"}, assert_type, "timeout()", arg_list}.
{exception, gen_fsm_compat, system_continue, 3, [no_exhaustiveness], partial}.
%% system_terminate/4: the clause takes Misc as the list of six elements that decode_msg/10 gives to sys; a list type has one
%% type for all elements, each is used at the type of its position. The spec says _ for Debug, terminate/7 takes the debug
%% options
{assertion, gen_fsm_compat, {457, 33, "91f447"}, assert_type, "atom()", arg_list}.
{assertion, gen_fsm_compat, {457, 38, "e75d36"}, assert_type, "atom()", arg_list}.
{assertion, gen_fsm_compat, {458, 15, "254506"}, assert_type, "[sys:dbg_opt()]", untyped_value}.
{exception, gen_fsm_compat, system_terminate, 4, [no_exhaustiveness], partial}.
%% the clause takes Misc as the list of six elements that decode_msg/10 gives to sys; the overlay spec says [term(), ...] as the
%% spec of system_terminate/4
{exception, gen_fsm_compat, system_code_change, 4, [no_exhaustiveness], partial}.
%% system_get_state/1: the clause takes Misc as the list of six elements that decode_msg/10 gives to sys; a list type has one
%% type for all elements, each is used at the type of its position
{assertion, gen_fsm_compat, {475, 11, "e75d36"}, assert_type, "atom()", arg_list}.
{exception, gen_fsm_compat, system_get_state, 1, [no_exhaustiveness], partial}.
%% system_replace_state/2: the clause takes Misc as the list of six elements that decode_msg/10 gives to sys; a list type has
%% one type for all elements, each is used at the type of its position
{assertion, gen_fsm_compat, {480, 51, "e75d36"}, assert_type, "atom()", arg_list}.
{exception, gen_fsm_compat, system_replace_state, 2, [no_exhaustiveness], partial}.
%% handle_msg/8: catch dispatch(..) is term(): NStateName out of {next_state, NStateName, NStateData} goes to loop/8 as atom(),
%% Time1 as the time; From is the fsm_from() or undefined of from/1, reply/2 takes the client; {'EXIT', R} = (catch
%% terminate(..))
{assertion, gen_fsm_compat, {525, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {528, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {528, 59, "becf56"}, assert_type, "overlay_riak_core_lite:fsm_time()", untyped_value}.
{assertion, gen_fsm_compat, {532, 17, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
{assertion, gen_fsm_compat, {533, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {537, 17, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
{assertion, gen_fsm_compat, {538, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {538, 59, "becf56"}, assert_type, "overlay_riak_core_lite:fsm_time()", untyped_value}.
{assertion, gen_fsm_compat, {545, 11, "8e4404"}, assert_pattern, "{'EXIT', _}", catch_value}.
{assertion, gen_fsm_compat, {547, 17, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
%% handle_msg/9: catch dispatch(..) is term(): NStateName goes to loop/8 and to sys:handle_debug/4 as atom(), Time1 as the time;
%% From is the fsm_from() or undefined of from/1; {'EXIT', R} = (catch terminate(..))
{assertion, gen_fsm_compat, {570, 44, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {571, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {575, 44, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {576, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {576, 59, "becf56"}, assert_type, "overlay_riak_core_lite:fsm_time()", untyped_value}.
{assertion, gen_fsm_compat, {580, 32, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
{assertion, gen_fsm_compat, {580, 52, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {581, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {585, 32, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
{assertion, gen_fsm_compat, {585, 52, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {586, 30, "ed7078"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {586, 59, "becf56"}, assert_type, "overlay_riak_core_lite:fsm_time()", untyped_value}.
{assertion, gen_fsm_compat, {593, 11, "738cb3"}, assert_pattern, "{'EXIT', _}", catch_value}.
{assertion, gen_fsm_compat, {595, 27, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
%% from/1: From out of the message {'$gen_sync_event', From, Event}, which is term(); the result is the {pid(), term()} that
%% gen:call/3 sends
{assertion, gen_fsm_compat, {627, 44, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
{assertion, gen_fsm_compat, {629, 5, "47e66f"}, assert_type, "overlay_riak_core_lite:fsm_from()", message_term}.
%% error_info/6: M, F and A out of the reason {undef, [{M, F, A, L}, ..]}, which is term(), go to code:is_loaded/1 and
%% erlang:function_exported/3
{assertion, gen_fsm_compat, {679, 41, "44b57e"}, assert_type, "module()", untyped_value}.
{assertion, gen_fsm_compat, {683, 57, "44b57e"}, assert_type, "module()", untyped_value}.
{assertion, gen_fsm_compat, {683, 60, "ca1cce"}, assert_type, "atom()", untyped_value}.
{assertion, gen_fsm_compat, {683, 70, "c1ca45"}, assert_type, "[term()]", untyped_value}.
%% gen:format_status_header/2; behind it Specfic is bound twice (741-746), a callback status that is not a list is a badmatch
{exception, gen_fsm_compat, format_status, 2, [ignore], otp_no_spec}.

{module, gen_nb_server, #{file => "riak_core/src/gen_nb_server.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% start_link/4: gen_server:start_link/3 can give ignore, the result here is {ok, pid()} or {error, any()} as the @spec in the
%% source says; init/1 never returns ignore
{assertion, gen_nb_server, {101, 5, "2eea44"}, assert_type, "{ok, pid()} | {error, any()}", unchecked_result}.
%% init/1: the head takes a list of four elements, a list type does not say its length; start_link/4 passes four, each element
%% is used at the type of its position
{assertion, gen_nb_server, {108, 26, "bb0c90"}, assert_type, "module()", arg_list}.
{assertion, gen_nb_server, {108, 42, "90f0de"}, assert_type, "string()", arg_list}.
{assertion, gen_nb_server, {108, 50, "7a690e"}, assert_type, "integer()", arg_list}.
{exception, gen_nb_server, init, 1, [no_exhaustiveness], partial}.
{exception, gen_nb_server, handle_info, 2, [ignore], otp_no_spec}. % inet_db:register_socket/2 and prim_inet:async_accept/2
{exception, gen_nb_server, listen_on, 3, [ignore], otp_no_spec}. % prim_inet:async_accept/2 and inet_parse:address/1

{module, riak_core, #{file => "riak_core/src/riak_core.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% get_other_ring/1: result of riak_core_util:safe_rpc/4 is any(), returned as the {ok, Ring} of
%% riak_core_ring_manager:get_raw_ring/0 on the other node or {badrpc, Reason}
{assertion, riak_core, {94, 5, "1dc905"}, assert_type, "{ok, riak_core_ring:riak_core_ring()} | {badrpc, term()}", untyped_value}.
%% vnode_modules/0: case application:get_env(riak_core, _) of undefined; {ok, Mods}: the value of the environment is term(),
%% returned as [{atom(), module()}]
{assertion, riak_core, {223, 10, "8f2ac2"}, assert_type, "{ok, [overlay_riak_core_lite:core_app_mod()]} | undefined", untyped_value}.
%% bucket_fixups/0: case application:get_env(riak_core, _) of undefined; {ok, Mods}: the value of the environment is term(),
%% returned as [{atom(), module()}]
{assertion, riak_core, {229, 10, "965063"}, assert_type, "{ok, [overlay_riak_core_lite:core_app_mod()]} | undefined", untyped_value}.
%% bucket_validators/0: case application:get_env(riak_core, _) of undefined; {ok, Mods}: the value of the environment is term(),
%% returned as [{atom(), module()}]
{assertion, riak_core, {235, 10, "963753"}, assert_type, "{ok, [overlay_riak_core_lite:core_app_mod()]} | undefined", untyped_value}.
%% stat_mods/0: case application:get_env(riak_core, _) of undefined; {ok, Mods}: the value of the environment is term(),
%% returned as [{atom(), module()}]
{assertion, riak_core, {242, 10, "a44f55"}, assert_type, "{ok, [overlay_riak_core_lite:core_app_mod()]} | undefined", untyped_value}.
%% case lists:keyfind(App, 1, Mods) of false; {App, MFA}: the pattern repeats the bound App, the case counts as not exhaustive;
%% in front of it Mods out of application:get_env/2 is term()
{exception, riak_core, health_check, 1, [ignore], bound_pattern}.
%% register_metadata(get_app(App, HealthMFA), HealthMFA, health_checks) (295): get_app/2 takes a module to look up the
%% application, HealthMFA is the {M, F, A} of the health check, so a health check registered without an application gets
%% undefined. In front of it {ok, _R} = riak_core_ring_manager:ring_trans(..), which can give not_changed
{exception, riak_core, register, 2, [ignore], source_bug}.
%% register_mod/3: Module is a module or, for the key permissions, the list of the permissions;
%% riak_core_vnode_proxy_sup:start_proxies(Module) runs only for Type = vnode_modules, where it is a module. The value of
%% application:get_env/2 is term()
{assertion, riak_core, {315, 51, "35c73e"}, assert_type, "module()", correlated}.
{assertion, riak_core, {323, 10, "9dd8d6"}, assert_type, "{ok, [term()]} | undefined", untyped_value}.
%% register_metadata/3: case application:get_env(riak_core, Type) of undefined; {ok, Values}: the value of the environment is
%% term(), used as a list
{assertion, riak_core, {332, 10, "9dd8d6"}, assert_type, "{ok, [term()]} | undefined", untyped_value}.
%% register_proplist/2: case application:get_env(riak_core, Type) of undefined; {ok, Values}: the value of the environment is
%% term(), used as a list
{assertion, riak_core, {341, 10, "9dd8d6"}, assert_type, "{ok, [term()]} | undefined", untyped_value}.
%% app_for_module/2: {ok, Mods} = application:get_key(App, modules), which can give undefined and has term() for the value
{assertion, riak_core, {401, 18, "e1023a"}, assert_type, "{ok, [module()]}", untyped_value}.
%% case lists:keymember(..) of true when Elapsed == 0; true when Elapsed > 0; false: the two guards cover a non_neg_integer()
{exception, riak_core, wait_for_application, 2, [ignore], case_guards}.
%% case lists:member(..) of true when Elapsed == 0; true when Elapsed > 0; false: the two guards cover a non_neg_integer(). In
%% front of it riak_core_node_watcher:services(node()) can give invalid_node, lists:member/2 takes a list
{exception, riak_core, wait_for_service, 2, [ignore], case_guards}.
{assertion, riak_core, {465, 5, "bdd351"}, assert_type, "atom()", untyped_value}. % stat_prefix/0: application:get_env/3

