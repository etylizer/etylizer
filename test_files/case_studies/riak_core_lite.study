{exception, riak_core_ring, transfer_complete, 3, [ignore], bound_pattern}.
%% fields vclock and seen can be undefined, given to orddict:update/4
{exception, riak_core_ring, update_seen, 2, [ignore], record_undefined}.
%% field members is the orddict or undefined, given to equal_members/2; the same for rvsn and vclock:equal/2
