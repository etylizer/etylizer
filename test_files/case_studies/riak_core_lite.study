%% hd(my_indices(State)) in the branch where no other node owns an index
{exception, riak_core_ring, random_other_index, 1, [ignore], nonempty_list}.
%% length(L) is non_neg_integer(), riak_core_rand:uniform/1 wants pos_integer(); L is not empty in this branch
