%% behind it TN is term() from proplists:get_value/3
{exception, riak_core_claim, claim_diversify, 3, [ignore], nonempty_list}.
%% proplists:get_value/3 gives term(), TN is used in TN + Tail
{exception, riak_core_claim, claim_diagonal, 3, [ignore], untyped_value}.
%% lists:foldl/3 with a fun on a tuple, fun ({P, N}, Acc)
{exception, riak_core_claim, sequential_claim, 3, [ignore], free_result}.
%% integer() in the spec for the lengths, lists:sublist/3 wants non_neg_integer(); the callers have them as integer() too
%% (TargetN of sequential_claim/3)
{exception, riak_core_claim, build_nodelist, 6, [ignore], source_bug}.
%% lists:foldl/3 with a fun on a tuple, fun ({P, N}, Acc)
{exception, riak_core_claim, claim_rebalance_n, 2, [ignore], free_result}.
%% lists:flatten/1 gives [term()], the result has node() for the nodes
{exception, riak_core_claim, diagonal_stripe, 2, [ignore], library_spec}.
{exception, riak_core_claim, find_violations, 2, [ignore], library_spec}. % lists:keyfind/3 gives tuple() or false
%% lists:foldl/3 with a fun on a tuple, fun ({_Idx, Node}, Counts)
{exception, riak_core_claim, get_counts, 2, [ignore], free_result}.
{exception, riak_core_claim, add_default_deltas, 3, [ignore], library_spec}. % lists:ukeysort/2 gives [tuple()]
%% lists:keyfind/3 gives tuple() or false, the fun of lists:all/2 takes {CNth, _}
{exception, riak_core_claim, prefilter_violations, 6, [ignore], library_spec}.
%% Delta = dict:fetch(Owner, DeltaDT), the branch true of the case on (Delta < 0) and .. is dead; lists:foldl/3 with a fun on
%% two tuples alone has the same effect at this place
{exception, riak_core_claim, select_indices, 5, [ignore], dict_types}.
{exception, riak_core_claim, wants_owns_diff, 2, [ignore], library_spec}. % lists:keyfind/3 gives tuple() or false
%% length/1 gives non_neg_integer(), wants_counts/2 divides by it and takes pos_integer()
{exception, riak_core_claim, wants, 1, [ignore], number_range}.
%% trunc/1 gives integer(), the result is non_neg_integer() by the guard I >= 0; behind it guard_float, the branch Pos when Pos
%% > 0 is dead
{exception, riak_core_claim, roundup, 1, [ignore], number_range}.

