{module, riak_core_handoff_sender, #{file => "riak_core/src/riak_core_handoff_sender.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% [_Name, Host] = string:tokens(atom_to_list(TargetNode), "@") and the matches and cases on the results of gen_tcp behind it.
%% Not finished in step IV: with five assertions (94, 104, 116, 117, 135) the next open case is at 145, the function goes on to
%% line 250
{exception, riak_core_handoff_sender, start_fold_, 8, [ignore], not_finished}.
{exception, riak_core_handoff_sender, start_fold, 4, [ignore], catch_pattern}. % catch exit:{shutdown, max_concurrency}
%% start_visit_item_timer/0: case application:get_env(riak_core, handoff_receive_timeout, undefined) of TO when is_integer(TO)
%% -> erlang:max(1000, TO div 3): an integer(), timer:send_interval/2 takes a non_neg_integer()
{assertion, riak_core_handoff_sender, {295, 25, "715faf"}, assert_type, "non_neg_integer()", arith_range}.
%% visit_item/3: {ok, TRef} = start_visit_item_timer(), timer:send_interval/2 can give {error, _}; behind it get/1 with a dead
%% second branch
{assertion, riak_core_handoff_sender, {306, 17, "8c03dc"}, assert_pattern, "{ok, _}", result_by_args}.
%% case gen_tcp:recv(Sock, 0, RecvTimeout) of {ok, [?PT_MSG_OLDSYNC | <<"sync">>]}; {error, Reason}: no clause for another
%% packet. With the reply asserted as {ok, nonempty_improper_list(2, <<_:32>>)} | {error, term()} the case stays open: no type
%% says the binary <<"sync">>
{exception, riak_core_handoff_sender, visit_item2, 3, [ignore], body_exhaustiveness}.
%% get_handoff_ip/1: result of riak_core_util:safe_rpc/5 is any(), returned as {ok, string()}
{assertion, riak_core_handoff_sender, {452, 14, "6bf8fb"}, assert_type, "{ok, string()}", untyped_value}.
%% get_handoff_port/1: reply of riak_core_handoff_listener to handoff_port: {ok, Port}
{assertion, riak_core_handoff_sender, {456, 5, "df43d3"}, assert_type, "{ok, overlay_riak_core_lite:hs_port()}", call_reply}.
%% get_src_partition/1: proplists:get_value(src_partition, Opts)
{assertion, riak_core_handoff_sender, {531, 5, "3d2060"}, assert_type, "overlay_riak_core_lite:hs_partition()", untyped_value}.
%% get_target_partition/1: proplists:get_value(target_partition, Opts)
{assertion, riak_core_handoff_sender, {534, 5, "c7791e"}, assert_type, "overlay_riak_core_lite:hs_partition()", untyped_value}.
%% get_notsent_fun/1: proplists:get_value(notsent_fun, Opts)
{assertion, riak_core_handoff_sender, {542, 14, "c0386f"}, assert_type, "overlay_riak_core_lite:hs_notsent_fun()", untyped_value}.
%% get_filter/1: proplists:get_value(filter, Opts)
{assertion, riak_core_handoff_sender, {550, 17, "65176c"}, assert_type, "predicate()", untyped_value}.
{assertion, riak_core_handoff_sender, {460, 5, "9ef1e6"}, assert_type, "timeout()", untyped_value}. % get_handoff_receive_timeout/0: application:get_env/3
{assertion, riak_core_handoff_sender, {527, 5, "f2709b"}, assert_type, "pos_integer()", untyped_value}. % get_status_interval/0: application:get_env/3

{module, riak_core_handoff_sender_sup, #{file => "riak_core/src/riak_core_handoff_sender_sup.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
