%% all_vnodes/1: gen_server:call(?MODULE, {all_vnodes, Mod}, infinity), the fallback when the ets table gives []; the assertion
%% is on the case, the call (194:11) crashes the engine with one
{assertion, riak_core_vnode_manager, {191, 5, "b00ab1"}, assert_type, "[overlay_riak_core_lite:vm_vnode()]", call_reply}.
%% all_index_pid/1: gen_server:call(?MODULE, {all_index_pid, VNodeMod}, infinity), the fallback for ets_error
{assertion, riak_core_vnode_manager, {201, 11, "1ff0e0"}, assert_type, "[{riak_core_vnode_manager:partition(), pid()}]", call_reply}.
%% get_all_index_pid/2: list_to_tuple(L) on the bindings of ets:match/2 gives tuple(), the result is a list of {partition(),
%% pid()}
{assertion, riak_core_vnode_manager, {211, 10, "f8017c"}, assert_type, "{partition(), pid()}", untyped_value}.
%% find_vnodes/1: is_pid(Pid) andalso is_process_alive(Pid), Pid of supervisor:which_children/1 is a pid, undefined or
%% restarting; true = ets:insert_new(..)
{assertion, riak_core_vnode_manager, {259, 58, "9591bb"}, assert_type, "pid()", narrowing}.
{assertion, riak_core_vnode_manager, {284, 5, "7d8215"}, assert_pattern, "true", body_exhaustiveness}.
%% the true branch of the if binds R2 to the ok of logger:error/2 (351), line 355 reads R2#repair.minus_one_xfer. In front of it
%% Mod of {all_vnodes, Mod} is term(), get_all_vnodes/1 takes a module or a list of modules, the other requests have the same,
%% and ets:tab2list/1 gives [tuple()] (303)
{exception, riak_core_vnode_manager, handle_call, 3, [ignore], source_bug}.
%% the fun of lists:map/2 takes only a repair with three pairs whose indices are those of the two transfers (the head repeats
%% M1SrcIdx and P1SrcIdx)
{exception, riak_core_vnode_manager, transform_repair_records, 1, [ignore], fun_partial}.
%% maybe_create_repair/7: {ok, Ring} = riak_core_ring_manager:get_my_ring()
{assertion, riak_core_vnode_manager, {392, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% handle_cast/2: Partition, Mod, Index, Pid and Event of the requests are term() and go to get_vnode/3, update_forwarding/3,
