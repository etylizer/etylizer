{module, riak_core_vnode_sup, #{file => "riak_core/src/riak_core_vnode_sup.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.

{module, riak_core_vnode_worker, #{file => "riak_core/src/riak_core_vnode_worker.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% start_link/1: [VNodeIndex, WorkerArgs, WorkerProps, Caller] = proplists:get_value(worker_args, Args), which gives term()
{assertion, riak_core_vnode_worker, {47, 5, "ce7a0f"}, assert_pattern, "[_, _, _, _]", untyped_value}.
%% init/1: the head takes a list of five elements, the type of a list does not say its length; start_link/1 passes five; the
%% elements are term(), Caller is used as a pid
{assertion, riak_core_vnode_worker, {65, 48, "8e5cd4"}, assert_type, "pid()", arg_list}.
{exception, riak_core_vnode_worker, init, 1, [no_exhaustiveness], partial}.
%% WorkFrom of {work, Work, WorkFrom, Caller} is term(), riak_core_vnode:reply/2 takes sender(): the variable WorkFrom (80:47)
%% crashes the engine with an assertion. Behind it Caller is term() for riak_core_vnode_worker_pool:checkin_worker/2
{exception, riak_core_vnode_worker, handle_cast, 2, [ignore], assertion_crash}.

{module, riak_core_vnode_worker_pool, #{file => "riak_core/src/riak_core_vnode_worker_pool.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% shutdown_pool/2: reply to {shutdown, Wait}: ok or {error, vnode_shutdown}
{assertion, riak_core_vnode_worker_pool, {94, 5, "6b9dae"}, assert_type, "ok | {error, vnode_shutdown}", call_reply}.
%% not looked at since poolboy is found: 111:1, [term()] and the head takes a list of six elements; exhaustiveness off does not suffice
{exception, riak_core_vnode_worker_pool, init, 1, [ignore], not_finished}.
%% not looked at since poolboy is found: 152:1, the function fails against the clause of its spec for cast
{exception, riak_core_vnode_worker_pool, ready, 3, [ignore], not_finished}.
%% not looked at since poolboy is found: 206:1, the function fails against the clause of its spec for enter
{exception, riak_core_vnode_worker_pool, shutdown, 3, [ignore], not_finished}.
%% case lists:keyfind(Worker, 1, Monitors) of {Worker, Ref, _OldFrom, _OldWork}; false: the pattern repeats the bound Worker,
%% the case counts as not exhaustive
{exception, riak_core_vnode_worker_pool, monitor_worker, 4, [ignore], bound_pattern}.
%% case lists:keyfind(Worker, 1, Monitors) of {Worker, Ref, _From, _Work}; false: the pattern repeats the bound Worker, the case
%% counts as not exhaustive
{exception, riak_core_vnode_worker_pool, demonitor_worker, 2, [ignore], bound_pattern}.
%% field queue is queue:queue() or list(), queue:in/2 takes the queue; queue_strategy = fifo in the same head says that it is a
%% queue. The variable Q (290:39) crashes the engine with an assertion
{exception, riak_core_vnode_worker_pool, in, 2, [ignore], assertion_crash}.
%% field queue is queue:queue() or list(), queue:out/1 takes the queue in the clause for fifo; queue_strategy says which of the
%% two it is. The variable Q (296:15) crashes the engine with an assertion
{exception, riak_core_vnode_worker_pool, out, 1, [ignore], assertion_crash}.
%% not looked at since poolboy is found: 315:63, an argument of monitor_worker/4
{exception, riak_core_vnode_worker_pool, worker_started, 2, [ignore], not_finished}.
%% not looked at since poolboy is found: 339:40
{exception, riak_core_vnode_worker_pool, checkin, 2, [ignore], not_finished}.
%% case lists:keyfind(Pid, 1, Monitors) of {Pid, _, From, Work}; false: the pattern repeats the bound Pid, the case counts as
%% not exhaustive
{exception, riak_core_vnode_worker_pool, exit_worker, 3, [ignore], bound_pattern}.

{module, vclock, #{file => "riak_core/src/vclock.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
{exception, vclock, valid_dot, 1, [no_redundancy], defensive}. % valid_dot(_) after the clause for a dot
%% prune_vclock1/3: hd(V): V is longer than small_vclock
{assertion, vclock, {266, 35, "e91551"}, assert_type, "[dot(), ...]", nonempty_list}.
%% prune_vclock1/4: tl(V): V is longer than small_vclock
{assertion, vclock, {280, 32, "e91551"}, assert_type, "[dot(), ...]", nonempty_list}.
