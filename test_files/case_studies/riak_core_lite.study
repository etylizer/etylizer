%% takes a partition(); in front of it no clause for an unknown message when the field legacy is undefined, and Service of
%% {wait_for_service, Service} is term()
{exception, riak_core_vnode_master, handle_cast, 2, [ignore], record_undefined}.
%% field index of #riak_vnode_req_v1{} is partition() or undefined, riak_core_vnode_proxy:command_return_vnode/2 and reg_name/2
%% take a partition(); in front of it no clause for an unknown call when the field legacy is undefined
{exception, riak_core_vnode_master, handle_call, 3, [ignore], record_undefined}.

{module, riak_core_vnode_proxy, #{file => "riak_core/src/riak_core_vnode_proxy.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
