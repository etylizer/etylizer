{assertion, riak_core_vnode_proxy, {63, 5, "f94b08"}, assert_type, "{ok, pid()} | {error, term()}", call_reply}.
%% the head takes a list of four elements; Parent goes to proc_lib:init_ack/2 as pid(), and the variable Parent (68:23) crashes
%% the engine with an assertion. Behind it RegName for erlang:register/2 and the term() of application:get_env/3 for the
%% intervals
{exception, riak_core_vnode_proxy, init, 1, [ignore], assertion_crash}.
{exception, riak_core_vnode_proxy, call, 2, [ignore], otp_no_spec}. % gen:call/3
{exception, riak_core_vnode_proxy, call, 3, [ignore], otp_no_spec}. % gen:call/4
{exception, riak_core_vnode_proxy, loop, 2, [ignore], otp_no_spec}. % gen:reply/2
