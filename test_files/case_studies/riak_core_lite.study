%% term(), gen_fsm_compat:send_event/2 takes a pid or a name
{exception, riak_core_vnode_proxy, handle_cast, 2, [ignore], record_undefined}.

{module, riak_core_vnode_proxy_sup, #{file => "riak_core/src/riak_core_vnode_proxy_sup.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
