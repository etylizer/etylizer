{exception, riak_core_vnode_master, handle_cast, 2, [ignore], partial}.
%% no clause for an unknown call, or for a request whose sender is not {server, undefined, undefined}, when the field legacy is
%% undefined
{exception, riak_core_vnode_master, handle_call, 3, [ignore], partial}.

