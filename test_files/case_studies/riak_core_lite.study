{module, riak_core_base64url, #{file => "riak_core/src/riak_core_base64url.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% decode/1: urldecode/1 gives string() for a string, base64:decode/1 takes a list of the characters of the base64 alphabet
%% (base64:base64_string(), a type that base64 does not export)
{assertion, riak_core_base64url, {37, 19, "dc7953"}, assert_type, "[65..90 | 97..122 | 48..57 | 43 | 47 | 45 | 95 | 61] | binary()", number_range}.
%% decode_to_string/1: urldecode/1 gives string() for a string, base64:decode_to_string/1 takes a list of the characters of the
%% base64 alphabet (base64:base64_string(), a type that base64 does not export)
{assertion, riak_core_base64url, {42, 29, "dc7953"}, assert_type, "[65..90 | 97..122 | 48..57 | 43 | 47 | 45 | 95 | 61] | binary()", number_range}.
%% mime_decode/1: urldecode/1 gives string() for a string, base64:mime_decode/1 takes a list of the characters of the base64
%% alphabet (base64:base64_string(), a type that base64 does not export)
{assertion, riak_core_base64url, {47, 24, "dc7953"}, assert_type, "[65..90 | 97..122 | 48..57 | 43 | 47 | 45 | 95 | 61] | binary()", number_range}.
%% mime_decode_to_string/1: urldecode/1 gives string() for a string, base64:mime_decode_to_string/1 takes a list of the
%% characters of the base64 alphabet (base64:base64_string(), a type that base64 does not export)
{assertion, riak_core_base64url, {53, 34, "dc7953"}, assert_type, "[65..90 | 97..122 | 48..57 | 43 | 47 | 45 | 95 | 61] | binary()", number_range}.
%% urlencode/1: <<D>> <= Base64 gives D :: non_neg_integer(), urlencode_digit/1 takes a char()
{assertion, riak_core_base64url, {68, 36, "3eefd7"}, assert_type, "byte()", bit_segment}.
%% urldecode/1: <<D>> <= Base64url gives D :: non_neg_integer(), urldecode_digit/1 takes a char()
{assertion, riak_core_base64url, {77, 36, "3eefd7"}, assert_type, "byte()", bit_segment}.
%% padding/1: list_to_binary/1 wants bytes; the characters of base64 text are bytes, a string() has char()
{assertion, riak_core_base64url, {89, 43, "9003b0"}, assert_type, "[byte()]", number_range}.

{module, riak_core_bucket, #{file => "riak_core/src/riak_core_bucket.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% set_bucket_in_ring/2: {ok, _NewRing} = riak_core_ring_manager:ring_trans(F, undefined)
{assertion, riak_core_bucket, {97, 5, "fe5a3d"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% no clause for a binary bucket name, which the first clause and get_buckets/1 call it with
{exception, riak_core_bucket, get_bucket, 2, [ignore], source_bug}.
%% reset_bucket/1: {ok, _NewRing} = riak_core_ring_manager:ring_trans(F, undefined)
{assertion, riak_core_bucket, {145, 5, "fe5a3d"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% bucket_nval_map/1: name/1 reads the property name out of the proplist, a bucket() by its overlay spec; the spec promises
%% binary(), which the names of the buckets of a ring are
{assertion, riak_core_bucket, {165, 7, "f2c402"}, assert_type, "binary()", untyped_value}.
%% name/1: get_value/2 gives any()
{assertion, riak_core_bucket, {174, 17, "793279"}, assert_type, "riak_core_bucket:bucket()", untyped_value}.
%% n_val/1: get_value/2 gives any()
{assertion, riak_core_bucket, {176, 18, "63b90b"}, assert_type, "pos_integer()", untyped_value}.

{module, riak_core_bucket_props, #{file => "riak_core/src/riak_core_bucket_props.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% case lists:keyfind(claimant, 1, Existing) of false; {claimant, Claimant}; {claimant, _Other}: the second pattern repeats the
%% bound Claimant, the case counts as not exhaustive; in front of it Existing is the properties or undefined in this clause
{exception, riak_core_bucket_props, validate_core_prop, 4, [ignore], bound_pattern}.
%% the values of two properties are any(), used as booleans (orelse, andalso) and as lists of hooks: with the eight assertions
%% for them the check of the 21 clauses runs into the timeout of 10 s (4 s without them)
{exception, riak_core_bucket_props, resolve_prop, 2, [ignore], checker_timeout}.
{assertion, riak_core_bucket_props, {152, 5, "3291b4"}, assert_type, "[{atom(), any()}]", untyped_value}. % defaults/0: application:get_env/3
{assertion, riak_core_bucket_props, {158, 19, "450767"}, assert_type, "[{atom(), any()}]", untyped_value}. % append_defaults/1: application:get_env/3

{module, riak_core_claim, #{file => "riak_core/src/riak_core_claim.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% wants_claim_v2/2: proplists:get_value/3 gives term(), Count is used in Avg - Count
{assertion, riak_core_claim, {129, 27, "f3ed56"}, assert_type, "integer()", untyped_value}.
%% length/1 gives non_neg_integer(), get_deltas/4 wants pos_integer() for NodeCount
{exception, riak_core_claim, choose_claim_v2, 3, [ignore], not_finished}.
%% get_deltas/4: Max = ceiling(RingSize / NodeCount) is integer(), rebalance_deltas/3 takes pos_integer()
{assertion, riak_core_claim, {244, 53, "7ed69c"}, assert_type, "pos_integer()", arith_range}.
%% normalise_delta(Delta) when Delta < 0, Delta is a float()
{exception, riak_core_claim, normalise_delta, 1, [ignore], guard_float}.
%% case Sum - RingSize of 0; N when N < 0, the sum is never above the ring size
{exception, riak_core_claim, rebalance_deltas, 3, [ignore], not_finished}.
%% line 302 pushes the pair {Node, Own + Delta + Additive} on Acc, which holds the triples {Node, Own, Delta}: the
%% comprehensions of the caller drop it. In front of it no clause for ([], N, _, _) with N > 0, N starts negative and stops at 0
{exception, riak_core_claim, increase_keeps, 4, [ignore], source_bug}.
%% no clause for ([], N, _, _) with N > 0, N starts negative and stops at 0
{exception, riak_core_claim, increase_takes, 4, [no_exhaustiveness], partial}.
%% lists:keytake/3 gives {value, tuple(), [tuple()]} or false
{exception, riak_core_claim, meets_target_n, 5, [ignore], not_finished}.
%% Claiming is a comprehension over Wants, riak_core_claim_util:construct/3 takes a non-empty list (it calls lists:last/1);
%% behind it TN is term() from proplists:get_value/3
{exception, riak_core_claim, claim_diversify, 3, [ignore], not_finished}.
%% proplists:get_value/3 gives term(), TN is used in TN + Tail
{exception, riak_core_claim, claim_diagonal, 3, [ignore], not_finished}.
%% lists:foldl/3 with a fun on a tuple, fun ({P, N}, Acc)
{exception, riak_core_claim, sequential_claim, 3, [ignore], not_finished}.
%% integer() in the spec for the lengths, lists:sublist/3 wants non_neg_integer(); the callers have them as integer() too
%% (TargetN of sequential_claim/3)
{exception, riak_core_claim, build_nodelist, 6, [ignore], source_bug}.
%% lists:foldl/3 with a fun on a tuple, fun ({P, N}, Acc)
{exception, riak_core_claim, claim_rebalance_n, 2, [ignore], not_finished}.
{exception, riak_core_claim, find_violations, 2, [ignore], not_finished}. % lists:keyfind/3 gives tuple() or false
%% lists:foldl/3 with a fun on a tuple, fun ({_Idx, Node}, Counts)
{exception, riak_core_claim, get_counts, 2, [ignore], not_finished}.
%% lists:keyfind/3 gives tuple() or false, the fun of lists:all/2 takes {CNth, _}
{exception, riak_core_claim, prefilter_violations, 6, [ignore], not_finished}.
{exception, riak_core_claim, wants_owns_diff, 2, [ignore], not_finished}. % lists:keyfind/3 gives tuple() or false
%% wants/1: length/1 gives non_neg_integer(), wants_counts/2 divides by it and takes pos_integer()
{assertion, riak_core_claim, {694, 42, "31ad9b"}, assert_type, "pos_integer()", number_range}.
%% trunc/1 gives integer(), the result is non_neg_integer() by the guard I >= 0; behind it guard_float, the branch Pos when Pos
%% > 0 is dead
{exception, riak_core_claim, roundup, 1, [ignore], not_finished}.

{module, riak_core_claim_util, #{file => "riak_core/src/riak_core_claim_util.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% lists:foldl/3 with a fun on a tuple, fun ({_, N}, A); behind it lists:sum/1 gives number() for the balance, a sum of squares
{exception, riak_core_claim_util, balance_stats, 1, [ignore], not_finished}.
%% ets:lookup/2 gives [tuple()], the distances D of {_, D} are term()
{exception, riak_core_claim_util, adjacency_matrix_result, 3, [ignore], not_finished}.
%% the second clause needs both lists to start with the same node, the caller passes Owners and Owners ++ Owners
{exception, riak_core_claim_util, adjacency_matrix_populate, 4, [no_exhaustiveness], partial}.
%% lists:foldl/3 with a fun on a tuple, fun ({NPair, D}, Acc)
{exception, riak_core_claim_util, adjacency_matrix_from_al, 1, [ignore], not_finished}.
%% the second clause needs both lists to start with the same node, the caller passes Owners and Owners ++ Owners
{exception, riak_core_claim_util, adjacency_list, 4, [no_exhaustiveness], partial}.
%% lists:sum/1 gives number(), the sum of the float() products of a non-empty list is a float()
{exception, riak_core_claim_util, rms, 1, [ignore], not_finished}.
%% dict:to_list(FixupDAM), the branch _ -> false of the case on the comprehension is dead
{exception, riak_core_claim_util, met_required, 3, [ignore], not_finished}.
%% next_pow2/2: R * 2 is integer(), the argument and the result are pos_integer()
{assertion, riak_core_claim_util, {455, 35, "431655"}, assert_type, "pos_integer()", arith_range}.
%% lists:foldl/3 with a fun on a tuple, the accumulator {RunningScore, _RunningO, _RunningDAM}; behind it the fold starts with
%% {undefined, undefined, undefined} and the result is typed without undefined
{exception, riak_core_claim_util, prepend_next_owner, 5, [ignore], not_finished}.
%% num_perms/2: the only clause has the guard K =< N; no caller in riak_core_lite. The div is integer(), the result a pos_integer()
{assertion, riak_core_claim_util, {531, 39, "dd2dcd"}, assert_type, "pos_integer()", number_range}.
{exception, riak_core_claim_util, num_perms, 2, [no_exhaustiveness], partial}.
%% the body divides by K * fac(N - K) where fac(K) * fac(N - K) is meant: num_combs(0, N) is a badarith. In front of it the only
%% clause has the guard K =< N, and N - K and the div are integer(); no caller in riak_core_lite
{exception, riak_core_claim_util, num_combs, 2, [ignore], source_bug}.
%% fac/1: N * fac(N - 1) is integer(), the result is pos_integer()
{assertion, riak_core_claim_util, {539, 24, "da2759"}, assert_type, "pos_integer()", arith_range}.
{assertion, riak_core_claim_util, {581, 6, "e47f98"}, assert_type, "node()", dict_types}. % substitute/3: dict:fetch(E, D)

{module, riak_core_claimant, #{file => "riak_core/src/riak_core_claimant.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% plan/0: gen_server:call/3 gives term(), the reply of plan is the result of generate_plan/2 or {error, ring_not_ready}
{assertion, riak_core_claimant, {86, 11, "f2b874"}, assert_type, "{error, term()} | {ok, [{node(), action() | join}], [ring_transition()]}", call_reply}.
%% commit/0: gen_server:call/3 gives term(), the reply of commit is ok, {error, Reason} or the bare atom error (commit_staged/1
%% line 278)
{assertion, riak_core_claimant, {95, 5, "2fabb6"}, assert_type, "ok | error | {error, term()}", call_reply}.
%% gen_server:call/3 gives term(), the reply of clear is ok: the call (143:12) is the body and crashes the engine with an
%% assertion
{exception, riak_core_claimant, clear, 0, [ignore], assertion_crash}.
%% stage/2: gen_server:call/3 gives term(), the reply of stage is ok or {error, atom()}
{assertion, riak_core_claimant, {170, 5, "7d2fa4"}, assert_type, "ok | {error, atom()}", call_reply}.
%% claimant/0: {ok, Ring} = riak_core_ring_manager:get_my_ring(), which can be {error, no_ring}
{assertion, riak_core_claimant, {174, 18, "6ecad7"}, assert_pattern, "{ok, _}", body_exhaustiveness}.
%% handle_call/3: Node and Action of the request {stage, Node, Action} are term(), maybe_stage/4 wants a node and an action
{assertion, riak_core_claimant, {191, 35, "bb537b"}, assert_type, "node()", message_term}.
{assertion, riak_core_claimant, {191, 41, "bb5b34"}, assert_type, "overlay_riak_core_lite:cl_action()", message_term}.
%% generate_plan/3: hd(NextRings), compute_all_next_rings/4 always gives at least one transition
{assertion, riak_core_claimant, {261, 30, "18be64"}, assert_type, "[ring_transition(), ...]", nonempty_result}.
%% maybe_commit_staged/3: PlannedRing is the field next_ring, riak_core_ring() or undefined; commit_staged/1 lets only a state
%% with a planned ring through. The field really is undefined when nothing is planned
{assertion, riak_core_claimant, {304, 28, "ef8546"}, assert_type, "riak_core_ring:riak_core_ring()", partial}.
%% the only clause wants no staged changes ([]), valid_request/4 passes all of them: resize_ring/1 while a change is staged is a
%% function_clause in the server. Behind it the case at 444 without {true, 0, false}
{exception, riak_core_claimant, valid_resize_request, 3, [ignore], source_bug}.
%% existing_replacements/1: {_, {Change, Node}} with the filter Change == replace or force_replace: Node stays node() or the
%% integer() of {resize, integer()}
{assertion, riak_core_claimant, {486, 6, "bb537b"}, assert_type, "node()", narrowing}.
%% catch error:{badmatch, false}; behind it the fun of lists:foldl/3 as in apply_changes/2
{exception, riak_core_claimant, compute_resize, 2, [ignore], catch_pattern}.
%% schedule_first_resize_transfer/4: hd(riak_core_ring:preflist(Key, Resized)), a ring has at least one partition; the same for
%% hd(chash:predecessors(..)) at 641
{assertion, riak_core_claimant, {633, 17, "62d391"}, assert_type, "[{chash:index_as_int(), node()}, ...]", nonempty_list}.
{assertion, riak_core_claimant, {641, 17, "1f7bef"}, assert_type, "[{chash:index_as_int(), node()}, ...]", nonempty_list}.
%% riak_core_rand:uniform(length(Active)): Active is the active members without the leaving owner, empty if all other members
%% are down, and uniform(0) is a function_clause
{exception, riak_core_claimant, handle_down_nodes, 2, [ignore], source_bug}.
%% replace_node_during_resize/4: {ok, FutureCHash} = riak_core_ring:resized_ring(CState1), undefined if the ring is not resized;
%% change/2 calls only if is_resizing/1
{assertion, riak_core_claimant, {1177, 5, "564e4d"}, assert_pattern, "{ok, _}", correlated}.
%% log/2: the kind (first argument) decides the data: ownership and reassign come with a ring, next with a node; a fun type for
%% Log has only the union, so CState is a ring or a node
{assertion, riak_core_claimant, {1200, 40, "270278"}, assert_type, "riak_core_ring:riak_core_ring()", overload_spec}.
{assertion, riak_core_claimant, {1204, 40, "270278"}, assert_type, "riak_core_ring:riak_core_ring()", overload_spec}.
{assertion, riak_core_claimant, {503, 12, "d8f881"}, assert_type, "non_neg_integer()", untyped_value}. % schedule_tick/0: application:get_env/3

{module, riak_core_eventhandler_guard, #{file => "riak_core/src/riak_core_eventhandler_guard.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% init/1: the clause takes a list of exactly four elements, [HandlerMod, Handler, Args, ExitFun], as start_link/4 passes it; a
%% list type has one type for all elements. ok = gen_event:add_sup_handler(..), which can give an error
{assertion, riak_core_eventhandler_guard, {41, 5, "214f0d"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, riak_core_eventhandler_guard, {41, 36, "86ed02"}, assert_type, "module()", arg_list}.
{assertion, riak_core_eventhandler_guard, {41, 48, "52bd42"}, assert_type, "overlay_riak_core_lite:core_handler()", arg_list}.
{assertion, riak_core_eventhandler_guard, {44, 26, "86ed02"}, assert_type, "module()", arg_list}.
{assertion, riak_core_eventhandler_guard, {44, 48, "52bd42"}, assert_type, "overlay_riak_core_lite:core_handler()", arg_list}.
{assertion, riak_core_eventhandler_guard, {45, 23, "2942d5"}, assert_type, "undefined | overlay_riak_core_lite:core_exit_fun()", arg_list}.
{exception, riak_core_eventhandler_guard, init, 1, [no_exhaustiveness], partial}.
%% handle_info/2: Handler of {gen_event_EXIT, Handler, Reason} is term() and goes to the ExitFun, which takes a handler (a
%% module or {Module, Id})
{assertion, riak_core_eventhandler_guard, {63, 13, "52bd42"}, assert_type, "overlay_riak_core_lite:core_handler()", message_term}.

{module, riak_core_eventhandler_sup, #{file => "riak_core/src/riak_core_eventhandler_sup.erl", timeout => 10000,
         overlays => [{specs, "overlay_riak_core_lite.erl"}, {library, "overlay_riak_core_lite_lib.erl"}]}}.
%% start_guarded_handler/4: supervisor:start_child/2 can give {ok, Pid, Info}, which Other -> Other returns where the result is
%% ok or {error, Reason}; riak_core_eventhandler_guard:start_link/4 never starts with an Info
{assertion, riak_core_eventhandler_sup, {39, 10, "ed3696"}, assert_type, "{ok, pid()} | {error, term()}", unchecked_result}.
%% stop_guarded_handler/3: ok = supervisor:terminate_child(?MODULE, Id), which can give {error, not_found}; the same for ok =
%% supervisor:delete_child(?MODULE, Id) behind it
{assertion, riak_core_eventhandler_sup, {57, 17, "dde966"}, assert_pattern, "ok", body_exhaustiveness}.
{assertion, riak_core_eventhandler_sup, {58, 17, "3e38ef"}, assert_pattern, "ok", body_exhaustiveness}.

