%% wants: annotated with its type and cast to the fun type of dict:merge/3
{assertion, riak_core_ring, {1429, 23, "1920ad"}, assert_type, "fun((term(), term(), term()) -> term())", dict_types}.
{assertion, riak_core_ring, {1429, 23, "1920ad"}, annotate_type, "fun((term(), overlay_riak_core_lite:ring_meta_entry(), overlay_riak_core_lite:ring_meta_entry()) -> overlay_riak_core_lite:ring_meta_entry())", dict_types}.
