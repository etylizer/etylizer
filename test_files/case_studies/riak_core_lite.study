{exception, riak_core_claim_util, prepend_next_owner, 5, [ignore], free_result}.
{exception, riak_core_claim_util, prepend, 4, [ignore], free_result}. % lists:foldl/3 with a fun on a tuple, fun ({T, D}, DAM1)
%% lists:foldl/3 with a fun on a tuple, fun ({T, D0}, DAM1)
{exception, riak_core_claim_util, fixup_dam, 5, [ignore], free_result}.
%% the only clause has the guard K =< N; no caller in riak_core_lite
{exception, riak_core_claim_util, num_perms, 2, [ignore], partial}.
%% the only clause has the guard K =< N; behind it the body divides by K * fac(N - K) where fac(K) * fac(N - K) is meant (source
%% bug), no caller in riak_core_lite
{exception, riak_core_claim_util, num_combs, 2, [ignore], partial}.
